<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Verzeilberg.nl{% endblock %}</title>

    {# Link previews (WhatsApp, Facebook, X ...): a page can set the blocks og_title, og_description,
       og_image (absolute URL) with og_image_width/og_image_height, and og_type; empty blocks are left out.
       The blocks are escaped when they render, hence |raw here (|trim would make Twig escape them a second time) #}
    {% set og_description = block('og_description') is defined ? block('og_description')|trim : '' %}
    {% set og_image = block('og_image') is defined ? block('og_image')|trim : '' %}
    {% set og_image_width = block('og_image_width') is defined ? block('og_image_width')|trim : '' %}
    {% set og_image_height = block('og_image_height') is defined ? block('og_image_height')|trim : '' %}
    <meta property="og:site_name" content="Verzeilberg.nl">
    <meta property="og:locale" content="nl_NL">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo }}">
    <meta property="og:title" content="{{ (block('og_title') is defined ? block('og_title') : block('title'))|trim|raw }}">
    {% if og_description %}
        <meta name="description" content="{{ og_description|raw }}">
        <meta property="og:description" content="{{ og_description|raw }}">
    {% endif %}
    {% if og_image %}
        <meta property="og:image" content="{{ og_image|raw }}">
        {% if og_image_width and og_image_height %}
            <meta property="og:image:width" content="{{ og_image_width|raw }}">
            <meta property="og:image:height" content="{{ og_image_height|raw }}">
        {% endif %}
        <meta name="twitter:card" content="summary_large_image">
    {% endif %}

    <link rel="alternate" type="application/rss+xml" title="Verzeilberg.nl blog" href="{{ url('blog_feed') }}">

    {% block stylesheets %}
        <!-- Bootstrap 5 CSS via CDN -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <!-- FontAwesome 6 via CDN -->
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer">
        <!-- Google Fonts: Faster One (wordmark), Barlow Condensed (headings), Barlow (text) -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:ital,wght@0,400;0,500;0,600;1,400&family=Faster+One&display=swap" rel="stylesheet">
        <link href="{{ asset('styles/site.css') }}" rel="stylesheet">
    {% endblock %}

    {% block javascripts_head %}{% endblock %}
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark site-nav">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">Verzeilberg</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu openen of sluiten">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    {% set mainMenu = get_menu('main') %}
                    {% if mainMenu %}
                        {{ render_menu(mainMenu) }}
                    {% else %}
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_about') }}">Over mij</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_events') }}">Events</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_games') }}">Games</a></li>
                        </ul>
                    {% endif %}

                    <ul class="navbar-nav ms-auto">
                        {% if is_granted('PERM_admin.access') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_dashboard') }}">
                                    <i class="fas fa-cog me-1"></i>Admin
                                </a>
                            </li>
                        {% endif %}

                        {# Not app.user: halfway a two-factor login the user is known but not logged in yet #}
                        {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user me-1"></i>{{ app.user.getFullName() ?? app.user.getUserIdentifier() }}
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="{{ path('app_profile') }}">Profiel</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_checklists') }}">Checklists</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_users') }}">Gebruikers</a></li>
                                    {% set friendRequests = friend_request_count() %}
                                    <li><a class="dropdown-item d-flex justify-content-between align-items-center gap-2" href="{{ path('app_friends') }}">Vrienden{% if friendRequests %}<span class="badge rounded-pill text-bg-danger" title="Openstaande vriendschapsverzoeken">{{ friendRequests }}</span>{% endif %}</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form action="{{ path('app_logout') }}" method="post">
                                            <button type="submit" class="dropdown-item">Uitloggen</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_login', {}, false) }}">Inloggen</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_register', {}, false) }}">Registreren</a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
        <div class="site-search-bar">
            <div class="container">
                <form class="d-flex site-search" action="{{ path('app_search') }}" method="GET" role="search">
                    <input class="form-control me-2" type="search" name="q" placeholder="Doorzoek de site" aria-label="Doorzoek de site" value="{{ app.request.query.get('q', '') }}">
                    <button class="btn" type="submit" title="Zoeken"><i class="fas fa-search"></i></button>
                </form>
            </div>
        </div>
    </header>

    {#
        Every page opens with the same navy band: fill page_title (and optionally page_lead and page_actions).
        A page with its own opening (the home hero) overrides page_header instead.
    #}
    {% block page_header %}
        {% if block('page_title') is defined %}
            <section class="page-head">
                <div class="container">
                    <div class="page-head-inner">
                        <div>
                            <h1 class="page-title">{{ block('page_title') }}</h1>
                            {% if block('page_lead') is defined and block('page_lead')|trim is not empty %}
                                <p class="page-lead">{{ block('page_lead') }}</p>
                            {% endif %}
                        </div>
                        {% if block('page_actions') is defined and block('page_actions')|trim is not empty %}
                            <div class="page-actions">{{ block('page_actions') }}</div>
                        {% endif %}
                    </div>
                </div>
            </section>
            <div class="flag-stripe" aria-hidden="true"></div>
        {% endif %}
    {% endblock %}

    <main class="container site-main">
        {% for label, messages in app.flashes(['success', 'error', 'warning', 'info']) %}
            {% for message in messages %}
                <div class="alert alert-{{ label === 'error' ? 'danger' : label }} alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <div class="flag-stripe" aria-hidden="true"></div>
    <footer class="site-footer">
        <div class="container site-footer-inner">
            <a class="footer-brand" href="{{ path('app_home') }}">Verzeilberg</a>
            <nav aria-label="Footer">
                <a href="{{ path('app_about') }}">Over mij</a>
                <a href="{{ path('app_contact') }}">Contact</a>
            </nav>
            <span>&copy; {{ 'now'|date('Y') }} Verzeilberg.nl</span>
        </div>
    </footer>

    {% block javascripts %}
        <!-- Bootstrap 5 JS via CDN -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <script src="{{ asset('js/core/dialog.js') }}"></script>
        <script src="{{ asset('js/core/common.js') }}"></script>
        <script src="{{ asset('js/core/site-nav.js') }}"></script>
    {% endblock %}
</body>
</html>