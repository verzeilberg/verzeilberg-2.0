{% extends 'base.html.twig' %}

{% block title %}Handbal stand - Verzeilberg.nl{% endblock %}

{% block page_title %}Handbal strafworpcompetitie{% endblock %}
{% block page_lead %}
    {%- if seizoen -%}
        {{ seizoen.naam }}: {{ seizoen.startDatum|date('d-m-Y') }} t/m {{ seizoen.eindDatum|date('d-m-Y') }}
    {%- endif -%}
{% endblock %}
{% block page_actions %}
    <a href="{{ path('handbal_public_logout') }}" class="btn btn-outline-primary"><i class="fas fa-sign-out-alt me-2"></i>Uitloggen</a>
{% endblock %}

{% block body %}
{% if standings.spelers|length > 0 %}
    <div class="row g-3 section">
        <div class="col-6 col-md-3">
            <div class="stat-tile">
                <div class="stat-tile-value">{{ standings.aantalMaandagen }}</div>
                <div class="stat-tile-label">Speeldagen</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-tile">
                <div class="stat-tile-value">{{ standings.aantalSpelers }}</div>
                <div class="stat-tile-label">Spelers</div>
            </div>
        </div>
    </div>

    <section class="section">
        <h2 class="section-title">Stand</h2>
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead>
                        <tr>
                            <th class="w-60px">Pos</th>
                            <th>Speler</th>
                            <th class="w-100px text-center">Doelp./redd.</th>
                            <th class="w-100px text-center">Gemiddelde</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in standings.spelers %}
                            <tr>
                                <td><strong>{{ loop.index }}</strong></td>
                                <td class="text-nowrap">
                                    {{ item.speler.naam }}
                                    {% if item.is_keeper %}
                                        <span class="tag ms-2">Keeper</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">{{ item.doelpunten }}</td>
                                <td class="text-center">{{ (item.gemiddelde * 100)|number_format(0, '.', ',') }}%</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted">Geen spelers</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    {% if rondes|length > 0 %}
        <section class="section">
            <h2 class="section-title">Per ronde</h2>
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th class="w-120px">Ronde</th>
                                {% set players = [] %}
                                {% set keepers = [] %}
                                {% for standing in standings.spelers %}
                                    {% if standing.is_keeper %}
                                        {% set keepers = keepers|merge([standing]) %}
                                    {% else %}
                                        {% set players = players|merge([standing]) %}
                                    {% endif %}
                                {% endfor %}
                                {% for standing in players %}
                                    <th class="text-center w-60px">{{ standing.speler.naam }}</th>
                                {% endfor %}
                                {% for standing in keepers %}
                                    <th class="text-center w-60px">
                                        {{ standing.speler.naam }}
                                        <span class="tag ms-1" title="Keeper">K</span>
                                    </th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for ronde in rondes %}
                                <tr>
                                    <td>{{ ronde.datum|date('d-m-Y') }}</td>

                                    {% for standing in players %}
                                        {% set score = scoresBySpelerAndRonde[standing.speler.id][ronde.id] ?? null %}
                                        <td class="text-center">
                                            {% if score and score.gescored %}
                                                <span class="score-mark score-mark-yes" role="img" aria-label="Gescoord">✓</span>
                                            {% else %}
                                                <span class="score-mark score-mark-no" role="img" aria-label="Gemist">✗</span>
                                            {% endif %}
                                        </td>
                                    {% endfor %}

                                    {% for standing in keepers %}
                                        <td class="text-center">{{ keeperScoresByRonde[standing.speler.id][ronde.id] ?? 0 }}</td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    {% endif %}
{% else %}
    <div class="empty-state">
        <i class="fas fa-trophy"></i>
        <p>Nog geen stand beschikbaar: er zijn nog geen rondes of spelers om een stand te berekenen.</p>
    </div>
{% endif %}
{% endblock %}
