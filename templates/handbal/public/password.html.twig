{% extends 'base.html.twig' %}

{% block title %}Handbal - Inloggen{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-handshake me-2"></i>Handbal Statistieken</h4>
            </div>
            <div class="card-body">
                <p class="lead text-center">Deze pagina is beveiligd met een wachtwoord.</p>
                
                <form method="POST">
                    <div class="mb-3">
                        <label for="password" class="form-label">Wachtwoord</label>
                        <input type="password" class="form-control form-control-lg" id="password" name="password" placeholder="Voer wachtwoord in" autofocus required>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-unlock me-2"></i>Toegang
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}