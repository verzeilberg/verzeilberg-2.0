{% extends 'base.html.twig' %}

{% block title %}Handbal - Inloggen{% endblock %}

{% block page_title %}Handbal statistieken{% endblock %}
{% block page_lead %}Deze pagina is beveiligd met een wachtwoord.{% endblock %}

{% block body %}
<div class="form-page">
    <div class="card">
        <div class="card-body article-body">
            <form method="POST">
                <div class="mb-3">
                    <label for="password" class="form-label">Wachtwoord</label>
                    <input type="password" class="form-control form-control-lg" id="password" name="password" placeholder="Voer wachtwoord in" autofocus required>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-unlock me-2"></i>Toegang krijgen</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
