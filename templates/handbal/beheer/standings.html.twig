{% extends 'admin/base.html.twig' %}

{% block title %}Stand - Handbal Beheer{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-trophy me-2"></i>Stand</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('handbal_beheer_scores') }}" class="btn btn-outline-primary">
            <i class="fas fa-calendar-alt me-1"></i>Rondes
        </a>
        <a href="{{ path('handbal_public') }}" class="btn btn-outline-success" target="_blank">
            <i class="fas fa-eye me-1"></i>Publieke weergave
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Seizoen</label>
                <select name="seizoen_id" class="form-select" data-auto-submit>
                    {% for s in seizoenen %}
                        <option value="{{ s.id }}" {% if currentSeizoen and currentSeizoen.id == s.id %}selected{% endif %}>
                            {{ s.naam }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </form>
    </div>
</div>

{% if currentSeizoen %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        Bezig met stand voor <strong>{{ currentSeizoen.naam }}</strong> ({{ currentSeizoen.startDatum|date('d-m-Y') }} t/m {{ currentSeizoen.eindDatum|date('d-m-Y') }})
    </div>
{% endif %}

{% if standings.spelers|length > 0 %}
    {# Same structure as the public page: one combined ranking, then the detail per round #}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-trophy me-2"></i>Gecombineerde stand</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover standings-table mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="w-60px text-start">Pos</th>
                            <th class="text-start">Speler</th>
                            <th class="w-100px">Doelp./Redd.</th>
                            <th class="w-100px">Gemiddelde</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in standings.spelers %}
                            <tr class="{{ item.is_keeper ? 'keeper-row' : '' }}">
                                <td class="text-start"><strong>{{ loop.index }}</strong></td>
                                <td class="text-start text-nowrap">
                                    {{ item.speler.naam }}
                                    {% if item.speler.rugnummer %}
                                        <span class="badge bg-secondary ms-1">#{{ item.speler.rugnummer }}</span>
                                    {% endif %}
                                    {% if item.is_keeper %}
                                        <span class="badge bg-warning text-dark ms-1" title="{{ item.doelpunten }} van {{ item.maxMogelijk }} mogelijke reddingen">Keeper</span>
                                    {% endif %}
                                </td>
                                <td>{{ item.doelpunten }}</td>
                                <td>{{ (item.gemiddelde * 100)|number_format(0, '.', ',') }}%</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% if rondes|length > 0 %}
        {% set players = standings.spelers|filter(item => not item.is_keeper) %}
        {% set keepers = standings.spelers|filter(item => item.is_keeper) %}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Detail per ronde</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover standings-table mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="w-120px">Ronde</th>
                                {% for item in players %}
                                    <th>{{ item.speler.naam }}</th>
                                {% endfor %}
                                {% for item in keepers %}
                                    <th>
                                        {{ item.speler.naam }}
                                        <span class="badge bg-warning text-dark ms-1" title="Keeper: aantal reddingen">K</span>
                                    </th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for ronde in rondes %}
                                <tr>
                                    <td class="text-nowrap">{{ ronde.datum|date('d-m-Y') }}</td>
                                    {% for item in players %}
                                        {% set score = scoresBySpelerAndRonde[item.speler.id][ronde.id] ?? null %}
                                        <td class="score-cell">
                                            {% if score is null %}
                                                {# Admin only: a round without an entered score, so it can be filled in #}
                                                <span class="score-empty" title="Geen score ingevoerd">-</span>
                                            {% elseif score.gescored %}
                                                <span class="score-mark score-mark-yes" role="img" aria-label="Gescoord">✓</span>
                                            {% else %}
                                                <span class="score-mark score-mark-no" role="img" aria-label="Gemist">✗</span>
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                    {% for item in keepers %}
                                        <td class="score-cell keeper-col">{{ keeperScoresByRonde[item.speler.id][ronde.id] ?? 0 }}</td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="alert alert-secondary">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Totaal aantal speeldagen:</strong> {{ standings.aantalMaandagen }} |
        <strong>Totaal aantal spelers:</strong> {{ standings.aantalSpelers }}
    </div>
{% else %}
    <div class="text-center py-5">
        <i class="fas fa-trophy fa-4x text-muted mb-3"></i>
        <h4 class="text-muted">Geen stand beschikbaar</h4>
        <p class="text-muted">Er zijn nog geen rondes of spelers om een stand te berekenen.</p>
        <div class="d-flex gap-2 justify-content-center">
            <a href="{{ path('handbal_beheer_speler_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Spelers toevoegen
            </a>
            <a href="{{ path('handbal_beheer_ronde_new') }}" class="btn btn-success">
                <i class="fas fa-plus me-1"></i>Ronde toevoegen
            </a>
        </div>
    </div>
{% endif %}
{% endblock %}