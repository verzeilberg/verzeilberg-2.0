{% extends 'admin/base.html.twig' %}

{% block title %}{{ action == 'new' ? 'Nieuwe speler' : 'Speler bewerken' }} - Handbal Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-{{ action == 'new' ? 'plus' : 'edit' }} me-2"></i>{{ action == 'new' ? 'Nieuwe speler' : 'Speler bewerken' }}</h1>
    <a href="{{ path('handbal_beheer_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Terug
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form) }}
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.naam) }}
                        {{ form_widget(form.naam, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.naam) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.rugnummer) }}
                        {{ form_widget(form.rugnummer, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.rugnummer) }}
                    </div>

                    <div class="mb-3 form-check">
                        {{ form_widget(form.actief, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.actief, null, {'label_attr': {'class': 'form-check-label'}}) }}
                        {{ form_errors(form.actief) }}
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Opslaan
                </button>
                <a href="{{ path('handbal_beheer_index') }}" class="btn btn-secondary">Annuleren</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}