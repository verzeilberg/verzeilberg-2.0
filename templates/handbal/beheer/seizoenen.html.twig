{% extends 'admin/base.html.twig' %}

{% block title %}Seizoenen - Handbal Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-trophy me-2"></i>Seizoenen</h1>
    <a href="{{ path('handbal_beheer_seizoen_new') }}" class="btn btn-info">
        <i class="fas fa-plus me-1"></i>Nieuw seizoen
    </a>
</div>

<div class="card">
    <div class="card-body">
        {% if seizoenen|length > 0 %}
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Naam</th>
                            <th>Start datum</th>
                            <th>Eind datum</th>
                            <th>Actief</th>
                            <th>Aangemaakt</th>
                            <th>Aangepast</th>
                            <th>Acties</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for seizoen in seizoenen %}
                        <tr>
                            <td>{{ seizoen.naam }}</td>
                            <td>{{ seizoen.startDatum|date('d-m-Y') }}</td>
                            <td>{{ seizoen.eindDatum|date('d-m-Y') }}</td>
                            <td>
                                {% if seizoen.actief %}
                                    <span class="badge bg-success">Ja</span>
                                {% else %}
                                    <span class="badge bg-secondary">Nee</span>
                                {% endif %}
                            </td>
                            <td>{{ seizoen.dateCreated|date('d-m-Y H:i') }}</td>
                            <td>{{ seizoen.dateChanged ? seizoen.dateChanged|date('d-m-Y H:i') : '-' }}</td>
                            <td>
                                <a href="{{ path('handbal_beheer_seizoen_edit', {'id': seizoen.id}) }}" class="btn btn-sm btn-outline-primary" title="Bewerken">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger delete-btn" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#deleteModal"
                                        data-delete-url="{{ path('handbal_beheer_seizoen_delete', {'id': seizoen.id}) }}"
                                        data-delete-message="Weet je zeker dat je seizoen &quot;{{ seizoen.naam }}&quot; wilt verwijderen?"
                                        data-csrf-token="{{ csrf_token('delete' ~ seizoen.id) }}"
                                        title="Verwijderen">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-4">
                <i class="fas fa-trophy fa-3x text-muted mb-3"></i>
                <p class="text-muted">Geen seizoenen gevonden.</p>
                <a href="{{ path('handbal_beheer_seizoen_new') }}" class="btn btn-info">
                    <i class="fas fa-plus me-1"></i>Eerste seizoen aanmaken
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/delete-modal.js') }}"></script>
{% endblock %}
