{% extends 'admin/base.html.twig' %}

{% block title %}Rondes - Handbal Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-calendar-alt me-2"></i>Rondes</h1>
    <a href="{{ path('handbal_beheer_ronde_new') }}" class="btn btn-success">
        <i class="fas fa-plus me-1"></i>Nieuwe ronde
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Seizoen</label>
                <select name="seizoen_id" class="form-select" data-auto-submit>
                    {% for s in seizoenen %}
                        <option value="{{ s.id }}" {% if currentSeizoen and currentSeizoen.id == s.id %}selected{% endif %}>
                            {{ s.naam }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </form>
    </div>
</div>

{% if currentSeizoen %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        Bezig met scores voor <strong>{{ currentSeizoen.naam }}</strong> ({{ currentSeizoen.startDatum|date('d-m-Y') }} t/m {{ currentSeizoen.eindDatum|date('d-m-Y') }})
    </div>
{% endif %}

{% if rondes|length > 0 %}
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-list-check me-2"></i>Rondes {% if currentSeizoen %}in {{ currentSeizoen.naam }}{% endif %}</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Datum</th>
                            <th>Omschrijving</th>
                            <th>Seizoen</th>
                            <th class="text-center w-120px">Acties</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ronde in rondes %}
                            <tr>
                                <td>{{ ronde.datum|date('d-m-Y') }}</td>
                                <td>{{ ronde.omschrijving ?? '-' }}</td>
                                <td>{{ ronde.seizoen.naam }}</td>
                                <td class="text-center">
                                    <a href="{{ path('handbal_beheer_scores_ronde', {'id': ronde.id}) }}" class="btn btn-sm btn-success" title="Scores">
                                        <i class="fas fa-list-check"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger delete-btn ms-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-delete-url="{{ path('handbal_beheer_ronde_delete', {'id': ronde.id}) }}"
                                            data-delete-message="Weet je zeker dat je ronde van {{ ronde.datum|date('d-m-Y') }} wilt verwijderen?"
                                            data-csrf-token="{{ csrf_token('delete' ~ ronde.id) }}"
                                            title="Verwijderen">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-calendar-alt fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">Geen rondes gevonden</h4>
            <p class="text-muted">Er zijn nog geen rondes aangemaakt.</p>
            <a href="{{ path('handbal_beheer_ronde_new') }}" class="btn btn-success">
                <i class="fas fa-plus me-1"></i>Eerste ronde aanmaken
            </a>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/delete-modal.js') }}"></script>
{% endblock %}
