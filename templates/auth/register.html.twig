{% extends 'base.html.twig' %}

{% block title %}Account aanmaken - Verzeilberg.nl{% endblock %}

{% block page_title %}Account aanmaken{% endblock %}
{% block page_lead %}Word lid van Verzeilberg.nl om te reageren op berichten, checklists in te vullen en zeil- en techupdates te volgen.{% endblock %}

{% block body %}
<div class="form-page-wide">
    <div class="card">
        <div class="card-body article-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    {{ form_label(form.firstName, 'Voornaam', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Voornaam', 'autocomplete': 'given-name'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.lastName, 'Achternaam', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Achternaam', 'autocomplete': 'family-name'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.email, 'E-mailadres', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'jij@voorbeeld.nl', 'autocomplete': 'email'}}) }}
                {{ form_errors(form.email) }}
            </div>

            {# Password with strength meter (js/components/password-strength.js reads #password-input) #}
            <div class="mb-3">
                <div class="d-flex align-items-center mb-1">
                    {{ form_label(form.plainPassword.first, 'Wachtwoord', {'id': 'password-input', 'label_attr': {'class': 'form-label mb-0'}}) }}
                    <button type="button" class="btn btn-link p-0 ms-2" data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="focus" tabindex="0" data-bs-title="Eisen aan het wachtwoord" data-bs-content="<ul class='mb-0 ps-3'><li>Minimaal 8 tekens</li><li>Eén hoofdletter</li><li>Eén kleine letter</li><li>Eén cijfer</li><li>Eén speciaal teken</li></ul>" aria-label="Eisen aan het wachtwoord">
                        <i class="fas fa-info-circle text-muted"></i>
                    </button>
                </div>
                {{ form_widget(form.plainPassword.first, {'id': 'password-input', 'attr': {'class': 'form-control', 'placeholder': 'Kies een wachtwoord', 'autocomplete': 'new-password'}}) }}
                {{ form_errors(form.plainPassword.first) }}
                <div class="password-strength mt-2">
                    <div class="password-strength-bar strength-0" id="password-strength-bar"></div>
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.plainPassword.second, 'Bevestig wachtwoord', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Bevestig je wachtwoord', 'autocomplete': 'new-password'}}) }}
                {{ form_errors(form.plainPassword.second) }}
            </div>

            <div class="mb-4">
                <div class="form-check">
                    {{ form_widget(form.termsAccepted, {'attr': {'class': 'form-check-input', 'id': 'terms-accepted'}}) }}
                    <label class="form-check-label" for="terms-accepted">
                        Ik ga akkoord met de
                        <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal">gebruiksvoorwaarden</a>
                        en het
                        <a href="#" data-bs-toggle="modal" data-bs-target="#privacyModal">privacybeleid</a>
                    </label>
                    {{ form_errors(form.termsAccepted, {'attr': {'class': 'text-danger small mt-1 d-block'}}) }}
                </div>
            </div>

            {# Spam trap: hidden for people (and screen readers), bots fill it in #}
            <div class="visually-offscreen" aria-hidden="true">
                {{ form_row(form.website) }}
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Account aanmaken</button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
    <p class="text-center mt-3">
        Heb je al een account? <a href="{{ path('app_login') }}">Inloggen</a>
    </p>
</div>

<!-- Terms of Service Modal -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="termsModalLabel">Gebruiksvoorwaarden</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <h6>1. Aanvaarding van de voorwaarden</h6>
                <p>Door Verzeilberg.nl te bezoeken en te gebruiken, ga je akkoord met deze voorwaarden.</p>
                
                <h6>2. Accounts</h6>
                <p>Als je een account aanmaakt, geef je juiste en volledige gegevens op. Je bent zelf verantwoordelijk voor het geheimhouden van je account en wachtwoord.</p>
                
                <h6>3. Inhoud</h6>
                <p>Wat je plaatst, blijft van jou. Door iets te plaatsen geef je ons toestemming om het op deze site te gebruiken, te tonen en te verspreiden.</p>
                
                <h6>4. Niet toegestaan</h6>
                <p>Je mag de site niet gebruiken voor onwettige doelen of om schadelijke, beledigende of illegale inhoud te plaatsen.</p>
                
                <h6>5. Intellectueel eigendom</h6>
                <p>Alle inhoud, functies en functionaliteit van Verzeilberg.nl zijn van ons en worden beschermd door het internationale auteursrecht.</p>
                
                <h6>6. Beëindiging</h6>
                <p>We kunnen je account direct en zonder voorafgaande melding opheffen of blokkeren als we vinden dat je deze voorwaarden overtreedt.</p>
                
                <h6>7. Beperking van aansprakelijkheid</h6>
                <p>We zijn niet aansprakelijk voor indirecte schade, incidentele schade of gevolgschade door je gebruik van de site.</p>
                
                <h6>8. Wijzigingen</h6>
                <p>We mogen deze voorwaarden altijd aanpassen. Als je de site daarna blijft gebruiken, ga je akkoord met de wijzigingen.</p>
                
                <h6>9. Toepasselijk recht</h6>
                <p>Op deze voorwaarden is Nederlands recht van toepassing.</p>
                
                <h6>10. Contact</h6>
                <p>Vragen over deze voorwaarden? Mail naar <a href="mailto:legal@verzeilberg.nl">legal@verzeilberg.nl</a>.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Sluiten</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#privacyModal">Lees het privacybeleid</button>
            </div>
        </div>
    </div>
</div>

<!-- Privacy Policy Modal -->
<div class="modal fade" id="privacyModal" tabindex="-1" aria-labelledby="privacyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="privacyModalLabel">Privacybeleid</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <h6>1. Welke gegevens we verzamelen</h6>
                <p>We bewaren de gegevens die je zelf opgeeft: naam, e-mailadres en alles wat je plaatst. Daarnaast verzamelen we automatisch gebruiksgegevens.</p>
                
                <h6>2. Waarvoor we je gegevens gebruiken</h6>
                <p>Om de site te laten werken en te verbeteren, updates te sturen, vragen te beantwoorden en de beveiliging te waarborgen.</p>
                
                <h6>3. Delen van gegevens</h6>
                <p>We verkopen je persoonsgegevens niet. We kunnen ze delen met dienstverleners die helpen de site te draaien.</p>
                
                <h6>4. Beveiliging</h6>
                <p>We nemen passende maatregelen om je persoonsgegevens te beschermen.</p>
                
                <h6>5. Jouw rechten</h6>
                <p>Je kunt je persoonsgegevens inzien, laten corrigeren of laten verwijderen. Neem daarvoor contact met ons op.</p>
                
                <h6>6. Cookies</h6>
                <p>We gebruiken cookies om de site prettiger te laten werken. Je kunt cookies uitzetten in de instellingen van je browser.</p>
                
                <h6>7. Links naar andere sites</h6>
                <p>De site kan links naar andere sites bevatten. We zijn niet verantwoordelijk voor hun privacybeleid.</p>
                
                <h6>8. Kinderen</h6>
                <p>De site is niet bedoeld voor kinderen onder de 16. We verzamelen niet bewust gegevens van kinderen.</p>
                
                <h6>9. Wijzigingen</h6>
                <p>We kunnen dit privacybeleid aanpassen. Als je de site blijft gebruiken, ga je akkoord met de wijzigingen.</p>
                
                <h6>10. Contact</h6>
                <p>Vragen over privacy? Mail naar <a href="mailto:privacy@verzeilberg.nl">privacy@verzeilberg.nl</a>.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Sluiten</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/popovers.js') }}"></script>
    <script src="{{ asset('js/components/password-strength.js') }}"></script>
{% endblock %}