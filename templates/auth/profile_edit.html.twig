{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Profiel bewerken - Verzeilberg.nl{% endblock %}

{% block page_title %}Profiel bewerken{% endblock %}
{% block page_lead %}Wat anderen zien op jouw pagina in het gebruikersoverzicht.{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_profile') }}" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Terug naar profiel</a>
{% endblock %}

{% block body %}
<div class="form-page-wide">
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

    <section class="card mb-4">
        <div class="card-header"><h2>Over jou</h2></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                <div class="col-md-6">{{ form_row(form.lastName) }}</div>
            </div>
            {{ form_row(form.catchLine) }}
            {{ form_row(form.bio) }}
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.location) }}</div>
                <div class="col-md-6">{{ form_row(form.website) }}</div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.phone) }}</div>
                <div class="col-md-6">{{ form_row(form.birthDate) }}</div>
            </div>
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header"><h2>Avatar</h2></div>
        <div class="card-body d-flex flex-wrap gap-4 align-items-start">
            {{ include('user/_avatar.html.twig', {avatarClass: 'profile-avatar'}) }}
            <div class="flex-grow-1">
                {{ form_row(form.avatarFile) }}
                {% if user.details and user.details.avatar %}
                    {{ form_row(form.removeAvatar) }}
                {% else %}
                    {% do form.removeAvatar.setRendered() %}
                {% endif %}
            </div>
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header"><h2>Sociale links</h2></div>
        <div class="card-body">
            <p class="text-muted">Worden als knoppen op je pagina getoond. Laat een veld leeg om het te verbergen.</p>
            <div class="row g-3">
                {% for platform, field in form.socialLinks %}
                    <div class="col-md-6">
                        {{ form_label(field, null, {label_html: true, label: '<i class="fab fa-' ~ platform ~ ' me-2"></i>' ~ field.vars.label}) }}
                        {{ form_widget(field) }}
                        {{ form_errors(field) }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header"><h2>Meldingen</h2></div>
        <div class="card-body">
            {{ form_row(form.emailNotifications) }}
        </div>
    </section>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Profiel opslaan</button>
        <a href="{{ path('app_profile') }}" class="btn btn-outline-primary">Annuleren</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
