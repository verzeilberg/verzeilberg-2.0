{% extends 'base.html.twig' %}

{% block title %}Wachtwoord wijzigen - Verzeilberg.nl{% endblock %}

{% block page_title %}Wachtwoord wijzigen{% endblock %}
{% block page_lead %}Hier blijf je ingelogd; op andere apparaten moet je opnieuw inloggen.{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_profile') }}" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Terug naar profiel</a>
{% endblock %}

{% block body %}
<div class="form-page">
    <div class="card">
        <div class="card-body article-body">
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="mb-4">
                    {{ form_label(form.currentPassword, null, {label_attr: {class: 'form-label'}}) }}
                    <div class="input-group">
                        {{ form_widget(form.currentPassword, {attr: {class: 'form-control'}}) }}
                        <button class="btn btn-outline-primary toggle-password" type="button" data-target="#{{ form.currentPassword.vars.id }}" aria-label="Toon wachtwoord">
                            <i class="fas fa-eye-slash"></i>
                        </button>
                    </div>
                    {{ form_errors(form.currentPassword) }}
                </div>

                {# Strength meter: js/components/password-strength.js reads #password-input #}
                <div class="mb-3">
                    {{ form_label(form.plainPassword, null, {label_attr: {class: 'form-label'}}) }}
                    <div class="input-group">
                        {{ form_widget(form.plainPassword, {id: 'password-input', attr: {class: 'form-control'}}) }}
                        <button class="btn btn-outline-primary toggle-password" type="button" data-target="#password-input" aria-label="Toon wachtwoord">
                            <i class="fas fa-eye-slash"></i>
                        </button>
                    </div>
                    <div class="password-strength mt-2">
                        <div class="password-strength-bar strength-0" id="password-strength-bar"></div>
                    </div>
                    <div class="form-text">Minimaal 8 tekens. Een mix van hoofd- en kleine letters, cijfers en symbolen maakt het sterker.</div>
                    {{ form_errors(form.plainPassword) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.confirmPassword, null, {label_attr: {class: 'form-label'}}) }}
                    <div class="input-group">
                        {{ form_widget(form.confirmPassword, {attr: {class: 'form-control'}}) }}
                        <button class="btn btn-outline-primary toggle-password" type="button" data-target="#{{ form.confirmPassword.vars.id }}" aria-label="Toon wachtwoord">
                            <i class="fas fa-eye-slash"></i>
                        </button>
                    </div>
                    {{ form_errors(form.confirmPassword) }}
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-key me-2"></i>Wachtwoord wijzigen</button>
                    <a href="{{ path('app_profile') }}" class="btn btn-outline-primary">Annuleren</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/password-toggle.js') }}"></script>
    <script src="{{ asset('js/components/password-strength.js') }}"></script>
{% endblock %}
