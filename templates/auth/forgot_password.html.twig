{% extends 'base.html.twig' %}

{% block title %}Wachtwoord vergeten - Verzeilberg.nl{% endblock %}

{% block page_title %}Wachtwoord vergeten{% endblock %}
{% block page_lead %}Vul je e-mailadres in, dan sturen we je een link om een nieuw wachtwoord in te stellen.{% endblock %}

{% block body %}
{# Success and error messages are shown by base.html.twig #}
<div class="form-page">
    <div class="card">
        <div class="card-body article-body">
            <form method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

                <div class="mb-4">
                    <label for="email" class="form-label">E-mailadres</label>
                    <input type="email" id="email" name="email" class="form-control" required autocomplete="email" placeholder="jij@voorbeeld.nl">
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Stuur resetlink</button>
                </div>
            </form>
        </div>
    </div>
    <p class="text-center mt-3">
        Toch weer te binnen geschoten? <a href="{{ path('app_login') }}">Terug naar inloggen</a>
    </p>
</div>
{% endblock %}
