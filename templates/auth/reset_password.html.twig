{% extends 'base.html.twig' %}

{% block title %}Wachtwoord opnieuw instellen - Verzeilberg.nl{% endblock %}

{% block page_title %}Wachtwoord opnieuw instellen{% endblock %}
{% block page_lead %}Kies een nieuw wachtwoord voor je account.{% endblock %}

{% block body %}
{# Success and error messages are shown by base.html.twig #}
<div class="form-page">
    <div class="card">
        <div class="card-body article-body">
            {{ form_start(form, {'attr': {'class': 'needs-validation'}, 'method': 'POST'}) }}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">

                <div class="mb-3">
                    {{ form_label(form.plainPassword, 'Nieuw wachtwoord', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Vul een nieuw wachtwoord in', 'autocomplete': 'new-password'}}) }}
                        <button class="btn btn-outline-primary toggle-password" type="button" data-target="#{{ form.plainPassword.vars.id }}" aria-label="Toon wachtwoord">
                            <i class="fas fa-eye-slash"></i>
                        </button>
                    </div>
                    {{ form_errors(form.plainPassword) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.confirmPassword, 'Bevestig wachtwoord', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        {{ form_widget(form.confirmPassword, {'attr': {'class': 'form-control', 'placeholder': 'Bevestig nieuw wachtwoord', 'autocomplete': 'new-password'}}) }}
                        <button class="btn btn-outline-primary toggle-password" type="button" data-target="#{{ form.confirmPassword.vars.id }}" aria-label="Toon wachtwoord">
                            <i class="fas fa-eye-slash"></i>
                        </button>
                    </div>
                    {{ form_errors(form.confirmPassword) }}
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Nieuw wachtwoord opslaan</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
    <p class="text-center mt-3">
        <a href="{{ path('app_login') }}">Terug naar inloggen</a>
    </p>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/password-toggle.js') }}"></script>
{% endblock %}
