{% extends 'base.html.twig' %}

{% block title %}{{ activity.name }} - Strava - Verzeilberg{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
{% endblock %}

{% block body %}
<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('strava_index') }}"><i class="fab fa-strava text-danger"></i> Strava</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ activity.name }}</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Activity Info -->
        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">{{ activity.name }}</h5>
                    <span class="badge bg-light text-dark">{{ activity.type }}</span>
                </div>
                <div class="card-body">
                    <div class="stat-item">
                        <div class="stat-label"><i class="fas fa-calendar me-1"></i>Datum</div>
                        <div class="stat-value">{{ activity.startDateLocal|date('d-m-Y H:i') }}</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label"><i class="fas fa-route me-1"></i>Afstand</div>
                        <div class="stat-value">{{ activity.distanceInKm }} km</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label"><i class="fas fa-stopwatch me-1"></i>Beweegtijd</div>
                        <div class="stat-value">{{ activity.movingTimeFormatted }}</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label"><i class="fas fa-tachometer-alt me-1"></i>Gem. snelheid</div>
                        <div class="stat-value">
                            {% if activity.averageSpeed %}
                                {{ (activity.averageSpeed * 3.6)|number_format(1) }} km/h
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label"><i class="fas fa-running me-1"></i>Tempo</div>
                        <div class="stat-value">{{ activity.pace }} min/km</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label"><i class="fas fa-mountain me-1"></i>Hoogtemeters</div>
                        <div class="stat-value">{{ activity.totalElevationGain|number_format(0, '', '', '.') }} m</div>
                    </div>
                    {% if activity.averageHeartrate %}
                    <div class="stat-item">
                        <div class="stat-label"><i class="fas fa-heartbeat me-1"></i>Gem. hartslag</div>
                        <div class="stat-value">{{ activity.averageHeartrate|number_format(0, '', '', '.') }} bpm</div>
                    </div>
                    {% endif %}
                    {% if activity.maxHeartrate %}
                    <div class="stat-item">
                        <div class="stat-label"><i class="fas fa-heart me-1"></i>Max hartslag</div>
                        <div class="stat-value">{{ activity.maxHeartrate|number_format(0, '', '', '.') }} bpm</div>
                    </div>
                    {% endif %}
                    {% if activity.maxSpeed %}
                    <div class="stat-item">
                        <div class="stat-label"><i class="fas fa-bolt me-1"></i>Max snelheid</div>
                        <div class="stat-value">{{ (activity.maxSpeed * 3.6)|number_format(1) }} km/h</div>
                    </div>
                    {% endif %}
                </div>
            </div>

            {% if activity.description %}
            <div class="card mt-3">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-align-left me-1"></i>Beschrijving</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0">{{ activity.description|nl2br }}</p>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Map & Rounds -->
        <div class="col-lg-8">
            <!-- Map -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-map-marked-alt me-2"></i>Route</h5>
                </div>
                <div class="card-body p-0">
                    <div id="map"></div>
                </div>
            </div>

            <!-- Splits/Rounds -->
            {% if rounds and rounds|length > 0 %}
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-flag-checkered me-2"></i>Splits (per km)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover round-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Split</th>
                                    <th>Afstand</th>
                                    <th>Tijd</th>
                                    <th>Gem. snelheid</th>
                                    <th>Tempo</th>
                                    <th>Hoogteverschil</th>
                                    {% if rounds[0].averageHeartrate is not null %}
                                    <th>Gem. hartslag</th>
                                    {% endif %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for round in rounds %}
                                <tr>
                                    <td><strong>{{ round.split }} km</strong></td>
                                    <td>{{ round.distanceInKm }} km</td>
                                    <td>
                                        {% set h = round.movingTime // 3600 %}
                                        {% set m = (round.movingTime % 3600) // 60 %}
                                        {% set s = round.movingTime % 60 %}
                                        {{ h|default(0) }}:{{ m|default(0)|number_format(0, '', '', '0') }}:{{ s|default(0)|number_format(0, '', '', '0') }}
                                    </td>
                                    <td>{{ round.averageSpeed ? (round.averageSpeed * 3.6)|number_format(1) ~ ' km/h' : '-' }}</td>
                                    <td>{{ round.pace }} min/km</td>
                                    <td>{{ round.elevationDifference is not null ? round.elevationDifference|number_format(0, '', '', '.') ~ ' m' : '-' }}</td>
                                    {% if round.averageHeartrate is not null %}
                                    <td>{{ round.averageHeartrate|number_format(0, '', '', '.') }} bpm</td>
                                    {% endif %}
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="{{ asset('js/modules/strava/detail.js') }}"
            data-start-lat="{{ activity.startLat }}"
            data-start-lng="{{ activity.startLng }}"
            data-points="{{ (points ?: [])|json_encode|e('html_attr') }}"></script>
{% endblock %}
