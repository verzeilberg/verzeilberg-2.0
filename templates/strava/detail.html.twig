{% extends 'base.html.twig' %}

{% block title %}{{ activity.name }} - Strava - Verzeilberg{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
{% endblock %}

{% block page_title %}{{ activity.name }}{% endblock %}
{% block page_lead %}{{ activity.type }} op {{ activity.startDateLocal|date('d-m-Y') }}, {{ activity.distanceInKm }} km.{% endblock %}
{% block page_actions %}
    <a href="{{ path('strava_index') }}" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Terug naar activiteiten</a>
{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-8">
        <article class="card h-100">
            <div id="map" class="card-img-top"></div>
            {% if activity.description %}
                <div class="card-body article-body">
                    <div class="prose"><p class="mb-0">{{ activity.description|nl2br }}</p></div>
                </div>
            {% endif %}
        </article>
    </div>

    <div class="col-lg-4">
        <aside class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2>Activiteit</h2>
                <span class="tag">{{ activity.type }}</span>
            </div>
            <div class="card-body">
                <dl class="article-facts mb-0">
                    <div><dt>Datum</dt><dd>{{ activity.startDateLocal|date('d-m-Y H:i') }}</dd></div>
                    <div><dt>Afstand</dt><dd>{{ activity.distanceInKm }} km</dd></div>
                    <div><dt>Beweegtijd</dt><dd>{{ activity.movingTimeFormatted }}</dd></div>
                    <div><dt>Gem. snelheid</dt><dd>{{ activity.averageSpeed ? (activity.averageSpeed * 3.6)|number_format(1) ~ ' km/h' : '-' }}</dd></div>
                    <div><dt>Tempo</dt><dd>{{ activity.pace }} min/km</dd></div>
                    <div><dt>Hoogtemeters</dt><dd>{{ activity.totalElevationGain|number_format(0, '', '', '.') }} m</dd></div>
                    {% if activity.averageHeartrate %}
                        <div><dt>Gem. hartslag</dt><dd>{{ activity.averageHeartrate|number_format(0, '', '', '.') }} bpm</dd></div>
                    {% endif %}
                    {% if activity.maxHeartrate %}
                        <div><dt>Max. hartslag</dt><dd>{{ activity.maxHeartrate|number_format(0, '', '', '.') }} bpm</dd></div>
                    {% endif %}
                    {% if activity.maxSpeed %}
                        <div><dt>Max. snelheid</dt><dd>{{ (activity.maxSpeed * 3.6)|number_format(1) }} km/h</dd></div>
                    {% endif %}
                </dl>
            </div>
        </aside>
    </div>
</div>

{% if rounds and rounds|length > 0 %}
    <section class="section mt-5">
        <h2 class="section-title">Splits (per km)</h2>
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover round-table mb-0">
                    <thead>
                        <tr>
                            <th>Split</th>
                            <th>Afstand</th>
                            <th>Tijd</th>
                            <th>Gem. snelheid</th>
                            <th>Tempo</th>
                            <th>Hoogteverschil</th>
                            {% if rounds[0].averageHeartrate is not null %}
                                <th>Gem. hartslag</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for round in rounds %}
                            <tr>
                                <td><strong>{{ round.split }} km</strong></td>
                                <td>{{ round.distanceInKm }} km</td>
                                <td>
                                    {% set h = round.movingTime // 3600 %}
                                    {% set m = (round.movingTime % 3600) // 60 %}
                                    {% set s = round.movingTime % 60 %}
                                    {{ h|default(0) }}:{{ m|default(0)|number_format(0, '', '', '0') }}:{{ s|default(0)|number_format(0, '', '', '0') }}
                                </td>
                                <td>{{ round.averageSpeed ? (round.averageSpeed * 3.6)|number_format(1) ~ ' km/h' : '-' }}</td>
                                <td>{{ round.pace }} min/km</td>
                                <td>{{ round.elevationDifference is not null ? round.elevationDifference|number_format(0, '', '', '.') ~ ' m' : '-' }}</td>
                                {% if round.averageHeartrate is not null %}
                                    <td>{{ round.averageHeartrate|number_format(0, '', '', '.') }} bpm</td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="{{ asset('js/modules/strava/detail.js') }}"
            data-start-lat="{{ activity.startLat }}"
            data-start-lng="{{ activity.startLng }}"
            data-points="{{ (points ?: [])|json_encode|e('html_attr') }}"></script>
{% endblock %}
