{% extends 'base.html.twig' %}

{% block title %}Strava Activiteiten - Verzeilberg{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fab fa-strava text-danger me-2"></i>Strava Activiteiten</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('strava_stats') }}" class="btn btn-outline-primary">
                <i class="fas fa-chart-bar me-1"></i>Statistieken
            </a>
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_strava_import') }}" class="btn btn-primary">
                <i class="fas fa-download me-1"></i>Importeren
            </a>
            <a href="{{ path('admin_strava_auth') }}" class="btn btn-outline-danger">
                <i class="fab fa-strava me-1"></i>Autoriseren
            </a>
            {% endif %}
        </div>
    </div>

    <!-- Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="year" class="form-label fw-bold">Jaar</label>
                    <select class="form-select" id="year" name="year">
                        {% for year in years %}
                            <option value="{{ year }}" {% if year == currentYear %}selected{% endif %}>{{ year }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="month" class="form-label fw-bold">Maand</label>
                    <select class="form-select" id="month" name="month">
                        {% for key, month in months %}
                            <option value="{{ key }}" {% if key == currentMonth %}selected{% endif %}>{{ month }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i>Filteren
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Chart -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Activiteiten overzicht</h5>
        </div>
        <div class="card-body">
            <div class="chart-container">
                <canvas id="activitiesChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Activities List -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list me-2"></i>Activiteiten</h5>
            <span class="badge bg-primary" id="activityCount">0</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="activitiesTable">
                    <thead class="table-light">
                        <tr>
                            <th>Datum</th>
                            <th>Activiteit</th>
                            <th>Type</th>
                            <th>Afstand</th>
                            <th>Tijd</th>
                            <th>Hoogte</th>
                            <th>Gem. snelheid</th>
                            <th>Gem. hartslag</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="activitiesBody">
                        <!-- Loaded via AJAX -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="{{ asset('js/modules/strava/activities.js') }}"
            data-chart-url="{{ path('strava_chart_data') }}"
            data-detail-url="{{ path('strava_activity_detail', {id: 0})|replace({'/0': '/__ID__'}) }}"></script>
{% endblock %}
