{% extends 'base.html.twig' %}

{% block title %}Strava-activiteiten - Verzeilberg{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.css" rel="stylesheet">
{% endblock %}

{% block page_title %}Strava-activiteiten{% endblock %}
{% block page_lead %}Hardlopen, fietsen en wandelen, per maand.{% endblock %}
{% block page_actions %}
    <a href="{{ path('strava_stats') }}" class="btn btn-outline-primary"><i class="fas fa-chart-bar me-2"></i>Statistieken bekijken</a>
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('admin_strava_import') }}" class="btn btn-outline-primary"><i class="fas fa-download me-2"></i>Activiteiten importeren</a>
        <a href="{{ path('admin_strava_auth') }}" class="btn btn-outline-primary"><i class="fab fa-strava me-2"></i>Strava autoriseren</a>
    {% endif %}
{% endblock %}

{% block body %}
<div class="filter-panel mb-4">
    <form id="filterForm" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="year" class="form-label">Jaar</label>
            <select class="form-select" id="year" name="year">
                {% for year in years %}
                    <option value="{{ year }}" {% if year == currentYear %}selected{% endif %}>{{ year }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4">
            <label for="month" class="form-label">Maand</label>
            <select class="form-select" id="month" name="month">
                {% for key, month in months %}
                    <option value="{{ key }}" {% if key == currentMonth %}selected{% endif %}>{{ month }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-2"></i>Filteren</button>
        </div>
    </form>
</div>

<div class="card mb-4">
    <div class="card-header"><h2>Activiteitenoverzicht</h2></div>
    <div class="card-body">
        <div class="chart-container">
            <canvas id="activitiesChart"></canvas>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2>Activiteiten</h2>
        <span class="tag" id="activityCount">0</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="activitiesTable">
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Activiteit</th>
                    <th>Type</th>
                    <th>Afstand</th>
                    <th>Tijd</th>
                    <th>Hoogte</th>
                    <th>Gem. snelheid</th>
                    <th>Gem. hartslag</th>
                    <th><span class="visually-hidden">Bekijken</span></th>
                </tr>
            </thead>
            <tbody id="activitiesBody">
                {# Filled by js/modules/strava/activities.js #}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="{{ asset('js/modules/strava/activities.js') }}"
            data-chart-url="{{ path('strava_chart_data') }}"
            data-detail-url="{{ path('strava_activity_detail', {id: 0})|replace({'/0': '/__ID__'}) }}"></script>
{% endblock %}
