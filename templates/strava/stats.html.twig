{% extends 'base.html.twig' %}

{% block title %}Strava Statistieken - Verzeilberg{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-chart-bar text-primary me-2"></i>Strava Statistieken</h1>
        <a href="{{ path('strava_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Terug naar activiteiten
        </a>
    </div>

    <!-- Total Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card bg-primary text-white">
                <div class="card-body text-center">
                    <i class="fas fa-list fa-2x mb-2"></i>
                    <h2 class="mb-0">{{ totalStats.count }}</h2>
                    <p class="mb-0">Totaal activiteiten</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-success text-white">
                <div class="card-body text-center">
                    <i class="fas fa-route fa-2x mb-2"></i>
                    <h2 class="mb-0">{{ totalStats.totalDistance|number_format(0, '', '', '.') }}</h2>
                    <p class="mb-0">Totaal km</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-warning text-white">
                <div class="card-body text-center">
                    <i class="fas fa-stopwatch fa-2x mb-2"></i>
                    <h2 class="mb-0">{{ totalStats.totalTime|format_time }}</h2>
                    <p class="mb-0">Totaal tijd</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-danger text-white">
                <div class="card-body text-center">
                    <i class="fas fa-mountain fa-2x mb-2"></i>
                    <h2 class="mb-0">{{ totalStats.totalElevation|number_format(0, '', '', '.') }}</h2>
                    <p class="mb-0">Totaal hoogtemeters</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Year Overview Chart -->
        <div class="col-lg-8 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Activiteiten per jaar</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="yearChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Type Distribution -->
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Verdeling per type</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="typeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Year Details -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Details per jaar</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Jaar</th>
                            <th>Activiteiten</th>
                            <th>Afstand (km)</th>
                            <th>Tijd</th>
                            <th>Hoogte (m)</th>
                            <th>Typen</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for year in years|reverse %}
                        {% set stats = statsByYear[year] %}
                        <tr class="year-stat-row">
                            <td><strong>{{ year }}</strong></td>
                            <td>{{ stats.count }}</td>
                            <td>{{ stats.totalDistance|number_format(2, ',', '.') }}</td>
                            <td>{{ stats.totalTime|format_time }}</td>
                            <td>{{ stats.totalElevation|number_format(0, '', '', '.') }}</td>
                            <td>
                                {% for type, typeStats in stats.byType %}
                                <span class="badge bg-secondary me-1">{{ type }}: {{ typeStats.count }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="{{ asset('js/modules/strava/stats.js') }}"
            data-years="{{ years|json_encode|e('html_attr') }}"
            data-stats-by-year="{{ statsByYear|json_encode|e('html_attr') }}"></script>
{% endblock %}
