{% extends 'base.html.twig' %}

{% block title %}Strava-statistieken - Verzeilberg{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.css" rel="stylesheet">
{% endblock %}

{% block page_title %}Strava-statistieken{% endblock %}
{% block page_lead %}Alle activiteiten opgeteld, per jaar en per type.{% endblock %}
{% block page_actions %}
    <a href="{{ path('strava_index') }}" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Terug naar activiteiten</a>
{% endblock %}

{% block body %}
<div class="row g-3 section">
    {% for label, value in {
        'Totaal activiteiten': totalStats.count,
        'Totaal km': totalStats.totalDistance|number_format(0, '', '', '.'),
        'Totaal tijd': totalStats.totalTime|format_time,
        'Totaal hoogtemeters': totalStats.totalElevation|number_format(0, '', '', '.'),
    } %}
        <div class="col-6 col-md-3">
            <div class="stat-tile">
                <div class="stat-tile-value">{{ value }}</div>
                <div class="stat-tile-label">{{ label }}</div>
            </div>
        </div>
    {% endfor %}
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><h2>Activiteiten per jaar</h2></div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="yearChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h2>Verdeling per type</h2></div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="typeChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h2>Details per jaar</h2></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Jaar</th>
                    <th>Activiteiten</th>
                    <th>Afstand (km)</th>
                    <th>Tijd</th>
                    <th>Hoogte (m)</th>
                    <th>Typen</th>
                </tr>
            </thead>
            <tbody>
                {% for year in years|reverse %}
                    {% set stats = statsByYear[year] %}
                    <tr class="year-stat-row">
                        <td><strong>{{ year }}</strong></td>
                        <td>{{ stats.count }}</td>
                        <td>{{ stats.totalDistance|number_format(2, ',', '.') }}</td>
                        <td>{{ stats.totalTime|format_time }}</td>
                        <td>{{ stats.totalElevation|number_format(0, '', '', '.') }}</td>
                        <td>
                            {% for type, typeStats in stats.byType %}
                                <span class="tag me-1">{{ type }}: {{ typeStats.count }}</span>
                            {% endfor %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="{{ asset('js/modules/strava/stats.js') }}"
            data-years="{{ years|json_encode|e('html_attr') }}"
            data-stats-by-year="{{ statsByYear|json_encode|e('html_attr') }}"></script>
{% endblock %}
