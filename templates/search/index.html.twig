{% extends 'base.html.twig' %}

{% block title %}Search Results for "{{ searchTerm }}" - Verzeilberg.nl{% endblock %}

{% block hero_section %}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <h1 class="mb-4">Search Results for "{{ searchTerm }}"</h1>

        {% if not results or results.totalItems == 0 %}
            <div class="alert alert-info">
                No results found matching "{{ searchTerm }}".
            </div>
        {% else %}
            <p class="text-muted mb-4">{{ results.totalItems }} result{{ results.totalItems != 1 ? 's' : '' }} found.</p>

            {% for item in results.items %}
                {% if item.type == 'blog' %}
                    <article class="card mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-primary me-1">Blog</span>
                                    {% for category in item.entity.categories %}
                                        <span class="badge bg-info text-dark me-1">{{ category.name }}</span>
                                    {% endfor %}
                                </div>
                                <small class="text-muted">
                                    {{ item.entity.dateCreated|date('M d, Y') }}
                                </small>
                            </div>

                            <h2 class="card-title h4">
                                <a href="{{ path('blog_detail', {slug: item.entity.slug}) }}" class="text-dark text-decoration-none">
                                    {{ item.entity.title }}
                                </a>
                            </h2>

                            <p class="card-text">{{ item.entity.introText|striptags|u.truncate(200) }}</p>

                            <a href="{{ path('blog_detail', {slug: item.entity.slug}) }}" class="btn btn-outline-primary btn-sm">
                                Read More
                            </a>
                        </div>
                    </article>
                {% elseif item.type == 'event' %}
                    <article class="card mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-success me-1">Event</span>
                                    {% if item.entity.category %}
                                        <span class="badge bg-info text-dark me-1">{{ item.entity.category.name }}</span>
                                    {% endif %}
                                </div>
                                <small class="text-muted">
                                    {{ item.entity.eventStartDate|date('M d, Y') }}
                                </small>
                            </div>

                            <h2 class="card-title h4">
                                <a href="{{ path('app_event_show', {id: item.entity.id}) }}" class="text-dark text-decoration-none">
                                    {{ item.entity.title }}
                                </a>
                            </h2>

                            {% if item.entity.text %}
                                <p class="card-text">{{ item.entity.text|striptags|u.truncate(200) }}</p>
                            {% endif %}

                            <a href="{{ path('app_event_show', {id: item.entity.id}) }}" class="btn btn-outline-success btn-sm">
                                View Event
                            </a>
                        </div>
                    </article>
                {% endif %}
            {% endfor %}

            {% if results.totalPages > 1 %}
                <nav aria-label="Search pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {% if results.hasPreviousPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_search_paginated', {page: results.previousPage, q: searchTerm}) }}">&laquo; Previous</a>
                            </li>
                        {% else %}
                            <li class="page-item disabled">
                                <span class="page-link">&laquo; Previous</span>
                            </li>
                        {% endif %}

                        {% for pageNum in 1..results.totalPages %}
                            {% if pageNum == results.currentPage %}
                                <li class="page-item active">
                                    <span class="page-link">{{ pageNum }}</span>
                                </li>
                            {% elseif pageNum >= results.currentPage - 2 and pageNum <= results.currentPage + 2 %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_search_paginated', {page: pageNum, q: searchTerm}) }}">{{ pageNum }}</a>
                                </li>
                            {% elseif pageNum == results.currentPage - 3 or pageNum == results.currentPage + 3 %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            {% endif %}
                        {% endfor %}

                        {% if results.hasNextPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_search_paginated', {page: results.nextPage, q: searchTerm}) }}">Next &raquo;</a>
                            </li>
                        {% else %}
                            <li class="page-item disabled">
                                <span class="page-link">Next &raquo;</span>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            {% endif %}
        {% endif %}
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Refine Search</h5>
            </div>
            <div class="card-body">
                <form action="{{ path('app_search') }}" method="GET">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" value="{{ searchTerm }}" placeholder="Search...">
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Quick Links</h5>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item px-0">
                    <a href="{{ path('blog_index') }}" class="text-decoration-none">
                        <i class="fas fa-blog me-2"></i>All Blog Posts
                    </a>
                </li>
                <li class="list-group-item px-0">
                    <a href="{{ path('app_events') }}" class="text-decoration-none">
                        <i class="fas fa-calendar-alt me-2"></i>All Events
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}