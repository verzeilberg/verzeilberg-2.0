{% extends 'base.html.twig' %}

{% block title %}Zoekresultaten voor "{{ searchTerm }}" - Verzeilberg.nl{% endblock %}

{% import 'games/_macros.html.twig' as steam %}

{% block page_title %}Zoekresultaten{% endblock %}
{% block page_lead %}
    {%- if results and results.totalItems > 0 -%}
        {{ results.totalItems }} {{ results.totalItems == 1 ? 'resultaat' : 'resultaten' }} voor “{{ searchTerm }}”.
    {%- else -%}
        Niets gevonden voor “{{ searchTerm }}”.
    {%- endif -%}
{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-3">
        <aside class="filter-panel">
            <div class="filter-group">
                <h2 class="filter-heading"><label for="searchAgain">Opnieuw zoeken</label></h2>
                <form action="{{ path('app_search') }}" method="GET" role="search">
                    <div class="input-group">
                        <input type="search" id="searchAgain" name="q" class="form-control" value="{{ searchTerm }}" placeholder="Doorzoek de site">
                        <button class="btn btn-primary" type="submit" title="Zoeken"><i class="fas fa-search"></i></button>
                    </div>
                </form>
            </div>

            <div class="filter-group">
                <h2 class="filter-heading">Bladeren</h2>
                <ul class="filter-list">
                    <li><a href="{{ path('blog_index') }}">Alle blogberichten</a></li>
                    <li><a href="{{ path('app_events') }}">Alle events</a></li>
                    <li><a href="{{ path('app_games') }}">Alle games</a></li>
                </ul>
            </div>
        </aside>
    </div>

    <div class="col-lg-9">
        {% if not results or results.totalItems == 0 %}
            <div class="empty-state">
                <i class="fas fa-search"></i>
                <p>Geen resultaten voor “{{ searchTerm }}”. Probeer een korter of ander woord, of blader door de blog, events of games.</p>
            </div>
        {% else %}
            <div class="d-flex flex-column gap-3">
                {% for item in results.items %}
                    {% if item.type == 'blog' %}
                        {% set url = path('blog_detail', {slug: item.entity.slug}) %}
                        <article class="card card-link-cover">
                            <div class="card-body">
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <span class="tag"><i class="fas fa-newspaper me-1"></i>Blog</span>
                                    {% for category in item.entity.categories %}<span class="tag">{{ category.name }}</span>{% endfor %}
                                </div>
                                <h2 class="card-title"><a href="{{ url }}">{{ item.entity.title }}</a></h2>
                                {% if item.entity.introText %}
                                    <p class="card-text text-muted">{{ item.entity.introText|striptags|u.truncate(200, '…') }}</p>
                                {% endif %}
                                <div class="card-meta">
                                    <span><i class="fas fa-calendar-day"></i>{{ item.entity.dateCreated|nl_date('j M Y') }}</span>
                                </div>
                            </div>
                        </article>
                    {% elseif item.type == 'event' %}
                        {% set url = path('app_event_show', {slug: item.entity.slug}) %}
                        <article class="card card-link-cover">
                            <div class="card-body">
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <span class="tag"><i class="fas fa-calendar-alt me-1"></i>Event</span>
                                    {% if item.entity.category %}<span class="tag">{{ item.entity.category.name }}</span>{% endif %}
                                </div>
                                <h2 class="card-title"><a href="{{ url }}">{{ item.entity.title }}</a></h2>
                                {% if item.entity.text %}
                                    <p class="card-text text-muted">{{ item.entity.text|striptags|u.truncate(200, '…') }}</p>
                                {% endif %}
                                <div class="card-meta">
                                    <span><i class="fas fa-calendar-day"></i>{{ item.entity.eventStartDate|nl_date('j M Y') }}</span>
                                </div>
                            </div>
                        </article>
                    {% elseif item.type == 'game' %}
                        {% set game = item.entity %}
                        {% set review = game.publishedReview %}
                        {% set url = path('app_game', {appId: game.appId}) %}
                        <article class="card card-link-cover">
                            <div class="card-body">
                                <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                                    <span class="tag"><i class="fab fa-steam me-1"></i>Game</span>
                                    {% for genre in game.genres|slice(0, 3) %}<span class="tag">{{ genre }}</span>{% endfor %}
                                    {% if review %}<span class="ms-auto">{{ steam.stars(review) }}</span>{% endif %}
                                </div>
                                <h2 class="card-title"><a href="{{ url }}">{{ game.name }}</a></h2>
                                {% if review %}
                                    <p class="card-text text-muted mb-0"><strong>Mijn review:</strong> {{ review.body|u.truncate(200, '…') }}</p>
                                {% elseif game.shortDescription %}
                                    <p class="card-text text-muted mb-0">{{ game.shortDescription|u.truncate(200, '…') }}</p>
                                {% endif %}
                            </div>
                        </article>
                    {% endif %}
                {% endfor %}
            </div>

            {% if results.totalPages > 1 %}
                <nav aria-label="Pagina's met zoekresultaten">
                    <ul class="pagination">
                        {% if results.hasPreviousPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_search_paginated', {page: results.previousPage, q: searchTerm}) }}">&laquo; Vorige</a>
                            </li>
                        {% else %}
                            <li class="page-item disabled">
                                <span class="page-link">&laquo; Vorige</span>
                            </li>
                        {% endif %}

                        {% for pageNum in 1..results.totalPages %}
                            {% if pageNum == results.currentPage %}
                                <li class="page-item active">
                                    <span class="page-link">{{ pageNum }}</span>
                                </li>
                            {% elseif pageNum >= results.currentPage - 2 and pageNum <= results.currentPage + 2 %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_search_paginated', {page: pageNum, q: searchTerm}) }}">{{ pageNum }}</a>
                                </li>
                            {% elseif pageNum == results.currentPage - 3 or pageNum == results.currentPage + 3 %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            {% endif %}
                        {% endfor %}

                        {% if results.hasNextPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_search_paginated', {page: results.nextPage, q: searchTerm}) }}">Volgende &raquo;</a>
                            </li>
                        {% else %}
                            <li class="page-item disabled">
                                <span class="page-link">Volgende &raquo;</span>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
