{# A post in a card grid (blog list, search, home): image, categories, title, intro, date and comments #}
<div class="col">
    <article class="card h-100 card-link-cover">
        <a href="{{ path('blog_detail', {slug: post.slug}) }}" tabindex="-1" aria-hidden="true">
            {% if post.images|length > 0 %}
                {% set image = post.images.first() %}
                <img src="{{ image.getPublicPath() }}" class="card-img-top" alt="" loading="lazy">
            {% else %}
                <div class="card-img-top card-img-placeholder"><i class="fas fa-newspaper"></i></div>
            {% endif %}
        </a>
        <div class="card-body d-flex flex-column">
            {% if post.categories|length %}
                <div class="d-flex flex-wrap gap-1 mb-2">
                    {% for category in post.categories %}<span class="tag">{{ category.name }}</span>{% endfor %}
                </div>
            {% endif %}
            <h3 class="card-title"><a href="{{ path('blog_detail', {slug: post.slug}) }}">{{ post.title }}</a></h3>
            {% if post.introText %}
                <p class="card-text text-muted">{{ post.introText|striptags|u.truncate(120, '…') }}</p>
            {% endif %}
            <div class="card-meta mt-auto">
                <span><i class="fas fa-calendar-day"></i>{{ (post.dateOnline ?? post.dateCreated)|nl_date('j M Y') }}</span>
                <span><i class="fas fa-comments"></i>{{ post.getPublishedCommentCount() }} {{ post.getPublishedCommentCount() == 1 ? 'reactie' : 'reacties' }}</span>
            </div>
        </div>
    </article>
</div>
