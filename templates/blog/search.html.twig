{% extends 'base.html.twig' %}

{% block title %}Zoekresultaten voor "{{ searchTerm }}" - Blog - Verzeilberg.nl{% endblock %}

{% block page_title %}Zoeken: “{{ searchTerm }}”{% endblock %}
{% block page_lead %}{{ pagination.getTotalItemCount() }} {{ pagination.getTotalItemCount() == 1 ? 'bericht' : 'berichten' }} gevonden{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-3">
        {{ include('blog/_sidebar.html.twig') }}
    </div>

    <div class="col-lg-9">
        {% if pagination.getTotalItemCount() == 0 %}
            <div class="empty-state">
                <i class="fas fa-search"></i>
                <p>Geen berichten gevonden voor “{{ searchTerm }}”. Probeer een kortere zoekterm of <a href="{{ path('blog_index') }}">bekijk alle berichten</a>.</p>
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                {% for post in pagination %}
                    {{ include('blog/_card.html.twig') }}
                {% endfor %}
            </div>

            <nav aria-label="Pagina's met zoekresultaten">
                {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
            </nav>
        {% endif %}
    </div>
</div>
{% endblock %}
