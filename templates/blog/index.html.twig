{% extends 'base.html.twig' %}

{% block title %}{% if currentCategory %}{{ currentCategory.name }} - {% endif %}Blog - Verzeilberg.nl{% endblock %}

{% block page_title %}{{ currentCategory ? currentCategory.name : 'Blog' }}{% endblock %}
{% block page_lead %}{{ currentCategory ? currentCategory.description|striptags : 'Wedstrijdverslagen, reizen en notities uit de werkplaats.' }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('blog_feed') }}" class="btn btn-outline-primary" title="Volg de blog in een feedreader"><i class="fas fa-rss me-2"></i>RSS</a>
{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-3">
        {{ include('blog/_sidebar.html.twig') }}
    </div>

    <div class="col-lg-9">
        {% if pagination.getTotalItemCount() == 0 %}
            <div class="empty-state">
                <i class="fas fa-newspaper"></i>
                <p>Hier staan nog geen berichten{% if currentCategory %}. <a href="{{ path('blog_index') }}">Toon alle berichten</a>{% endif %}.</p>
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                {% for post in pagination %}
                    {{ include('blog/_card.html.twig') }}
                {% endfor %}
            </div>

            <nav aria-label="Blogpagina's">
                {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
            </nav>
        {% endif %}
    </div>
</div>
{% endblock %}
