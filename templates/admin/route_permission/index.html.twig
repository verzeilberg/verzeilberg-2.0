{% extends 'admin/base.html.twig' %}

{% block title %}Route Permissions - Admin{% endblock %}

{% block body %}
{% include 'admin/partials/delete_modal.html.twig' %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-route me-2"></i>Route Permissions</h1>
    <a href="{{ path('admin_route_permission_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>New Rule
    </a>
</div>

<div class="alert alert-info">
    <i class="fas fa-info-circle me-2"></i>
    <strong>How it works:</strong> Define which routes require which permissions. Rules are checked in priority order (highest first).
    Use <code class="bg-light px-1">{id}</code> for route parameters. Leave methods empty to match all HTTP methods.
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Search</label>
                <input type="text" name="search" class="form-control" placeholder="Search route, permission, description..." value="{{ search }}">
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <a href="{{ path('admin_route_permission_index') }}" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-times me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

{% if pagination.getTotalItemCount() == 0 %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No route permissions configured. <a href="{{ path('admin_route_permission_new') }}">Create one</a>.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Route Pattern</th>
                    <th>Permission</th>
                    <th>Methods</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for rp in pagination %}
                <tr>
                    <td>
                        <code class="text-break">{{ rp.routePattern }}</code>
                    </td>
                    <td>
                        <span class="badge bg-primary">{{ rp.permissionName }}</span>
                        <small class="text-muted ms-1">(PERM_{{ rp.permissionName }})</small>
                    </td>
                    <td>
                        {% if rp.methods %}
                            {% for method in rp.methods %}
                                <span class="badge bg-secondary me-1">{{ method }}</span>
                            {% endfor %}
                        {% else %}
                            <span class="text-muted">All</span>
                        {% endif %}
                    </td>
                    <td>{{ rp.priority }}</td>
                    <td>
                        {% if rp.enabled %}
                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Enabled</span>
                        {% else %}
                            <span class="badge bg-secondary"><i class="fas fa-ban me-1"></i>Disabled</span>
                        {% endif %}
                    </td>
                    <td>{{ rp.description|slice(0, 60) }}{% if rp.description and rp.description|length > 60 %}...{% endif %}</td>
                    <td class="text-end">
                        <a href="{{ path('admin_route_permission_edit', {id: rp.id}) }}" class="btn btn-sm btn-outline-primary" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-secondary toggle-rp" 
                                data-toggle-url="{{ path('admin_route_permission_toggle', {id: rp.id}) }}"
                                data-csrf-token="{{ csrf_token('toggle_rp' ~ rp.id) }}"
                                title="{{ rp.enabled ? 'Disable' : 'Enable' }}">
                            <i class="fas fa-{{ rp.enabled ? 'toggle-on' : 'toggle-off' }}"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger js-ajax-delete"
                                data-delete-url="{{ path('admin_route_permission_delete', {id: rp.id}) }}"
                                data-delete-message="Delete route permission for &quot;{{ rp.routePattern }}&quot;?"
                                data-error-message="Failed to delete"
                                data-csrf-token="{{ csrf_token('delete' ~ rp.id) }}"
                                title="Delete">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav aria-label="Route permissions pagination">
        {{ knp_pagination_render(pagination) }}
    </nav>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/ajax-delete.js') }}"></script>
    <script src="{{ asset('js/modules/route-permission/index.js') }}"></script>
{% endblock %}