{% extends 'admin/base.html.twig' %}

{% block title %}New Route Permission - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-plus me-2"></i>New Route Permission</h1>
    <a href="{{ path('admin_route_permission_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form) }}
        
        <div class="mb-3">
            {{ form_label(form.routePattern) }}
            {{ form_widget(form.routePattern, {'attr': {'class': 'form-select font-monospace'}}) }}
            {{ form_errors(form.routePattern) }}
            <div class="form-text">Select an admin route or type a custom pattern. {id} matches any value.</div>
        </div>

        <div class="mb-3">
            {{ form_label(form.permissionName) }}
            {{ form_widget(form.permissionName, {'attr': {'class': 'form-control font-monospace text-uppercase'}}) }}
            {{ form_errors(form.permissionName) }}
            <div class="form-text">Permission name (without PERM_ prefix).</div>
        </div>

        <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
            {{ form_errors(form.description) }}
        </div>

        <hr>

        <div class="mb-3">
            {{ form_label(form.methods) }}
            <div class="d-flex flex-column gap-2">
                {% for child in form.methods %}
                    <div class="form-check">
                        {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(child, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                {% endfor %}
            </div>
            {{ form_errors(form.methods) }}
            <div class="form-text">Select methods. Leave empty for all methods.</div>
        </div>

        <div class="mb-3">
            {{ form_label(form.priority) }}
            {{ form_widget(form.priority, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.priority) }}
            <div class="form-text">Higher priority rules checked first.</div>
        </div>

        <div class="mb-3">
            {{ form_label(form.enabled) }}
            {{ form_widget(form.enabled, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.enabled) }}
        </div>

        <hr>

        <h6>Examples</h6>
        <table class="table table-sm table-bordered">
            <thead><tr><th>Route Pattern</th><th>Matches</th></tr></thead>
            <tbody>
                <tr><td><code>/admin/blog/{id}/edit</code></td><td><code>/admin/blog/5/edit</code>, <code>/admin/blog/abc/edit</code></td></tr>
                <tr><td><code>/admin/blog/*</code></td><td>Any route starting with <code>/admin/blog/</code></td></tr>
                <tr><td><code>/admin/user/{id}/delete</code></td><td><code>/admin/user/12/delete</code></td></tr>
            </tbody>
        </table>
        
        <table class="table table-sm table-bordered">
            <thead><tr><th>Permission</th><th>Use in Code/Twig</th></tr></thead>
            <tbody>
                <tr><td>BLOG_CREATE</td><td>PERM_BLOG_CREATE</td></tr>
                <tr><td>BLOG_EDIT</td><td>PERM_BLOG_EDIT</td></tr>
                <tr><td>EVENT_DELETE</td><td>PERM_EVENT_DELETE</td></tr>
                <tr><td>USER_MANAGE</td><td>PERM_USER_MANAGE</td></tr>
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i>Create Rule
        </button>
        <a href="{{ path('admin_route_permission_index') }}" class="btn btn-secondary">Cancel</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}