{% extends 'admin/base.html.twig' %}
{% import 'games/_macros.html.twig' as steam %}

{% block title %}Steam - Admin{% endblock %}

{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1><i class="fab fa-steam me-2"></i>Steam</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('app_games') }}" class="btn btn-outline-secondary" target="_blank"><i class="fas fa-external-link-alt me-1"></i>Public page</a>
        {% if configured %}
            <form method="post" action="{{ path('admin_steam_sync') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('steam_sync') }}">
                <button type="submit" class="btn btn-primary"><i class="fas fa-sync-alt me-1"></i>Sync now</button>
            </form>
        {% endif %}
    </div>
</div>

{% if not configured %}
    <div class="alert alert-warning">
        <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i>Steam is not configured</h5>
        <p class="mb-2">Add these to <code>.env.local</code> (or the server environment):</p>
        <ul class="mb-2">
            <li><code>STEAM_API_KEY</code>: a Web API key from <a href="https://steamcommunity.com/dev/apikey" target="_blank" rel="noopener">steamcommunity.com/dev/apikey</a></li>
            <li><code>STEAM_ID</code>: your 17-digit Steam ID, the name from your profile URL, or the profile URL itself</li>
        </ul>
        <p class="mb-0">In the Steam privacy settings, "Game details" must be <strong>Public</strong>. Then run <code>php bin/console app:steam:sync</code>, and add it as a cronjob (e.g. every hour).</p>
    </div>
{% endif %}

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                {% if account %}
                    <div class="d-flex align-items-center gap-3 mb-3">
                        {% if account.avatarUrl %}<img src="{{ account.avatarUrl }}" alt="" class="rounded" width="56" height="56">{% endif %}
                        <div>
                            <a href="{{ account.profileUrl }}" target="_blank" rel="noopener" class="fw-bold">{{ account.personaName ?? account.steamId }}</a>
                            <div class="small text-muted">{{ account.steamId }}</div>
                            {% if account.currentlyPlaying %}<div class="small text-success">Playing {{ account.currentlyPlaying }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="small">
                        Last synced: <strong>{{ account.lastSyncedAt ? account.lastSyncedAt|date('d-m-Y H:i') : 'never' }}</strong>
                    </div>
                    {% if account.lastSyncError %}
                        <div class="alert alert-danger small mt-2 mb-0"><i class="fas fa-exclamation-circle me-1"></i>{{ account.lastSyncError }}</div>
                    {% endif %}
                {% else %}
                    <p class="text-muted mb-0">Not synced yet.</p>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="row g-3 h-100">
            {% for label, value in {
                'Games': stats.games,
                'Played': stats.played,
                'Hours': (stats.minutes / 60)|round|number_format(0, '.', ','),
                'Achievements': stats.achievements|number_format(0, '.', ','),
                '100% games': stats.perfect,
            } %}
                <div class="col">
                    <div class="card h-100 text-center"><div class="card-body py-3">
                        <div class="fs-4 fw-bold">{{ value }}</div>
                        <div class="small text-muted">{{ label }}</div>
                    </div></div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<form method="get" action="{{ path('admin_steam_index') }}" class="row g-2 align-items-end mb-3" role="search">
    <div class="col-md-5">
        <input type="search" name="q" value="{{ filters.q }}" class="form-control" placeholder="Search games" aria-label="Search games">
    </div>
    <div class="col-md-3">
        <select name="genre" class="form-select" aria-label="Genre" data-auto-submit>
            <option value="">All genres</option>
            {% for genre in genres %}<option value="{{ genre }}" {{ genre == filters.genre ? 'selected' }}>{{ genre }}</option>{% endfor %}
        </select>
    </div>
    <div class="col-md-3">
        <select name="order" class="form-select" aria-label="Sort by" data-auto-submit>
            {% for sort in sorts %}<option value="{{ sort }}" {{ sort == filters.sort ? 'selected' }}>{{ {recent: 'Last played', playtime: 'Playtime', name: 'Name', achievements: 'Achievements'}[sort] }}</option>{% endfor %}
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100" title="Search"><i class="fas fa-search"></i></button>
    </div>
</form>

{% if games.getTotalItemCount == 0 %}
    <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No games{{ filters.q or filters.genre ? ' found' : ' yet' }}.</div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Game</th>
                        <th class="w-100px">Playtime</th>
                        <th class="w-130px">Last played</th>
                        <th class="min-w-150px">Achievements</th>
                        <th class="w-120px">Store details</th>
                        <th class="text-center w-80px">Public</th>
                    </tr>
                </thead>
                <tbody>
                    {% for game in games %}
                        <tr class="{{ game.hidden ? 'text-muted' }}">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    {% if game.iconUrl %}<img src="{{ game.iconUrl }}" alt="" class="steam-icon" loading="lazy">{% endif %}
                                    <div>
                                        <a href="{{ game.storeUrl }}" target="_blank" rel="noopener">{{ game.name }}</a>
                                        {% if game.genres %}<div class="small text-muted">{{ game.genres|join(', ') }}</div>{% endif %}
                                    </div>
                                </div>
                            </td>
                            <td>{{ steam.playtime(game.playtimeForever) }}</td>
                            <td>{{ steam.last_played(game.lastPlayedAt) }}</td>
                            <td>
                                {% if game.hasAchievements %}{{ steam.achievements(game) }}
                                {% elseif game.achievementsTotal is same as(0) %}<span class="small text-muted">None</span>
                                {% else %}<span class="small text-muted">{{ game.playtimeForever > 0 ? 'Not read yet' : '–' }}</span>{% endif %}
                            </td>
                            <td class="small">{{ game.detailsFetchedAt ? game.detailsFetchedAt|date('d-m-Y') : 'Not read yet' }}</td>
                            <td class="text-center">
                                <form method="post" action="{{ path('admin_steam_game_visibility', {id: game.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('steam_visibility' ~ game.id) }}">
                                    <input type="hidden" name="back" value="{{ app.request.requestUri }}">
                                    <button type="submit" class="btn btn-sm {{ game.hidden ? 'btn-outline-secondary' : 'btn-outline-success' }}" title="{{ game.hidden ? 'Hidden on the public pages: show it' : 'Shown on the public pages: hide it' }}">
                                        <i class="fas {{ game.hidden ? 'fa-eye-slash' : 'fa-eye' }}"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(games, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
    </div>
{% endif %}
{% endblock %}
