{% extends 'admin/base.html.twig' %}

{% block title %}Gebruikers - Beheer{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-users me-2"></i>Gebruikers</h1>
    <a href="{{ path('admin_user_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Nieuwe gebruiker
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select" data-auto-submit>
                    <option value="all" {% if currentStatus == 'all' %}selected{% endif %}>Alle ({{ activeCount + inactiveCount + pendingCount }})</option>
                    <option value="pending" {% if currentStatus == 'pending' %}selected{% endif %}>Wacht op goedkeuring ({{ pendingCount }})</option>
                    <option value="active" {% if currentStatus == 'active' %}selected{% endif %}>Actief ({{ activeCount }})</option>
                    <option value="inactive" {% if currentStatus == 'inactive' %}selected{% endif %}>Inactief ({{ inactiveCount }})</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Rol</label>
                <select name="role" class="form-select" data-auto-submit>
                    <option value="">Alle rollen</option>
                    {% for role in roles %}
                        <option value="{{ role.id }}" {% if currentRole == role.id %}selected{% endif %}>
                            {{ role.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Zoeken</label>
                <input type="text" name="search" class="form-control" placeholder="Zoek op e-mail, naam..." value="{{ search }}">
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-times me-1"></i>Wissen
                </a>
            </div>
        </form>
    </div>
</div>

{% if pagination.getTotalItemCount() == 0 %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>Geen gebruikers gevonden.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Gebruiker</th>
                    <th>E-mail</th>
                    <th>Rollen</th>
                    <th>Status</th>
                    <th>Inloggen</th>
                    <th>Aangemaakt</th>
                    <th class="text-end">Acties</th>
                </tr>
            </thead>
            <tbody>
                {% for user in pagination %}
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="user-avatar me-2">
                                {{ user.initials }}
                            </div>
                            <strong>{{ user.fullName }}</strong>
                        </div>
                    </td>
                    <td>{{ user.email }}</td>
                    <td>
                        {% for role in user.doctrineRoles %}
                            <span class="badge bg-info me-1">{{ role.name }}</span>
                        {% else %}
                            <span class="text-muted">Geen rollen</span>
                        {% endfor %}
                    </td>
                    <td>
                        {% if user.isActive() %}
                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Actief</span>
                        {% elseif user.isPending() and not user.isEmailVerified() %}
                            <span class="badge bg-light text-dark border" title="De gebruiker heeft nog niet op de link in de bevestigingsmail geklikt"><i class="fas fa-envelope me-1"></i>E-mail niet bevestigd</span>
                        {% elseif user.isPending() %}
                            <span class="badge bg-warning text-dark"><i class="fas fa-hourglass-half me-1"></i>Wacht op goedkeuring</span>
                        {% else %}
                            <span class="badge bg-secondary"><i class="fas fa-ban me-1"></i>Inactief</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if user.isTotpAuthenticationEnabled() %}
                            <span class="badge bg-light text-dark border" title="Inlogcode uit een authenticator-app"><i class="fas fa-mobile-alt me-1"></i>App</span>
                        {% else %}
                            <span class="badge bg-light text-dark border" title="Inlogcode per e-mail"><i class="fas fa-envelope me-1"></i>E-mail</span>
                        {% endif %}
                    </td>
                    <td>{{ user.dateCreated|nl_date('d M Y H:i') }}</td>
                    <td class="text-end">
                        {% if user.isPending() %}
                        <form method="post" action="{{ path('admin_user_approve', {id: user.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ user.id) }}">
                            <button type="submit" class="btn btn-sm btn-success" title="Goedkeuren">
                                <i class="fas fa-check"></i>
                            </button>
                        </form>
                        <form method="post" action="{{ path('admin_user_reject', {id: user.id}) }}" class="d-inline"
                              data-confirm="De registratie van {{ user.fullName }} afwijzen? {{ user.email }} krijgt een e-mail en het account wordt verwijderd.">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ user.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Afwijzen">
                                <i class="fas fa-user-times"></i>
                            </button>
                        </form>
                        {% endif %}
                        <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-primary" title="Bewerken">
                            <i class="fas fa-edit"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger js-ajax-delete"
                                data-delete-url="{{ path('admin_user_delete', {id: user.id}) }}"
                                data-delete-message="Weet je zeker dat je de gebruiker &quot;{{ user.email }}&quot; wilt verwijderen? Dit kan niet ongedaan worden gemaakt."
                                data-error-message="Gebruiker verwijderen mislukt"
                                data-csrf-token="{{ csrf_token('delete' ~ user.id) }}"
                                title="Verwijderen">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav aria-label="Paginering gebruikers">
        {{ knp_pagination_render(pagination, '_partials/pagination.html.twig', {}, {label: 'gebruikers'}) }}
    </nav>
{% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/ajax-delete.js') }}"></script>
{% endblock %}