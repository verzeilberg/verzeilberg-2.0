{% extends 'admin/base.html.twig' %}

{% block title %}Gebruiker bewerken - Beheer{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-user-edit me-2"></i>Bewerken: {{ user.fullName }}</h1>
        <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Terug
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            
            <div class="mb-3">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.fullName) }}
                {{ form_widget(form.fullName, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.fullName) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.plainPassword.first) }}
                {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.plainPassword.first) }}
                <div class="form-text">Laat leeg om het huidige wachtwoord te houden.</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.plainPassword.second) }}
                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.plainPassword.second) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.status) }}
                {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.status) }}
            </div>

            <hr class="my-4">

            <div class="mb-3">
                {{ form_label(form.doctrineRoles) }}
                {% for child in form.doctrineRoles %}
                    <div class="form-check">
                        {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(child, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                {% endfor %}
                {{ form_errors(form.doctrineRoles) }}
                <div class="form-text">{{ form.doctrineRoles.vars.help }} <a href="{{ path('admin_role_index') }}">Rollen beheren</a></div>
            </div>

            <div class="form-actions-bar">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Wijzigingen opslaan
                </button>
                <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">Annuleren</a>
            </div>
            
            {{ form_end(form) }}
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header"><h2 class="h5 mb-0"><i class="fas fa-shield-alt me-2"></i>Inloggen in twee stappen</h2></div>
        <div class="card-body">
            {% if user.isTotpAuthenticationEnabled() %}
                <p>{{ user.fullName }} logt in met een code uit een <strong>authenticator-app</strong> ({{ user.backupCodeCount }} back-upcode(s) over).</p>
                <p class="text-muted small">Telefoon kwijt? Zet het account terug op codes per e-mail. Dit vergeet ook de vertrouwde apparaten.</p>
            {% else %}
                <p>{{ user.fullName }} logt in met een <strong>code per e-mail</strong>.</p>
                <p class="text-muted small">Vergeet de apparaten die {{ user.fullName }} vertrouwde, zodat ook daar weer een code nodig is.</p>
            {% endif %}
            <form method="post" action="{{ path('admin_user_reset_two_factor', {id: user.id}) }}"
                  data-confirm="Het inloggen in twee stappen van {{ user.fullName }} terugzetten naar codes per e-mail?">
                <input type="hidden" name="_token" value="{{ csrf_token('reset_two_factor' ~ user.id) }}">
                <button type="submit" class="btn btn-outline-warning">
                    <i class="fas fa-undo me-1"></i>{{ user.isTotpAuthenticationEnabled() ? 'Terugzetten naar codes per e-mail' : 'Vertrouwde apparaten vergeten' }}
                </button>
            </form>
        </div>
    </div>
{% endblock %}