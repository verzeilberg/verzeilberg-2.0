{% extends 'admin/base.html.twig' %}

{% block title %}Edit User - Admin{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-user-edit me-2"></i>Edit: {{ user.fullName }}</h1>
        <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            
            <div class="mb-3">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.fullName) }}
                {{ form_widget(form.fullName, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.fullName) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.plainPassword.first) }}
                {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.plainPassword.first) }}
                <div class="form-text">Leave empty to keep current password.</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.plainPassword.second) }}
                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.plainPassword.second) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.status) }}
                {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.status) }}
            </div>

            <hr class="my-4">

            <div class="mb-3">
                {{ form_label(form.doctrineRoles) }}
                {{ form_widget(form.doctrineRoles, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.doctrineRoles) }}
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Save Changes
                </button>
                <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">Cancel</a>
            </div>
            
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}