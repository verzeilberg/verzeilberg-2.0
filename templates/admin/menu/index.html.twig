{% extends 'admin/base.html.twig' %}

{% block title %}Menu Management - Admin{% endblock %}

{% block body %}
{% include 'admin/partials/delete_modal.html.twig' %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Menu Management</h1>
    <a href="{{ path('admin_menu_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>New Menu
    </a>
</div>

{% if menus is empty %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No menus created yet. Create your first menu to get started.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Items</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for menu in menus %}
                <tr>
                    <td><strong>{{ menu.name }}</strong></td>
                    <td>{{ menu.menuItemCount }}</td>
                    <td>{{ menu.dateCreated|date('Y-m-d H:i') }}</td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a href="{{ path('admin_menu_show', {id: menu.id}) }}" class="btn btn-outline-primary" title="View Items">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('admin_menu_edit', {id: menu.id}) }}" class="btn btn-outline-secondary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" class="btn btn-outline-danger js-ajax-delete"
                                    data-delete-url="{{ path('admin_menu_delete', {id: menu.id}) }}"
                                    data-delete-message="Are you sure you want to delete the menu &quot;{{ menu.name }}&quot; and all its items? This action cannot be undone."
                                    data-error-message="Failed to delete menu"
                                    data-csrf-token="{{ csrf_token('delete' ~ menu.id) }}"
                                    title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/ajax-delete.js') }}"></script>
{% endblock %}