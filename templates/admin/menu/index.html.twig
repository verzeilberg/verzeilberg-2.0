{% extends 'admin/base.html.twig' %}

{% block title %}Menubeheer - Beheer{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Menubeheer</h1>
    <a href="{{ path('admin_menu_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Nieuw menu
    </a>
</div>

{% if menus is empty %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>Nog geen menu's. Maak je eerste menu aan om te beginnen.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Naam</th>
                    <th>Items</th>
                    <th>Aangemaakt</th>
                    <th>Acties</th>
                </tr>
            </thead>
            <tbody>
                {% for menu in menus %}
                <tr>
                    <td><strong>{{ menu.name }}</strong></td>
                    <td>{{ menu.menuItemCount }}</td>
                    <td>{{ menu.dateCreated|date('Y-m-d H:i') }}</td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a href="{{ path('admin_menu_show', {id: menu.id}) }}" class="btn btn-outline-primary" title="Items bekijken">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('admin_menu_edit', {id: menu.id}) }}" class="btn btn-outline-secondary" title="Bewerken">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" class="btn btn-outline-danger js-ajax-delete"
                                    data-delete-url="{{ path('admin_menu_delete', {id: menu.id}) }}"
                                    data-delete-message="Weet je zeker dat je het menu &quot;{{ menu.name }}&quot; en alle items wilt verwijderen? Dit kan niet ongedaan worden gemaakt."
                                    data-error-message="Menu verwijderen mislukt"
                                    data-csrf-token="{{ csrf_token('delete' ~ menu.id) }}"
                                    title="Verwijderen">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/ajax-delete.js') }}"></script>
{% endblock %}