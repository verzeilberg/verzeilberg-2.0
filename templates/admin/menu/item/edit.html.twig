{% extends 'admin/base.html.twig' %}

{% block title %}Menu-item bewerken - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-edit me-2"></i>Menu-item bewerken: {{ item.label }}</h1>
    <a href="{{ path('admin_menu_show', {id: menu.id}) }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Terug naar menu
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form) }}
            <div class="row mb-3">
                <div class="col-md-8">
                    {{ form_label(form.label) }}
                    {{ form_widget(form.label, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.label) }}
                </div>
                <div class="col-md-4">
                    {{ form_label(form.sortOrder) }}
                    {{ form_widget(form.sortOrder, {'attr': {'class': 'form-control', 'min': 0}}) }}
                    {{ form_errors(form.sortOrder) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.link) }}
                {{ form_widget(form.link, {'attr': {'class': 'form-control'}}) }}
                {{ form_help(form.link) }}
                {{ form_errors(form.link) }}
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    {{ form_label(form.icon) }}
                    {{ form_widget(form.icon, {'attr': {'class': 'form-control'}}) }}
                    {{ form_help(form.icon) }}
                    {{ form_errors(form.icon) }}
                </div>
                <div class="col-md-4">
                    {{ form_label(form.cssClass) }}
                    {{ form_widget(form.cssClass, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.cssClass) }}
                </div>
                <div class="col-md-4">
                    {{ form_label(form.authorizedFor) }}
                    {{ form_widget(form.authorizedFor, {'attr': {'class': 'form-control'}}) }}
                    {{ form_help(form.authorizedFor) }}
                    {{ form_errors(form.authorizedFor) }}
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.parent) }}
                    {{ form_widget(form.parent, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.parent) }}
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        {{ form_widget(form.enabled, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.enabled) }}
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        {{ form_widget(form.openInNewTab, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.openInNewTab) }}
                    </div>
                </div>
            </div>

            <div class="form-actions-bar">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Wijzigingen opslaan
                </button>
                <a href="{{ path('admin_menu_show', {id: menu.id}) }}" class="btn btn-secondary">Annuleren</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}