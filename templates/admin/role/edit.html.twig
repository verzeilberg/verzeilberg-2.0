{% extends 'admin/base.html.twig' %}

{% block title %}Rol bewerken - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-edit me-2"></i>Bewerken: {{ role.name }}</h1>
    <a href="{{ path('admin_role_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Terug
    </a>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-body">
                {% include 'admin/role/_form.html.twig' %}
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card">
            <div class="card-body">
                <h6>Effectieve rechten</h6>
                <p class="small text-muted">Eigen rechten plus overgeërfde rechten, zoals opgeslagen.</p>
                {% set own = role.permissions|map(p => p.name) %}
                {% for name, permission in role.allPermissions %}
                    <span class="badge {{ name in own ? 'bg-secondary' : 'bg-info text-dark' }} me-1 mb-1" title="{{ name in own ? 'eigen' : 'overgeërfd' }}">{{ name }}</span>
                {% else %}
                    <span class="text-muted">Geen</span>
                {% endfor %}
                <hr>
                <p class="mb-1">
                    <a href="{{ path('admin_user_index', {role: role.id}) }}">{{ userCount }} {{ userCount == 1 ? 'gebruiker' : 'gebruikers' }}</a> met deze rol
                </p>
                <p class="small text-muted mb-0">Aangemaakt {{ role.dateCreated|nl_date('d M Y H:i') }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
