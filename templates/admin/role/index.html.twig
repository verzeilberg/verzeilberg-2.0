{% extends 'admin/base.html.twig' %}

{% block title %}Rollen - Beheer{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-user-shield me-2"></i>Rollen</h1>
    <a href="{{ path('admin_role_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Nieuwe rol
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Zoeken</label>
                <input type="text" name="search" class="form-control" placeholder="Zoek rollen..." value="{{ search }}">
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <a href="{{ path('admin_role_index') }}" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-times me-1"></i>Wissen
                </a>
            </div>
        </form>
    </div>
</div>

{% if pagination.getTotalItemCount() == 0 %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>Geen rollen gevonden.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Naam</th>
                    <th>Beschrijving</th>
                    <th>Erft van</th>
                    <th>Rechten</th>
                    <th>Gebruikers</th>
                    <th class="text-end">Acties</th>
                </tr>
            </thead>
            <tbody>
                {% for role in pagination %}
                <tr>
                    <td>
                        <strong>{{ role.name }}</strong>
                        {% if role.systemRole %}<span class="badge bg-light text-dark border ms-1" title="Kan niet worden hernoemd of verwijderd">systeem</span>{% endif %}
                    </td>
                    <td>
                        {{ role.description|slice(0, 80) }}{% if role.description and role.description|length > 80 %}...{% endif %}
                    </td>
                    <td>
                        {% for parent in role.parentRoles %}
                            <span class="badge bg-info me-1">{{ parent.name }}</span>
                        {% else %}
                            <span class="text-muted">Geen</span>
                        {% endfor %}
                    </td>
                    <td>
                        {% if role.name == 'ROLE_ADMIN' %}
                            <span class="badge bg-warning text-dark">alle</span>
                        {% else %}
                            {% set own = role.permissions|map(p => p.name) %}
                            {% for name, permission in role.allPermissions %}
                                <span class="badge {{ name in own ? 'bg-secondary' : 'bg-info text-dark' }} me-1" title="{{ name in own ? 'eigen' : 'overgeërfd' }}">{{ name }}</span>
                            {% else %}
                                <span class="text-muted">Geen</span>
                            {% endfor %}
                        {% endif %}
                    </td>
                    <td><a href="{{ path('admin_user_index', {role: role.id}) }}">{{ userCounts[role.id] ?? 0 }}</a></td>
                    <td class="text-end">
                        <a href="{{ path('admin_role_edit', {id: role.id}) }}" class="btn btn-sm btn-outline-primary" title="Bewerken">
                            <i class="fas fa-edit"></i>
                        </a>
                        {% if not role.systemRole %}
                        <button type="button" class="btn btn-sm btn-outline-danger js-ajax-delete"
                                data-delete-url="{{ path('admin_role_delete', {id: role.id}) }}"
                                data-delete-message="Weet je zeker dat je de rol &quot;{{ role.name }}&quot; wilt verwijderen? Dit kan niet ongedaan worden gemaakt."
                                data-error-message="Rol verwijderen mislukt"
                                data-csrf-token="{{ csrf_token('delete' ~ role.id) }}"
                                title="Verwijderen">
                            <i class="fas fa-trash"></i>
                        </button>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav aria-label="Paginering rollen">
        {{ knp_pagination_render(pagination, '_partials/pagination.html.twig', {}, {label: 'rollen'}) }}
    </nav>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/ajax-delete.js') }}"></script>
{% endblock %}