{% extends 'admin/base.html.twig' %}

{% block title %}Google-agenda's - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fab fa-google me-2"></i>Agenda's van {{ account.email }}</h1>
    <a href="{{ path('admin_agenda_agendas') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Terug naar agenda's</a>
</div>

<div class="card">
    <div class="card-body">
        <p>Kies welke agenda's in de agenda worden getoond. Elke gekozen agenda wordt een agenda die Google volgt; je kunt hem daarna openbaar maken.</p>
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('google_calendars' ~ account.id) }}">
            <div class="list-group mb-3">
                {% for calendar in calendars %}
                    <label class="list-group-item d-flex align-items-center gap-3">
                        <input class="form-check-input m-0" type="checkbox" name="calendars[]" value="{{ calendar.id }}" {{ linked[calendar.id] is defined ? 'checked' }}>
                        <span class="color-dot" style="--dot-color: {{ calendar.color }};"></span>
                        <span>
                            {{ calendar.summary }}
                            {% if calendar.primary %}<span class="badge bg-secondary ms-1">hoofdagenda</span>{% endif %}
                            {% if linked[calendar.id] is defined %}<span class="badge bg-success ms-1">in de agenda</span>{% endif %}
                        </span>
                    </label>
                {% else %}
                    <div class="list-group-item text-muted">Dit account heeft geen agenda's.</div>
                {% endfor %}
            </div>
            <p class="text-muted small"><i class="fas fa-info-circle me-1"></i>Als je een agenda uitvinkt, stoppen de updates; de agenda en de afspraken blijven als gewone agenda bestaan.</p>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Opslaan</button>
        </form>
    </div>
</div>
{% endblock %}
