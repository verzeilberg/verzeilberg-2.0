{% extends 'admin/base.html.twig' %}

{% block title %}Agenda's - Beheer{% endblock %}

{% macro agendaRow(agenda, archived) %}
    {% set feedUrl = url('app_agenda_feed', {token: agenda.feedToken}) %}
    <tr>
        <td><span class="color-dot me-2" style="--dot-color: {{ agenda.color }};"></span><strong>{{ agenda.title }}</strong></td>
        <td>
            {% if agenda.public %}
                <span class="badge bg-success"><i class="fas fa-globe me-1"></i>Op de site</span>
            {% else %}
                <span class="badge bg-secondary"><i class="fas fa-lock me-1"></i>Alleen beheer</span>
            {% endif %}
            {% if agenda.googleLinked %}
                <div class="mt-1 small">
                    <span class="badge bg-light text-dark border"><i class="fab fa-google me-1"></i>{{ agenda.googleAccount.email }}</span>
                    {% if agenda.lastSyncError %}
                        <div class="text-danger" title="{{ agenda.lastSyncError }}"><i class="fas fa-exclamation-triangle me-1"></i>Bijwerken mislukt</div>
                    {% elseif agenda.lastSyncedAt %}
                        <div class="text-muted">Bijgewerkt {{ agenda.lastSyncedAt|date('d-m-Y H:i') }}</div>
                    {% endif %}
                </div>
            {% endif %}
        </td>
        <td>{{ agenda.items|length }}</td>
        <td>
            {% if not archived %}
                <div class="input-group input-group-sm agenda-feed-url">
                    <input type="text" class="form-control" value="{{ feedUrl }}" readonly aria-label="iCal-feed van {{ agenda.title }}" data-select-on-click>
                    <button type="button" class="btn btn-outline-secondary js-copy" data-copy="{{ feedUrl }}" title="Link kopiëren"><i class="fas fa-copy"></i></button>
                    <button type="button" class="btn btn-outline-secondary" title="Link vernieuwen (de oude link werkt dan niet meer)"
                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-delete-url="{{ path('admin_agenda_feed_token', {id: agenda.id}) }}"
                            data-csrf-token="{{ csrf_token('feed_token' ~ agenda.id) }}"
                            data-delete-message="De iCal-link van deze agenda vernieuwen? Agenda's die met de huidige link zijn geabonneerd, krijgen geen updates meer."
                            data-confirm-title="Feedlink vernieuwen" data-confirm-label="Vernieuwen" data-confirm-icon="fa-sync" data-confirm-class="btn-warning">
                        <i class="fas fa-sync"></i>
                    </button>
                </div>
            {% else %}
                <span class="text-muted small">niet zolang gearchiveerd</span>
            {% endif %}
        </td>
        <td class="text-center text-nowrap">
            <div class="btn-group btn-group-sm">
                {% if not archived %}
                    <a href="{{ path('admin_agenda_index', {agendas: [agenda.id]}) }}" class="btn btn-outline-primary" title="Kalender"><i class="fas fa-calendar-alt"></i></a>
                    <a href="{{ path('admin_agenda_edit', {id: agenda.id}) }}" class="btn btn-outline-secondary" title="Bewerken"><i class="fas fa-edit"></i></a>
                    {% if agenda.googleLinked %}
                        <button type="button" class="btn btn-outline-secondary" title="Nu bijwerken vanuit Google"
                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                data-delete-url="{{ path('admin_agenda_google_sync', {id: agenda.id}) }}"
                                data-csrf-token="{{ csrf_token('google_sync' ~ agenda.id) }}"
                                data-delete-message="Nu de nieuwste afspraken van deze agenda ophalen uit Google Calendar?"
                                data-confirm-title="Bijwerken vanuit Google" data-confirm-label="Bijwerken" data-confirm-icon="fa-sync" data-confirm-class="btn-primary">
                            <i class="fas fa-sync"></i>
                        </button>
                    {% else %}
                        <a href="{{ path('admin_agenda_import', {id: agenda.id}) }}" class="btn btn-outline-secondary" title="iCal importeren"><i class="fas fa-file-import"></i></a>
                    {% endif %}
                    <button type="button" class="btn btn-outline-secondary" title="Archiveren"
                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-delete-url="{{ path('admin_agenda_archive', {id: agenda.id}) }}"
                            data-csrf-token="{{ csrf_token('archive_agenda' ~ agenda.id) }}"
                            data-delete-message="Deze agenda archiveren? Hij wordt verborgen in de kalender en op de site, en de feed stopt; je kunt hem later terugzetten."
                            data-confirm-title="Archiveren bevestigen" data-confirm-label="Archiveren" data-confirm-icon="fa-archive" data-confirm-class="btn-warning">
                        <i class="fas fa-archive"></i>
                    </button>
                {% else %}
                    <button type="button" class="btn btn-outline-success" title="Terugzetten"
                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-delete-url="{{ path('admin_agenda_unarchive', {id: agenda.id}) }}"
                            data-csrf-token="{{ csrf_token('unarchive_agenda' ~ agenda.id) }}"
                            data-delete-message="Deze agenda terugzetten?"
                            data-confirm-title="Terugzetten bevestigen" data-confirm-label="Terugzetten" data-confirm-icon="fa-undo" data-confirm-class="btn-success">
                        <i class="fas fa-undo"></i>
                    </button>
                {% endif %}
                <button type="button" class="btn btn-outline-danger" title="Verwijderen"
                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                        data-delete-url="{{ path('admin_agenda_delete', {id: agenda.id}) }}"
                        data-csrf-token="{{ csrf_token('delete_agenda' ~ agenda.id) }}"
                        data-delete-message="Deze agenda en alle items definitief verwijderen? Dit kan niet ongedaan worden gemaakt.">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </td>
    </tr>
{% endmacro %}

{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1><i class="fas fa-cog me-2"></i>Agenda's</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_agenda_index') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Terug naar agenda</a>
        <a href="{{ path('admin_agenda_new') }}" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Nieuwe agenda</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        {% if agendas is empty %}
            <p class="text-muted mb-0">Nog geen agenda's.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Agenda</th><th>Zichtbaarheid</th><th>Items</th><th>iCal-feed</th><th class="text-center"><i class="fas fa-cogs"></i></th></tr></thead>
                    <tbody>{% for agenda in agendas %}{{ _self.agendaRow(agenda, false) }}{% endfor %}</tbody>
                </table>
            </div>
            <p class="text-muted small mt-3 mb-0"><i class="fas fa-info-circle me-1"></i>Abonneer je op de iCal-feed in Google Calendar, Apple Agenda of Outlook. Iedereen met de link kan de agenda zien, ook als hij niet op de site wordt getoond.</p>
        {% endif %}
    </div>
</div>

<h2 class="h5"><i class="fab fa-google me-2"></i>Google Calendar</h2>
<div class="card mb-4">
    <div class="card-body">
        {% if not googleConfigured %}
            <p>Toon de afspraken van een Google Calendar in de agenda. Hiervoor heb je eenmalig een (gratis) Google Cloud-project nodig:</p>
            <ol class="mb-3">
                <li>Ga naar <a href="https://console.cloud.google.com/" target="_blank" rel="noopener">console.cloud.google.com</a>, maak een project aan en schakel de <strong>Google Calendar API</strong> in (APIs &amp; Services → Library).</li>
                <li>Stel het <strong>OAuth consent screen</strong> in (type "External"), voeg de scope <code>…/auth/calendar.readonly</code> toe en voeg je Google-account toe als testgebruiker. Kies daarna <strong>Publish app</strong>: in "Testing" stopt Google de toegang na 7 dagen.</li>
                <li>Maak <strong>Credentials → OAuth client ID</strong> aan van het type "Web application" met deze geautoriseerde redirect-URI:<br>
                    <code>{{ url('admin_agenda_google_callback') }}</code></li>
                <li>Zet de client-ID en het secret in <code>.env.local</code>:<br><code>GOOGLE_CLIENT_ID=…</code><br><code>GOOGLE_CLIENT_SECRET=…</code></li>
                <li>Voeg voor automatische updates een cronjob toe: <code>*/15 * * * * php {{ projectDir }}/bin/console app:agenda:sync-google --quiet</code></li>
            </ol>
            <p class="text-muted small mb-0">Daarna verschijnt hier een knop "Google-account koppelen".</p>
        {% else %}
            {% for account in googleAccounts %}
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 {{ not loop.last ? 'border-bottom' : '' }}">
                    <div>
                        <i class="fab fa-google me-2 text-muted"></i><strong>{{ account.email }}</strong>
                        <span class="text-muted small ms-2">gekoppeld {{ account.connectedAt|date('d-m-Y') }}</span>
                        {% if account.lastError %}
                            <div class="text-danger small"><i class="fas fa-exclamation-triangle me-1"></i>{{ account.lastError }}</div>
                        {% endif %}
                    </div>
                    <div class="d-flex gap-2">
                        {% if account.lastError %}
                            <a href="{{ path('admin_agenda_google_connect') }}" class="btn btn-sm btn-warning"><i class="fas fa-plug me-1"></i>Opnieuw koppelen</a>
                        {% endif %}
                        <a href="{{ path('admin_agenda_google_calendars', {id: account.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-list-check me-1"></i>Agenda's kiezen</a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                data-delete-url="{{ path('admin_agenda_google_disconnect', {id: account.id}) }}"
                                data-csrf-token="{{ csrf_token('google_disconnect' ~ account.id) }}"
                                data-delete-message="{{ account.email }} ontkoppelen? De agenda's worden niet meer bijgewerkt en worden gewone agenda's (de afspraken blijven staan). De toegang van de site wordt ook bij Google ingetrokken."
                                data-confirm-title="Google ontkoppelen" data-confirm-label="Ontkoppelen" data-confirm-icon="fa-unlink" data-confirm-class="btn-danger">
                            <i class="fas fa-unlink me-1"></i>Ontkoppelen
                        </button>
                    </div>
                </div>
            {% else %}
                <p class="text-muted">Nog geen Google-account gekoppeld.</p>
            {% endfor %}
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a href="{{ path('admin_agenda_google_connect') }}" class="btn btn-primary"><i class="fab fa-google me-1"></i>Google-account koppelen</a>
                {% if agendas|filter(agenda => agenda.googleLinked) is not empty %}
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-delete-url="{{ path('admin_agenda_google_sync') }}"
                            data-csrf-token="{{ csrf_token('google_sync') }}"
                            data-delete-message="Nu de nieuwste afspraken van alle Google-agenda's ophalen?"
                            data-confirm-title="Bijwerken vanuit Google" data-confirm-label="Alles bijwerken" data-confirm-icon="fa-sync" data-confirm-class="btn-primary">
                        <i class="fas fa-sync me-1"></i>Nu alles bijwerken
                    </button>
                {% endif %}
            </div>
            <p class="text-muted small mt-3 mb-0"><i class="fas fa-info-circle me-1"></i>Google-agenda's worden automatisch bijgewerkt door de cronjob <code>app:agenda:sync-google</code>. De afspraken zijn hier alleen-lezen: wijzig ze in Google Calendar.</p>
        {% endif %}
    </div>
</div>

{% if archived is not empty %}
    <h2 class="h5"><i class="fas fa-archive me-2"></i>Gearchiveerd</h2>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Agenda</th><th>Zichtbaarheid</th><th>Items</th><th>iCal-feed</th><th class="text-center"><i class="fas fa-cogs"></i></th></tr></thead>
                    <tbody>{% for agenda in archived %}{{ _self.agendaRow(agenda, true) }}{% endfor %}</tbody>
                </table>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/delete-modal.js') }}"></script>
    <script src="{{ asset('js/components/copy-button.js') }}"></script>
{% endblock %}
