{% extends 'admin/base.html.twig' %}

{% block title %}Import iCal - {{ agenda.title }} - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-file-import me-2"></i>Import into "{{ agenda.title }}"</h1>
    <a href="{{ path('admin_agenda_agendas') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to Agendas</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('import_agenda' ~ agenda.id) }}">
            <div class="mb-3">
                <label for="importUrl" class="form-label">iCal link</label>
                <input type="url" id="importUrl" name="url" class="form-control" placeholder="https://… or webcal://…">
                <div class="form-text">For example the "secret address in iCal format" of a Google Calendar, or a competition schedule.</div>
            </div>
            <p class="text-muted">or</p>
            <div class="mb-3">
                <label for="importFile" class="form-label">.ics file</label>
                <input type="file" id="importFile" name="file" class="form-control" accept=".ics,text/calendar">
            </div>
            <div class="alert alert-info small">
                <i class="fas fa-info-circle me-1"></i>
                Importing the same calendar again updates the items instead of adding them twice.
                Recurring events are added as separate items, from one year ago until two years ahead.
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-file-import me-1"></i>Import</button>
        </form>
    </div>
</div>
{% endblock %}
