{% extends 'admin/base.html.twig' %}

{% block title %}iCal importeren - {{ agenda.title }} - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-file-import me-2"></i>Importeren in "{{ agenda.title }}"</h1>
    <a href="{{ path('admin_agenda_agendas') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Terug naar agenda's</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('import_agenda' ~ agenda.id) }}">
            <div class="mb-3">
                <label for="importUrl" class="form-label">iCal-link</label>
                <input type="url" id="importUrl" name="url" class="form-control" placeholder="https://… of webcal://…">
                <div class="form-text">Bijvoorbeeld het "geheime adres in iCal-indeling" van een Google Calendar, of een wedstrijdschema.</div>
            </div>
            <p class="text-muted">of</p>
            <div class="mb-3">
                <label for="importFile" class="form-label">.ics-bestand</label>
                <input type="file" id="importFile" name="file" class="form-control" accept=".ics,text/calendar">
            </div>
            <div class="alert alert-info small">
                <i class="fas fa-info-circle me-1"></i>
                Importeer je dezelfde agenda opnieuw, dan worden de items bijgewerkt in plaats van dubbel toegevoegd.
                Terugkerende afspraken worden als losse items toegevoegd, van een jaar terug tot twee jaar vooruit.
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-file-import me-1"></i>Importeren</button>
        </form>
    </div>
</div>
{% endblock %}
