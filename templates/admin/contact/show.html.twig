{% extends 'admin/base.html.twig' %}

{% block title %}Contactformulier #{{ contact.id }} - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-envelope me-2"></i>Contactformulier #{{ contact.id }}</h1>
    <a href="{{ path('admin_contact_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Terug naar overzicht
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-user me-2"></i>Afzendergegevens</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Aanhef</dt>
                    <dd class="col-sm-9">{{ contact.salutationLabel }}</dd>

                    <dt class="col-sm-3">Naam</dt>
                    <dd class="col-sm-9">{{ contact.name }}</dd>

                    <dt class="col-sm-3">E-mail</dt>
                    <dd class="col-sm-9"><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></dd>
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-envelope-open-text me-2"></i>Bericht</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Onderwerp</dt>
                    <dd class="col-sm-9">{{ contact.subject }}</dd>

                    <dt class="col-sm-3">Verstuurd op</dt>
                    <dd class="col-sm-9">{{ contact.dateCreated|date('d-m-Y H:i') }}</dd>
                </dl>
                <hr>
                <div class="mt-3">
                    {{ contact.message|nl2br }}
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Acties</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="{{ path('admin_contact_reply', {id: contact.id}) }}" class="btn btn-primary">
                        <i class="fas fa-reply me-1"></i>Beantwoorden
                    </a>
                    <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="{{ path('admin_contact_delete', {id: contact.id}) }}" data-delete-token="{{ csrf_token('delete' ~ contact.id) }}" data-delete-message="Weet je zeker dat je dit contactformulier wilt verwijderen?">
                        <i class="fas fa-trash-alt me-1"></i>Verwijderen
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modules/contact/show.js') }}"></script>
{% endblock %}