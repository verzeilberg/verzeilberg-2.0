{% extends 'admin/base.html.twig' %}

{% block title %}Reactiemoderatie - Instellingen{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-comment me-2"></i>Reactiemoderatie</h1>
    <a href="{{ path('admin_settings_index') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Terug naar instellingen
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            {{ form_widget(form.value, {'attr': {'class': 'form-check-input'}}) }}
                            <label class="form-check-label fw-bold" for="{{ form.value.vars.id }}">
                                Reacties eerst goedkeuren
                            </label>
                            <div class="form-text ms-3">
                                Als dit aan staat, moet een beheerder reacties goedkeuren voordat ze op de blog verschijnen.
                                Als dit uit staat, worden reacties van ingelogde gebruikers direct gepubliceerd.
                            </div>
                        </div>
                        {{ form_errors(form.value) }}
                    </div>
                    
                    <div class="form-actions-bar">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Wijzigingen opslaan
                        </button>
                        <a href="{{ path('admin_settings_index') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i>Annuleren
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Huidige status</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-{{ setting.getBooleanValue() ? 'warning' : 'success' }}">
                    <i class="fas fa-{{ setting.getBooleanValue() ? 'exclamation-triangle' : 'check-circle' }} me-2"></i>
                    <strong>Reactiemoderatie staat {{ setting.getBooleanValue() ? 'AAN' : 'UIT' }}.</strong><br>
                    {{ setting.getBooleanValue() 
                        ? 'Alle reacties moeten door een beheerder worden goedgekeurd voordat ze gepubliceerd worden.' 
                        : 'Reacties van ingelogde gebruikers worden direct gepubliceerd.' }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}