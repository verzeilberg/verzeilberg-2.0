{% extends 'admin/base.html.twig' %}

{% block title %}Email Accounts - Admin{% endblock %}

{% block body %}
{% include 'admin/partials/delete_modal.html.twig' %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-mail-bulk me-2"></i>Email Accounts</h1>
    <a href="{{ path('admin_email_account_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Add Account
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Search</label>
                <input type="text" name="search" class="form-control" placeholder="Search accounts..." value="{{ search }}">
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <a href="{{ path('admin_email_account_index') }}" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-times me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

{% if pagination.getTotalItemCount() == 0 %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No email accounts configured. <a href="{{ path('admin_email_account_new') }}">Add one</a>.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Account</th>
                    <th>Email</th>
                    <th>IMAP Server</th>
                    <th>Status</th>
                    <th>Last Sync</th>
                    <th>Messages</th>
                    <th>Unread</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for account in pagination %}
                <tr>
                    <td><strong>{{ account.name }}</strong></td>
                    <td>{{ account.email }}</td>
                    <td>
                        <code>{{ account.imapHost }}:{{ account.imapPort }} ({{ account.encryption }})</code>
                    </td>
                    <td>
                        {% if account.enabled %}
                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Enabled</span>
                        {% else %}
                            <span class="badge bg-secondary"><i class="fas fa-ban me-1"></i>Disabled</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if account.lastSyncedAt %}
                            {{ account.lastSyncedAt|date('d M Y H:i') }}
                        {% else %}
                            <span class="text-muted">Never</span>
                        {% endif %}
                    </td>
                    <td>{{ account.totalMessages }}</td>
                    <td>
                        {% if account.unreadMessages > 0 %}
                            <span class="badge bg-warning">{{ account.unreadMessages }}</span>
                        {% else %}
                            <span class="text-muted">0</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="{{ path('admin_email_account_edit', {id: account.id}) }}" class="btn btn-outline-secondary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" class="btn btn-outline-success test-account" 
                                    data-id="{{ account.id }}" 
                                    data-csrf-token="{{ csrf_token('test' ~ account.id) }}"
                                    title="Test IMAP Connection">
                                <i class="fas fa-plug"></i>
                            </button>
                            <button type="button" class="btn btn-outline-warning test-smtp" 
                                    data-id="{{ account.id }}" 
                                    data-csrf-token="{{ csrf_token('test_smtp' ~ account.id) }}"
                                    title="Test SMTP Connection">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger delete-account" 
                                    data-id="{{ account.id }}" 
                                    data-name="{{ account.name|escape('html_attr') }}"
                                    data-csrf-token="{{ csrf_token('delete' ~ account.id) }}"
                                    title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav aria-label="Accounts pagination">
        {{ knp_pagination_render(pagination) }}
    </nav>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modules/email-account/index.js') }}"
            data-delete-url="{{ path('admin_email_account_delete', {id: '__ID__'}) }}"
            data-test-url="{{ path('admin_email_account_test', {id: '__ID__'}) }}"
            data-test-smtp-url="{{ path('admin_email_account_test_smtp', {id: '__ID__'}) }}"></script>
{% endblock %}