{% extends 'admin/base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ permission.id ? 'Recht bewerken' : 'Nieuw recht' }} - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-key me-2"></i>{{ permission.id ? 'Bewerken: ' ~ permission.name : 'Nieuw recht' }}</h1>
    <a href="{{ path('admin_permission_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Terug
    </a>
</div>

<div class="card" style="max-width: 48rem">
    <div class="card-body">
        {% if permission.id %}
            <div class="alert alert-warning small">
                Hernoemen past de naam overal in het beheer aan, maar code die
                <code>PERM_{{ permission.name }}</code> controleert, blijft de oude naam gebruiken.
            </div>
        {% endif %}
        {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.description) }}
        <div class="form-actions-bar">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Opslaan</button>
            <a href="{{ path('admin_permission_index') }}" class="btn btn-secondary">Annuleren</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
