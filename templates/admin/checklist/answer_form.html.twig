{% extends 'admin/base.html.twig' %}

{% block title %}{{ action == 'new' ? 'New' : 'Edit' }} Answer - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-{{ action == 'new' ? 'plus' : 'edit' }} me-2"></i>
        {{ action == 'new' ? 'New' : 'Edit' }} Answer
    </h1>
    <a href="{{ path('admin_checklist_answers') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Answers
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_row(form.label, {
                        'label': 'Label',
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'placeholder': 'Display label (e.g. Yes, No, Maybe)'}
                    }) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.value, {
                        'label': 'Value',
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'placeholder': 'Internal value (e.g. 1, 0, yes, no)'}
                    }) }}
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>{{ action == 'new' ? 'Create' : 'Save' }} Answer
                </button>
                <a href="{{ path('admin_checklist_answers') }}" class="btn btn-outline-secondary">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}