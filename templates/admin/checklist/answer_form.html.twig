{% extends 'admin/base.html.twig' %}

{% block title %}{{ action == 'new' ? 'Nieuw antwoord' : 'Antwoord bewerken' }} - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-{{ action == 'new' ? 'plus' : 'edit' }} me-2"></i>
        {{ action == 'new' ? 'Nieuw antwoord' : 'Antwoord bewerken' }}
    </h1>
    <a href="{{ path('admin_checklist_answers') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Terug naar antwoorden
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_row(form.label, {
                        'label': 'Label',
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'placeholder': 'Getoond label (bijv. Ja, Nee, Misschien)'}
                    }) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.value, {
                        'label': 'Waarde',
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'placeholder': 'Interne waarde (bijv. 1, 0, ja, nee)'}
                    }) }}
                </div>
            </div>
            <div class="form-actions-bar">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>{{ action == 'new' ? 'Antwoord aanmaken' : 'Antwoord opslaan' }}
                </button>
                <a href="{{ path('admin_checklist_answers') }}" class="btn btn-outline-secondary">Annuleren</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}