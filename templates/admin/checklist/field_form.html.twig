{% extends 'admin/base.html.twig' %}

{% block title %}{{ action == 'new' ? 'New' : 'Edit' }} Field - {{ checkList.name }} - Admin{% endblock %}

{% block body %}
{# Required / show in overview are hidden until a type is chosen, and for fieldsets; the script keeps this in sync #}
{% set selectedFormType = form.vars.value.fieldType ? form.vars.value.fieldType.formType : '' %}
{% set hideValueOptions = selectedFormType in ['', 'fieldset'] %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-{{ action == 'new' ? 'plus' : 'edit' }} me-2"></i>
        {{ action == 'new' ? 'New' : 'Edit' }} Field - {{ checkList.name }}
    </h1>
    <a href="{{ path('admin_checklist_edit', {id: checkList.id, _fragment: 'fields'}) }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Fields
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

            <div class="row mb-3">
                <div class="col-md-8">
                    {{ form_row(form.name, {
                        'label': 'Name',
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'required': 'required'}
                    }) }}
                </div>
            </div>


            <div class="row mb-3">
                <div class="col-md-8">
                    {{ form_label(form.parent, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.parent) }}
                    <div class="form-text">{{ form.parent.vars.help }}</div>
                    {{ form_errors(form.parent) }}
                </div>
            </div>

            {# Not for fieldsets and files; the script keeps this in sync with the chosen type #}
            <div class="row mb-3" data-field="defaultValue"{{ selectedFormType in ['', 'file', 'fieldset'] ? ' style="display: none;"' }}>
                <div class="col-md-8">
                    {{ form_label(form.defaultValue, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.defaultValue) }}
                    <div class="form-text">{{ form.defaultValue.vars.help }}</div>
                    {{ form_errors(form.defaultValue) }}
                </div>
            </div>

            {# Only for types that show a placeholder; the script keeps this in sync with the chosen type #}
            <div class="row mb-3" data-field="placeholder" data-form-types="{{ constant('App\\Entity\\CheckListField::PLACEHOLDER_TYPES')|join(',') }}"{{ selectedFormType not in constant('App\\Entity\\CheckListField::PLACEHOLDER_TYPES') ? ' style="display: none;"' }}>
                <div class="col-md-8">
                    {{ form_label(form.placeholder, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.placeholder) }}
                    <div class="form-text">{{ form.placeholder.vars.help }}</div>
                    {{ form_errors(form.placeholder) }}
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-8">
                    {{ form_label(form.conditionField, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.conditionField) }}
                    <div class="form-text">{{ form.conditionField.vars.help }}</div>
                    {{ form_errors(form.conditionField) }}
                    {{ form_widget(form.conditionValues) }}
                    <div id="conditionValuesList" class="d-flex flex-wrap gap-3 mt-2"></div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    {{ form_row(form.order, {
                        'label': false,
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'min': 0, 'value': 999, 'hidden': 'hidden'}
                    }) }}
                </div>
            </div>

            <div class="row mb-3" data-field="showInOverview"{{ hideValueOptions ? ' style="display: none;"' }}>
                <div class="col-md-4">
                    {{ form_label(form.showInOverview, 'Show in Overview', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="form-check form-switch">
                        {{ form_widget(form.showInOverview, {
                            'attr': {'class': 'form-check-input', 'style': 'width: 3rem; height: 1.5rem;'}
                        }) }}
                    </div>
                </div>
            </div>

            <div class="row mb-3" data-field="required"{{ hideValueOptions ? ' style="display: none;"' }}>
                <div class="col-md-4">
                    {{ form_label(form.required, 'Required', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="form-check form-switch">
                        {{ form_widget(form.required, {
                            'attr': {'class': 'form-check-input', 'style': 'width: 3rem; height: 1.5rem;', 'id': 'requiredSwitch'}
                        }) }}
                    </div>
                    <div class="col-md-12 mt-2 required-message-field" style="display: none;">
                        {{ form_row(form.requiredMessage, {
                            'label': 'Required Message',
                            'label_attr': {'class': 'form-label'},
                            'attr': {'class': 'form-control', 'placeholder': 'Enter custom message when required'}
                        }) }}
                    </div>
                </div>
            </div>

            <div class="row mb-3" id="introTextField" style="display: none;">
                <div class="col-md-8">
                    {{ form_row(form.introText, {
                        'label': 'Intro Text',
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Text shown above field'}
                    }) }}
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.fieldType, 'Field Type', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.fieldType, {
                        'attr': {'class': 'form-select', 'id': 'checklistFieldType'}
                    }) }}
                </div>
            </div>

            <div id="optionField" class="mb-3" style="display: none;">
                <fieldset id="optionsFieldset">
                    <legend>Options</legend>

                    {# readonly: text, textarea, number #}
                    <div class="row mb-3 option options-text options-textarea options-number">
                        <label class="col-md-2 col-form-label">Read only</label>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.readonly, {'attr': {'class': 'form-check-input'}}) }}
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3 option options-text options-textarea options-number">
                        <label class="col-md-2 col-form-label">Disabled</label>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.disabled, {'attr': {'class': 'form-check-input'}}) }}
                            </div>
                        </div>
                    </div>

                    {# autofocus: text, textarea, number #}
                    <div class="row mb-3 option options-text options-textarea options-number">
                        <label class="col-md-2 col-form-label">Autofocus</label>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.autofocus, {'attr': {'class': 'form-check-input'}}) }}
                            </div>
                        </div>
                    </div>

                    {# maxlength: text, number #}
                    <div class="row mb-3 option options-text options-number">
                        <label class="col-md-2 col-form-label">Max length</label>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.maxlength, {'attr': {'class': 'form-check-input'}}) }}
                            </div>
                        </div>
                        <div class="col-md-3 maxlength-value-field" style="display: none;">
                            {{ form_widget(form.maxLengthValue, {'attr': {'class': 'form-control', 'step': '1', 'pattern': '[0-9]*', 'value': form.maxLengthValue.vars.value|default('')}}) }}
                        </div>
                    </div>

                    {# resize: Textarea(2) only #}
                    <div class="row mb-3 option options-textarea">
                        <label class="col-md-2 col-form-label">Resize</label>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                {{ form_widget(form.resize, {'attr': {'class': 'form-check-input'}}) }}
                            </div>
                        </div>
                    </div>

                    {# measurements: Textarea(2) only #}
                    <div class="row mb-3 option options-textarea">
                        <label class="col-md-2 col-form-label">Dimensions</label>
                        <div class="col-md-2">
                            <div class="form-check form-switch">
                                {{ form_widget(form.measurements, {'attr': {'class': 'form-check-input'}}) }}
                            </div>
                        </div>
                        <div id="textareaMeasurements" class="col-md-6 measurements-fields" style="display: none;">
                            <div class="row">
                                <div class="col-md-4">
                                    {{ form_widget(form.textareaWidth, {'attr': {'class': 'form-control', 'placeholder': 'width', 'min': 1, 'step': 1}}) }}
                                </div>
                                <div class="col-md-4">
                                    {{ form_widget(form.textareaHeight, {'attr': {'class': 'form-control', 'placeholder': 'height', 'min': 1, 'step': 1}}) }}
                                </div>
                                <div class="col-md-4">
                                    {{ form_widget(form.measurementsType, {'attr': {'class': 'form-select'}}) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# URL (14) - no options #}

                    {# File (11) - upload options #}
                    <div class="row mb-3 option options-file">
                        <label class="col-md-2 col-form-label">Max Upload Size (MB)</label>
                        <div class="col-md-3">
                            {{ form_widget(form.maxUploadSize, {'attr': {'class': 'form-control', 'type': 'number', 'min': 1, 'max': 100, 'step': 1, 'placeholder': 'e.g. 10'}}) }}
                        </div>
                    </div>

                    <div class="row mb-3 option options-file">
                        <label class="col-md-2 col-form-label">Allowed File Types</label>
                        <div class="col-md-6">
                            {{ form_widget(form.allowedFileTypes, {'attr': {'class': 'form-control', 'placeholder': 'pdf,jpg,png or application/pdf,image/jpeg,image/png'}}) }}
                            <small class="form-text text-muted">Comma-separated extensions (pdf,jpg,png) or MIME types (application/pdf,image/jpeg)</small>
                        </div>
                    </div>

                    {# Date (8) - date format options #}
                    <div class="row mb-3 option options-date">
                        <label class="col-md-2 col-form-label">Date Format</label>
                        <div class="col-md-4">
                            {{ form_widget(form.dateFormat, {'attr': {'class': 'form-select'}}) }}
                        </div>
                    </div>

                    <div class="row mb-3 option options-date">
                        <label class="col-md-2 col-form-label">Show Time</label>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.showTime, {'attr': {'class': 'form-check-input'}}) }}
                            </div>
                        </div>
                    </div>

                    {# Email (6) - domain restriction options #}
                    <div class="row mb-3 option options-email">
                        <label class="col-md-2 col-form-label">Allowed Domains</label>
                        <div class="col-md-6">
                            {{ form_widget(form.allowedEmailDomains, {'attr': {'class': 'form-control', 'placeholder': 'verzeilberg.nl,hotmail.com,.nl,.eu'}}) }}
                            <small class="form-text text-muted">Comma-separated domains (verzeilberg.nl,hotmail.com) or TLDs (.nl,.eu)</small>
                        </div>
                    </div>

                    {# prepend/append: Text(1) only #}
                    <div class="row mb-3 option options-text">
                        <label class="col-md-2 col-form-label">Prepend/Append</label>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.prependappend, {'attr': {'class': 'form-check-input'}}) }}
                            </div>
                        </div>
                        <div class="col-md-7 prependappend-fields" style="display: none;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="d-flex gap-3">
                                    {% for child in form.preapp %}
                                        <div class="form-check form-check-inline">
                                            {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(child) }}
                                        </div>
                                    {% endfor %}
                                </div>
                                <div class="min-w-150px">
                                    {{ form_widget(form.apppreinput, {'attr': {'class': 'form-control', 'placeholder': 'VB: ml'}}) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    </fieldset>
            </div>

            <div id="answers" class="mb-3" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label mb-0">Predefined Answers (for select/radio/checkbox)</label>
                    <a href="{{ path('admin_checklist_answers') }}" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-cog me-1"></i>Manage Answers
                    </a>
                </div>
                {{ form_row(form.answers, {
                    'label': false,
                    'help': 'Hold Ctrl (Cmd on Mac) to select multiple answers',
                    'attr': {'class': 'form-select', 'size': 5}
                }) }}
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>{{ action == 'new' ? 'Create' : 'Save' }} Field
                </button>
                <a href="{{ path('admin_checklist_edit', {id: checkList.id, _fragment: 'fields'}) }}" class="btn btn-outline-secondary">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modules/checklist/field-form.js') }}"></script>
{% endblock %}
