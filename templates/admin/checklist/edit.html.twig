{% extends 'admin/base.html.twig' %}

{% block title %}Checklist bewerken: {{ checkList.name }} - Beheer{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="//code.jquery.com/ui/1.12.1/themes/smoothness/jquery-ui.css" rel="stylesheet">
{% endblock %}

{% block javascripts_head %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/nestable@0.2.0/jquery.nestable.js"></script>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-edit me-2"></i>Checklist bewerken: {{ checkList.name }}</h1>
    <a href="{{ path('admin_checklist_index') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Terug naar checklists
    </a>
</div>

<ul class="nav nav-tabs mb-4" id="checklistTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">
            <i class="fas fa-info-circle me-1"></i>Algemeen
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="fields-tab" data-bs-toggle="tab" data-bs-target="#fields" type="button" role="tab">
            <i class="fas fa-columns me-1"></i>Velden ({{ fields|filter(field => field.formType != 'fieldset')|length }})
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="items-tab" data-bs-toggle="tab" data-bs-target="#items" type="button" role="tab">
            <i class="fas fa-list me-1"></i>Items
        </button>
    </li>
</ul>

<div class="tab-content" id="checklistTabsContent">
    <div class="tab-pane fade show active" id="general" role="tabpanel">
        <div class="card">
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    <div class="row mb-3">
                        <div class="col-md-8">
                            {{ form_row(form.name, {
                                'label': 'Naam',
                                'label_attr': {'class': 'form-label'},
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            {{ form_row(form.access, {
                                'label': 'Toegang',
                                'label_attr': {'class': 'form-label'}
                            }) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.layoutColumns, {
                                'label': 'Indeling',
                                'label_attr': {'class': 'form-label'}
                            }) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.itemsPerPage, {
                                'label': 'Items per pagina',
                                'label_attr': {'class': 'form-label'}
                            }) }}
                        </div>
                    </div>
                    <div class="border-top pt-4 mt-4 mb-4">
                        <h3 class="h6 mb-2">Sorteren</h3>
                        <p class="text-muted small mb-3">Hoe de items in de overzichten staan. Bij gelijke waarden beslist het volgende niveau. Klik je op een kolomkop, dan sorteer je tijdelijk anders.</p>
                        {# A level for every choice; js/modules/checklist/order-levels.js shows the next one after a choice #}
                        <div class="js-order-levels">
                            {% for level in 1..(form.children|keys|filter(name => name starts with 'orderBy')|length) %}
                                <div class="row mb-3 js-order-level">
                                    <div class="col-md-8">
                                        {{ form_row(form['orderBy' ~ level], {'label_attr': {'class': 'form-label'}}) }}
                                    </div>
                                    <div class="col-md-4 js-order-dir">
                                        {{ form_row(form['orderDir' ~ level], {'label_attr': {'class': 'form-label'}}) }}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% if checkList.access != 'admin' %}
                        {% set publicUrl = url('app_checklist_fill', {id: checkList.id}) %}
                        <div class="alert alert-info">
                            <i class="fas fa-link me-1"></i>
                            {{ {public: 'Iedereen', user: 'Ingelogde gebruikers', friends: (checkList.owner ? 'Vrienden van ' ~ checkList.owner.fullName : 'Vrienden')}[checkList.access] }} kan deze checklist invullen via:
                            <a href="{{ publicUrl }}" target="_blank" rel="noopener">{{ publicUrl }}</a>
                            {% if checkList.deleted %}<br><small>(niet zolang de checklist gearchiveerd is)</small>{% endif %}
                        </div>
                    {% endif %}
                    <div class="form-actions-bar">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Wijzigingen opslaan
                        </button>
                        <a href="{{ path('admin_checklist_index') }}" class="btn btn-outline-secondary">Annuleren</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="fields" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Velden (sleep om de volgorde te wijzigen)</h5>
                <a href="{{ path('admin_checklist_field_new', {id: checkList.id}) }}" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i>Veld toevoegen
                </a>
            </div>
            <div class="card-body">
                {% if fields is empty %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>Nog geen velden. <a href="{{ path('admin_checklist_field_new', {id: checkList.id}) }}">Voeg je eerste veld toe</a>.
                    </div>
                {% else %}
                    <div id="field-nestable" class="dd">
                        {% include 'admin/checklist/_field_tree.html.twig' with {fields: fields} %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="items" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Items</h5>
                <a href="{{ path('admin_checklist_item_new', {id: checkList.id}) }}" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i>Item toevoegen
                </a>
            </div>
            <div class="card-body">
                {% if pagination is defined and pagination.getTotalItemCount() > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Aangemaakt</th>
                                {% for field in overviewFields %}
                                    <th>{{ field.name }}</th>
                                {% else %}
                                    <th class="text-muted fw-normal">Geen velden gemarkeerd als "Tonen in overzicht"</th>
                                {% endfor %}
                                <th class="text-center"><i class="fas fa-cogs"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in pagination %}
                            <tr>
                                <td>{{ item.id }}</td>
                                <td>{{ item.dateCreated|nl_date('j M Y H:i') }}</td>
                                {% for field in overviewFields %}
                                    {% set value = overviewValues[item.id][field.id] ?? null %}
                                    <td>
                                        {% if value is null %}
                                            <span class="text-muted">&ndash;</span>
                                        {% elseif field.formType == 'file' %}
                                            <a href="{{ path('app_checklist_item_file', {id: item.id, field: field.formFieldName}) }}" target="_blank" rel="noopener"><i class="fas fa-paperclip me-1"></i>{{ value|split('/')|last }}</a>
                                        {% elseif field.formType == 'url' %}
                                            <a href="{{ value }}" target="_blank" rel="noopener noreferrer"><i class="fas fa-external-link-alt me-1"></i>{{ value|u.truncate(40, '…') }}</a>
                                        {% else %}
                                            {{ value|u.truncate(60, '…') }}
                                        {% endif %}
                                    </td>
                                {% else %}
                                    <td></td>
                                {% endfor %}
                                <td class="text-center">
                                    <a href="{{ path('admin_checklist_item_edit', {id: item.id}) }}" class="btn btn-sm btn-outline-secondary" title="Bewerken">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-delete-url="{{ path('admin_checklist_item_delete', {id: item.id}) }}"
                                            data-csrf-token="{{ csrf_token('delete_item' ~ item.id) }}"
                                            data-delete-message="Weet je zeker dat je dit item wilt verwijderen? Alle antwoorden van dit item worden ook verwijderd."
                                            title="Verwijderen">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <nav aria-label="Paginering items">
                    {{ knp_pagination_render(pagination, '_partials/pagination.html.twig', {}, {label: 'items'}) }}
                </nav>
                {% else %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>Geen items gevonden. <a href="{{ path('admin_checklist_item_new', {id: checkList.id}) }}">Maak het eerste item aan</a>.
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="checklistToasts" aria-live="polite"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/delete-modal.js') }}"></script>
    <script src="{{ asset('js/modules/checklist/order-levels.js') }}"></script>
    <script src="{{ asset('js/modules/checklist/edit.js') }}"
            data-reorder-url="{{ path('admin_checklist_edit_reorder', {id: checkList.id}) }}"
            data-reorder-token="{{ csrf_token('reorder_fields' ~ checkList.id) }}"></script>
{% endblock %}