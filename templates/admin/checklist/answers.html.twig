{% extends 'admin/base.html.twig' %}

{% block title %}Answers - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-list-ol me-2"></i>Answers</h1>
    <a href="{{ path('admin_checklist_answer_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>New Answer
    </a>
</div>

{% if answers is empty %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No answers defined. <a href="{{ path('admin_checklist_answer_new') }}">Create the first one</a>.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Value</th>
                    <th>Fields Using</th>
                    <th class="text-center"><i class="fas fa-cogs"></i></th>
                </tr>
            </thead>
            <tbody>
                {% for answer in answers %}
                <tr>
                    <td><strong>{{ answer.label }}</strong></td>
                    <td><code>{{ answer.value }}</code></td>
                    <td>{{ answer.checkListFields|length }}</td>
                    <td class="text-center">
                        <a href="{{ path('admin_checklist_answer_edit', {id: answer.id}) }}" class="btn btn-sm btn-outline-secondary" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger delete-answer" data-id="{{ answer.id }}" data-csrf-token="{{ csrf_token('delete_answer' ~ answer.id) }}" title="Delete">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modules/checklist/answers.js') }}" data-delete-url="{{ path('admin_checklist_answer_delete', {id: 0})|replace({'/0/': '/__ID__/'}) }}"></script>
{% endblock %}