{% extends 'admin/base.html.twig' %}

{% block title %}{{ action == 'new' ? 'New' : 'Edit' }} Item - {{ checkList.name }} - Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'admin/checklist/_item_form_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-{{ action == 'new' ? 'plus' : 'edit' }} me-2"></i>
        {{ action == 'new' ? 'New' : 'Edit' }} Item - {{ checkList.name }}
    </h1>
    <a href="{{ path('admin_checklist_edit', {id: checkList.id, _fragment: 'items'}) }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Items
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

        {% if form.vars.submitted and not form.vars.valid %}
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-triangle me-1"></i>The item has not been saved. Please check the marked fields.
                {% for error in form.vars.errors %}
                    <div>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="row">
            {% for field in fields|filter(field => field.parent is null) %}
                {% include 'admin/checklist/_item_field.html.twig' %}
            {% endfor %}
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>{{ action == 'new' ? 'Create' : 'Save' }} Item
            </button>
            <a href="{{ path('admin_checklist_edit', {id: checkList.id, _fragment: 'items'}) }}" class="btn btn-outline-secondary">Cancel</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'admin/checklist/_item_form_scripts.html.twig' %}
{% endblock %}
