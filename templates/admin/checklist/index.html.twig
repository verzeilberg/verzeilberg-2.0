{% extends 'admin/base.html.twig' %}

{% block title %}Checklists - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-clipboard-list me-2"></i>Checklists</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_checklist_archive') }}" class="btn btn-outline-secondary">
            <i class="fas fa-archive me-1"></i>Archived
        </a>
        <a href="{{ path('admin_checklist_new') }}" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>New Checklist
        </a>
    </div>
</div>

{% if pagination.getTotalItemCount() == 0 %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No checklists found. <a href="{{ path('admin_checklist_new') }}">Create your first checklist</a>.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Access</th>
                    <th>Fields</th>
                    <th>Items</th>
                    <th>Created</th>
                    <th class="text-center"><i class="fas fa-cogs"></i></th>
                </tr>
            </thead>
            <tbody>
                {% for checkList in pagination %}
                <tr>
                    <td>
                        <strong>{{ checkList.name }}</strong>
                    </td>
                    <td>
                        {% if checkList.access == 'public' %}
                            <span class="badge bg-success"><i class="fas fa-globe me-1"></i>Public</span>
                        {% elseif checkList.access == 'user' %}
                            <span class="badge bg-info text-dark"><i class="fas fa-user me-1"></i>Logged-in</span>
                        {% else %}
                            <span class="badge bg-secondary"><i class="fas fa-lock me-1"></i>Admin only</span>
                        {% endif %}
                    </td>
                    {# All fields that hold an answer, including those inside fieldsets (a fieldset itself is not counted) #}
                    <td>{{ checkList.allCheckListFields|filter(field => field.formType != 'fieldset')|length }}</td>
                    <td>{{ checkList.checkListItems|length }}</td>
                    <td>{{ checkList.dateCreated|date('M d, Y H:i') }}</td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            <a href="{{ path('admin_checklist_show', {id: checkList.id}) }}" class="btn btn-outline-primary" title="View">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('admin_checklist_edit', {id: checkList.id}) }}" class="btn btn-outline-secondary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" class="btn btn-outline-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-delete-url="{{ path('admin_checklist_duplicate', {id: checkList.id}) }}"
                                    data-csrf-token="{{ csrf_token('duplicate' ~ checkList.id) }}"
                                    data-delete-message="Make a copy of this checklist with all its fields? Items are not copied."
                                    data-confirm-title="Confirm Duplicate"
                                    data-confirm-label="Duplicate"
                                    data-confirm-icon="fa-copy"
                                    data-confirm-class="btn-primary"
                                    title="Duplicate">
                                <i class="fas fa-copy"></i>
                            </button>
                            {% if checkList.deleted %}
                                <button type="button" class="btn btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-delete-url="{{ path('admin_checklist_unarchive', {id: checkList.id}) }}"
                                        data-csrf-token="{{ csrf_token('unarchive' ~ checkList.id) }}"
                                        data-delete-message="Are you sure you want to unarchive this checklist?"
                                        data-confirm-title="Confirm Unarchive"
                                        data-confirm-label="Unarchive"
                                        data-confirm-icon="fa-undo"
                                        data-confirm-class="btn-primary"
                                        title="Unarchive">
                                    <i class="fas fa-undo"></i>
                                </button>
                            {% else %}
                                <button type="button" class="btn btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-delete-url="{{ path('admin_checklist_archive_item', {id: checkList.id}) }}"
                                        data-csrf-token="{{ csrf_token('archive' ~ checkList.id) }}"
                                        data-delete-message="Are you sure you want to archive this checklist? You can unarchive it later."
                                        data-confirm-title="Confirm Archive"
                                        data-confirm-label="Archive"
                                        data-confirm-icon="fa-archive"
                                        data-confirm-class="btn-warning"
                                        title="Archive">
                                    <i class="fas fa-archive"></i>
                                </button>
                            {% endif %}
                            <button type="button" class="btn btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-delete-url="{{ path('admin_checklist_delete', {id: checkList.id}) }}"
                                    data-csrf-token="{{ csrf_token('delete' ~ checkList.id) }}"
                                    data-delete-message="Are you sure you want to permanently delete this checklist? All its fields, items and uploaded files will be deleted. This cannot be undone."
                                    title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav aria-label="Checklists pagination">
        {{ knp_pagination_render(pagination) }}
    </nav>
{% endif %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/delete-modal.js') }}"></script>
{% endblock %}
