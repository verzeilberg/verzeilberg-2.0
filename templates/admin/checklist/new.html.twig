{% extends 'admin/base.html.twig' %}

{% block title %}New Checklist - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-plus me-2"></i>New Checklist</h1>
    <a href="{{ path('admin_checklist_index') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Checklists
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            <div class="row mb-3">
                <div class="col-md-8">
                    {{ form_row(form.name, {
                        'label': 'Name',
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'placeholder': 'Enter checklist name'}
                    }) }}
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    {{ form_row(form.access, {
                        'label': 'Access',
                        'label_attr': {'class': 'form-label'}
                    }) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.layoutColumns, {
                        'label': 'Layout',
                        'label_attr': {'class': 'form-label'}
                    }) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.itemsPerPage, {
                        'label': 'Items per page',
                        'label_attr': {'class': 'form-label'}
                    }) }}
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Save Checklist
                </button>
                <a href="{{ path('admin_checklist_index') }}" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}