{% extends 'admin/base.html.twig' %}

{% block title %}Archived Checklists - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-archive me-2"></i>Archived Checklists</h1>
    <a href="{{ path('admin_checklist_index') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Active
    </a>
</div>

{% if pagination.getTotalItemCount() == 0 %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No archived checklists.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Fields</th>
                    <th>Items</th>
                    <th>Created</th>
                    <th class="text-center"><i class="fas fa-cogs"></i></th>
                </tr>
            </thead>
            <tbody>
                {% for checkList in pagination %}
                <tr>
                    <td>
                        <strong>{{ checkList.name }}</strong>
                    </td>
                    {# All fields that hold an answer, including those inside fieldsets (a fieldset itself is not counted) #}
                    <td>{{ checkList.allCheckListFields|filter(field => field.formType != 'fieldset')|length }}</td>
                    <td>{{ checkList.checkListItems|length }}</td>
                    <td>{{ checkList.dateCreated|date('M d, Y H:i') }}</td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-success"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-delete-url="{{ path('admin_checklist_unarchive', {id: checkList.id}) }}"
                                    data-csrf-token="{{ csrf_token('unarchive' ~ checkList.id) }}"
                                    data-delete-message="Are you sure you want to restore this checklist?"
                                    data-confirm-title="Confirm Unarchive"
                                    data-confirm-label="Unarchive"
                                    data-confirm-icon="fa-undo"
                                    data-confirm-class="btn-success"
                                    title="Unarchive">
                                <i class="fas fa-undo"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-delete-url="{{ path('admin_checklist_delete', {id: checkList.id}) }}"
                                    data-csrf-token="{{ csrf_token('delete' ~ checkList.id) }}"
                                    data-delete-message="Are you sure you want to permanently delete this checklist? All its fields, items and uploaded files will be deleted. This cannot be undone."
                                    title="Delete Permanently">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav aria-label="Archived checklists pagination">
        {{ knp_pagination_render(pagination) }}
    </nav>
{% endif %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/delete-modal.js') }}"></script>
{% endblock %}
