{% extends 'admin/base.html.twig' %}

{% block title %}{{ action == 'new' ? 'Nieuw veldtype' : 'Veldtype bewerken' }} - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-{{ action == 'new' ? 'plus' : 'edit' }} me-2"></i>
        {{ action == 'new' ? 'Nieuw veldtype' : 'Veldtype bewerken' }}
    </h1>
    <a href="{{ path('admin_checklist_field_types') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Terug naar veldtypen
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            <div class="row mb-3">
                <div class="col-md-8">
                    {{ form_row(form.name, {
                        'label': 'Naam',
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'placeholder': 'bijv. Tekstveld, Keuzelijst, Selectievakje'}
                    }) }}
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_row(form.formType, {
                        'label': 'Formuliertype',
                        'label_attr': {'class': 'form-label'}
                    }) }}
                </div>
            </div>
            <div class="form-actions-bar">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>{{ action == 'new' ? 'Veldtype aanmaken' : 'Veldtype opslaan' }}
                </button>
                <a href="{{ path('admin_checklist_field_types') }}" class="btn btn-outline-secondary">Annuleren</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}