{% extends 'admin/base.html.twig' %}

{% block title %}{{ action == 'new' ? 'New' : 'Edit' }} Field Type - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-{{ action == 'new' ? 'plus' : 'edit' }} me-2"></i>
        {{ action == 'new' ? 'New' : 'Edit' }} Field Type
    </h1>
    <a href="{{ path('admin_checklist_field_types') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Field Types
    </a>
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            <div class="row mb-3">
                <div class="col-md-8">
                    {{ form_row(form.name, {
                        'label': 'Name',
                        'label_attr': {'class': 'form-label'},
                        'attr': {'class': 'form-control', 'placeholder': 'e.g. Text Input, Dropdown, Checkbox'}
                    }) }}
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_row(form.formType, {
                        'label': 'Form Type',
                        'label_attr': {'class': 'form-label'}
                    }) }}
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>{{ action == 'new' ? 'Create' : 'Save' }} Field Type
                </button>
                <a href="{{ path('admin_checklist_field_types') }}" class="btn btn-outline-secondary">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}