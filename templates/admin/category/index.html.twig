{% extends 'admin/base.html.twig' %}

{% block title %}Categorieën - Beheer{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-tags me-2"></i>Categorieën</h1>
    <a href="{{ path('admin_category_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Nieuwe categorie
    </a>
</div>

<div class="mb-3">
    <div class="btn-group" role="group">
        <a href="{{ path('admin_category_index', {status: 'enabled'}) }}" class="btn {% if currentStatus == 'enabled' %}btn-success{% else %}btn-outline-success{% endif %}">
            <i class="fas fa-check me-1"></i>Actief ({{ enabledCount }})
        </a>
        <a href="{{ path('admin_category_index', {status: 'disabled'}) }}" class="btn {% if currentStatus == 'disabled' %}btn-secondary{% else %}btn-outline-secondary{% endif %}">
            <i class="fas fa-ban me-1"></i>Inactief ({{ disabledCount }})
        </a>
        <a href="{{ path('admin_category_index') }}" class="btn {% if currentStatus == 'all' %}btn-primary{% else %}btn-outline-primary{% endif %}">
            <i class="fas fa-list me-1"></i>Alle
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Slug</th>
                        <th>Beschrijving</th>
                        <th>Status</th>
                        <th class="text-end">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in pagination %}
                    <tr>
                        <td>{{ category.name }}</td>
                        <td>{{ category.slug }}</td>
                        <td>{{ category.description|slice(0, 50) }}{% if category.description|length > 50 %}...{% endif %}</td>
                        <td>
                            {% if category.enabled %}
                                <span class="badge bg-success">Actief</span>
                            {% else %}
                                <span class="badge bg-secondary">Inactief</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="btn btn-sm btn-outline-primary" title="Bewerken">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form action="{{ path('admin_category_toggle', {id: category.id}) }}" method="post" class="d-inline" data-confirm="Deze categorie {{ category.enabled ? 'deactiveren' : 'activeren' }}?">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ category.id) }}">
                                <button type="submit" class="btn btn-sm {% if category.enabled %}btn-outline-warning{% else %}btn-outline-success{% endif %}" title="{{ category.enabled ? 'Deactiveren' : 'Activeren' }}">
                                    <i class="fas {% if category.enabled %}fa-toggle-on{% else %}fa-toggle-off{% endif %}"></i>
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-danger js-ajax-delete"
                                    data-delete-url="{{ path('admin_category_delete', {id: category.id}) }}"
                                    data-delete-message="Weet je zeker dat je de categorie &quot;{{ category.name }}&quot; wilt verwijderen? Dit kan niet ongedaan worden gemaakt."
                                    data-error-message="Categorie verwijderen mislukt"
                                    data-csrf-token="{{ csrf_token('delete' ~ category.id) }}"
                                    title="Verwijderen">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-muted">Geen categorieën gevonden</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <nav aria-label="Paginering categorieën">
            {{ knp_pagination_render(pagination, '_partials/pagination.html.twig', {}, {label: 'categorieën'}) }}
        </nav>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/ajax-delete.js') }}"></script>
{% endblock %}