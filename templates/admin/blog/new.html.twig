{% extends 'admin/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/trix@2.0.0/dist/trix.css">
{% endblock %}

{% block title %}New Blog Post - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-plus me-2"></i>New Blog Post</h1>
    <a href="{{ path('admin_blog_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                    {# Errors that belong to the whole post, e.g. a duplicate slug #}
                    {% for error in form.vars.errors %}
                        <div class="alert alert-danger">{{ error.message }}</div>
                    {% endfor %}
                    <div class="mb-3">
                        {{ form_label(form.title) }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.introText) }}
                        {{ form_widget(form.introText, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                        {{ form_errors(form.introText) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.content) }}
                        <trix-editor input="{{ form.content.vars.id }}" class="trix-content trix-content-xl form-control"></trix-editor>
                        {{ form_widget(form.content, {'attr': {'class': 'form-control d-none'}}) }}
                        {{ form_errors(form.content) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.categories) }}
                        {{ form_widget(form.categories, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.categories) }}
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Save Draft
                        </button>
                        <button type="submit" name="publish" value="1" class="btn btn-success">
                            <i class="fas fa-globe me-1"></i>Publish Now
                        </button>
                        <a href="{{ path('admin_blog_index') }}" class="btn btn-secondary">Cancel</a>
                    </div>

                    <hr class="my-4">

                    <h5 class="mb-3">Publish Settings</h5>

                    <div class="mb-3">
                        {{ form_label(form.status) }}
                        {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.status) }}
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.dateOnline) }}
                            {{ form_widget(form.dateOnline, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.dateOnline) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.timeOnline) }}
                            {{ form_widget(form.timeOnline, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.timeOnline) }}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.dateOffline) }}
                            {{ form_widget(form.dateOffline, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.dateOffline) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.timeOffline) }}
                            {{ form_widget(form.timeOffline, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.timeOffline) }}
                        </div>
                    </div>

                    {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        {% if post.id %}
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Images</h5>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#imageUploadModal">
                        <i class="fas fa-upload me-1"></i>Upload
                    </button>
                </div>
                <div class="card-body">
                    <div id="imageList" class="row">
                        {% for image in form.images.vars.value %}
                            <div class="col-md-4 mb-3 image-item" data-image-id="{{ image.id }}">
                                <div class="card">
                                    <img src="{{ image.getPublicPath() }}" class="card-img-top" alt="{{ image.name }}">
                                    <div class="card-body p-2">
                                        <input type="hidden" name="blog_post[images][{{ loop.index0 }}][id]" value="{{ image.id }}">
                                        <input type="text" name="blog_post[images][{{ loop.index0 }}][name]" value="{{ image.name }}" class="form-control form-control-sm mb-1" placeholder="Image name">
                                        <input type="text" name="blog_post[images][{{ loop.index0 }}][alt]" value="{{ image.alt }}" class="form-control form-control-sm mb-1" placeholder="Alt text">
                                        <input type="number" name="blog_post[images][{{ loop.index0 }}][sortOrder]" value="{{ image.sortOrder }}" class="form-control form-control-sm mb-1" placeholder="Sort order">
                                        <button type="button" class="btn btn-sm btn-danger w-100 remove-form-image">
                                            <i class="fas fa-trash"></i> Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-muted text-center">No images uploaded yet</p>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Files</h5>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#fileUploadModal">
                        <i class="fas fa-upload me-1"></i>Upload
                    </button>
                </div>
                <div class="card-body">
                    <div id="fileList">
                        {% for file in form.files.vars.value %}
                            <div class="d-flex justify-content-between align-items-center mb-2 file-item" data-file-id="{{ file.id }}">
                                <div>
                                    <i class="fas fa-file me-2"></i>{{ file.name ?? file.filename }}
                                    <small class="text-muted ms-2">{{ file.getHumanReadableSize() }}</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-danger remove-form-file">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        {% else %}
                            <p class="text-muted text-center">No files uploaded yet</p>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">YouTube Videos</h5>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#youtubeModal">
                        <i class="fas fa-plus me-1"></i>Add Video
                    </button>
                </div>
                <div class="card-body">
                    <div id="youtubeList">
                        {% if post.youTubes is defined and post.youTubes|length > 0 %}
                            {% for youtube in post.youTubes %}
                                <div class="d-flex justify-content-between align-items-center mb-2 youtube-item" data-youtube-id="{{ youtube.id }}">
                                    <div>
                                        <img src="{{ youtube.getThumbnailUrl('mqdefault') }}" alt="" class="me-2 thumb-video">
                                        <span>{{ youtube.title }}</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-danger delete-youtube" data-youtube-id="{{ youtube.id }}" data-delete-url="{{ path('admin_blog_youtube_delete', {id: post.id, youtubeId: youtube.id}) }}" data-csrf-token="{{ csrf_token('delete_youtube' ~ youtube.id) }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p class="text-muted text-center">No videos added yet</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Save the blog post first to add images, files, and YouTube videos.
            </div>
        {% endif %}
    </div>
</div>

<!-- Image Upload Modal -->
<div class="modal fade" id="imageUploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="imageUploadForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Image</label>
                        <input type="file" name="image" class="form-control" accept="image/*" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- File Upload Modal -->
<div class="modal fade" id="fileUploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="fileUploadForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select File</label>
                        <input type="file" name="file" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- YouTube Modal -->
    <div class="modal fade" id="youtubeModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add YouTube Video</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="youtubeForm">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Video ID <small class="text-muted">(e.g., dQw4w9WgXcQ)</small></label>
                            <input type="text" name="videoId" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" name="title" class="form-control">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div class="modal fade" id="errorModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Error</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="errorModalMessage"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modules/blog/post-form.js') }}"
            {%- if post.id %}
            data-image-upload-url="{{ path('admin_blog_image_upload', {id: post.id}) }}"
            data-file-upload-url="{{ path('admin_blog_file_upload', {id: post.id}) }}"
            data-youtube-add-url="{{ path('admin_blog_youtube_add', {id: post.id}) }}"{% endif %}></script>
    <script src="https://unpkg.com/trix@2.0.0/dist/trix.umd.min.js"></script>
{% endblock %}