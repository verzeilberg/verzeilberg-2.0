{% extends 'admin/base.html.twig' %}

{% block title %}Reacties - Beheer{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-comments me-2"></i>Reacties</h1>
</div>

<div class="mb-3">
    <div class="btn-group" role="group">
        <a href="{{ path('admin_blog_comments', {status: 'pending'}) }}" class="btn {% if currentStatus == 'pending' %}btn-primary{% else %}btn-outline-primary{% endif %}">
            <i class="fas fa-clock me-1"></i>Wacht op goedkeuring ({{ pendingCount }})
        </a>
        <a href="{{ path('admin_blog_comments', {status: 'approved'}) }}" class="btn {% if currentStatus == 'approved' %}btn-success{% else %}btn-outline-success{% endif %}">
            <i class="fas fa-check me-1"></i>Goedgekeurd
        </a>
        <a href="{{ path('admin_blog_comments') }}" class="btn {% if currentStatus == 'all' %}btn-secondary{% else %}btn-outline-secondary{% endif %}">
            <i class="fas fa-list me-1"></i>Alle
        </a>
    </div>
</div>

{% if pagination.getTotalItemCount() == 0 %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>Geen reacties gevonden.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Bericht</th>
                    <th>Auteur</th>
                    <th>Inhoud</th>
                    <th>Aangemaakt</th>
                    <th>Status</th>
                    <th>Acties</th>
                </tr>
            </thead>
            <tbody>
                {% for comment in pagination %}
                <tr id="comment-{{ comment.id }}">
                    <td>
                        {% if comment.blogPost %}
                            <a href="{{ path('admin_blog_show', {id: comment.blogPost.id}) }}" class="text-decoration-none">
                                {{ comment.blogPost.title|u.truncate(50) }}
                            </a>
                        {% else %}
                            <span class="text-muted">(verwijderd bericht)</span>
                        {% endif %}
                    </td>
                    <td>
                        {{ comment.author ? (comment.author.getFullName() ?? comment.author.getUserIdentifier()) : 'Oud-lid' }}
                    </td>
                    <td class="text-truncate comment-excerpt">{{ comment.content }}</td>
                    <td>{{ comment.dateCreated|nl_date('j M Y H:i') }}</td>
                    <td>
                        {% if comment.isApproved %}
                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Goedgekeurd</span>
                        {% else %}
                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Wacht op goedkeuring</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            {% if not comment.isApproved %}
                                <button type="button" class="btn btn-outline-success approve-comment" data-comment-id="{{ comment.id }}" title="Goedkeuren">
                                    <i class="fas fa-check"></i>
                                </button>
                            {% else %}
                                <button type="button" class="btn btn-outline-warning reject-comment" data-comment-id="{{ comment.id }}" title="Afwijzen">
                                    <i class="fas fa-times"></i>
                                </button>
                            {% endif %}
                            <button type="button" class="btn btn-outline-danger delete-comment" 
                                    data-comment-id="{{ comment.id }}" 
                                    data-csrf-token="{{ csrf_token('delete_comment' ~ comment.id) }}"
                                    title="Verwijderen">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav aria-label="Paginering reacties">
        {{ knp_pagination_render(pagination, '_partials/pagination.html.twig', {}, {label: 'reacties'}) }}
    </nav>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modules/blog/comment-moderation.js') }}"
            data-approve-url="{{ path('admin_blog_comment_approve', {id: '__ID__'}) }}"
            data-reject-url="{{ path('admin_blog_comment_reject', {id: '__ID__'}) }}"
            data-delete-url="{{ path('admin_blog_comment_delete', {id: '__ID__'}) }}"></script>
{% endblock %}