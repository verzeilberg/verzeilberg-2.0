{% extends 'admin/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/trix@2.0.0/dist/trix.css">
{% endblock %}

{% block title %}Blogbericht bewerken - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-edit me-2"></i>Bewerken: {{ post.title }}</h1>
    <div>
        <a href="{{ path('admin_blog_show', {id: post.id}) }}" class="btn btn-outline-primary me-2">
            <i class="fas fa-eye me-1"></i>Bekijken
        </a>
        <a href="{{ path('admin_blog_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Terug
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                    {# Errors that belong to the whole post, e.g. a duplicate slug #}
                    {% for error in form.vars.errors %}
                        <div class="alert alert-danger">{{ error.message }}</div>
                    {% endfor %}
                    <div class="mb-3">
                        {{ form_label(form.title) }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.introText) }}
                        {{ form_widget(form.introText, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                        {{ form_errors(form.introText) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.content) }}
                        <trix-editor input="{{ form.content.vars.id }}" class="trix-content trix-content-xl form-control"></trix-editor>
                        {{ form_widget(form.content, {'attr': {'class': 'form-control d-none'}}) }}
                        {{ form_errors(form.content) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.categories) }}
                        {{ form_widget(form.categories, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.categories) }}
                    </div>

                    <div class="form-actions-bar">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Wijzigingen opslaan
                        </button>
                        <button type="submit" name="publish" value="1" class="btn btn-success">
                            <i class="fas fa-globe me-1"></i>Publiceren
                        </button>
                        <a href="{{ path('admin_blog_index') }}" class="btn btn-secondary">Annuleren</a>
                    </div>

                    <hr class="my-4">

                    <h5 class="mb-3">Publicatie-instellingen</h5>

                    <div class="mb-3">
                        {{ form_label(form.status) }}
                        {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.status) }}
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.dateOnline) }}
                            {{ form_widget(form.dateOnline, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.dateOnline) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.timeOnline) }}
                            {{ form_widget(form.timeOnline, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.timeOnline) }}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.dateOffline) }}
                            {{ form_widget(form.dateOffline, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.dateOffline) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.timeOffline) }}
                            {{ form_widget(form.timeOffline, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.timeOffline) }}
                        </div>
                    </div>

                    {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Publicatie-instellingen (alleen lezen)</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small">Deze instellingen beheer je in het formulier links.</p>
            </div>
        </div>

                <div class="d-grid gap-2">
                    <a href="{{ path('blog_detail', {slug: post.slug}) }}" target="_blank" class="btn btn-outline-primary">
                        <i class="fas fa-external-link me-1"></i>Bekijk op site
                    </a>
                    {% if post.isOnline() %}
                        <button type="button" class="btn btn-outline-warning change-status" data-status-url="{{ path('admin_blog_status', {id: post.id}) }}" data-status="0">
                            <i class="fas fa-pencil me-1"></i>Terug naar concept
                        </button>
                        <button type="button" class="btn btn-outline-warning change-status" data-status-url="{{ path('admin_blog_status', {id: post.id}) }}" data-status="2">
                            <i class="fas fa-pause me-1"></i>Offline halen
                        </button>
                    {% elseif post.status == 0 %}
                        <button type="button" class="btn btn-success change-status" data-status-url="{{ path('admin_blog_status', {id: post.id}) }}" data-status="1">
                            <i class="fas fa-globe me-1"></i>Nu publiceren
                        </button>
                    {% endif %}
                </div>
                {% if previewUrl %}
                    <div class="mt-3">
                        <label for="previewUrl" class="form-label small fw-semibold mb-1">Voorbeeldlink</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="previewUrl" class="form-control" value="{{ previewUrl }}" readonly onclick="this.select()">
                            <button type="button" class="btn btn-outline-secondary js-copy" data-copy="{{ previewUrl }}" title="Link kopiëren"><i class="fas fa-copy"></i></button>
                        </div>
                        <div class="form-text">Iedereen met deze link kan het bericht lezen voordat het online staat, tot {{ previewUntil|date('j-n-Y') }}.</div>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Afbeeldingen</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#imageUploadModal">
                    <i class="fas fa-upload me-1"></i>Uploaden
                </button>
            </div>
            <div class="card-body">
                <div id="imageList" class="row">
                    {% for image in post.images %}
                        <div class="col-md-4 mb-3 image-item" data-image-id="{{ image.id }}">
                            <div class="card">
                                <img src="{{ image.getPublicPath() }}" class="card-img-top" alt="{{ image.name }}">
                                <div class="card-body p-2">
                                    <input type="hidden" name="blog_post[images][{{ loop.index0 }}][id]" value="{{ image.id }}">
                                    <input type="text" name="blog_post[images][{{ loop.index0 }}][name]" value="{{ image.name }}" class="form-control form-control-sm mb-1" placeholder="Naam afbeelding">
                                    <input type="text" name="blog_post[images][{{ loop.index0 }}][alt]" value="{{ image.alt }}" class="form-control form-control-sm mb-1" placeholder="Alt-tekst">
                                    <input type="number" name="blog_post[images][{{ loop.index0 }}][sortOrder]" value="{{ image.sortOrder }}" class="form-control form-control-sm mb-1" placeholder="Volgorde">
                                    <button type="button" class="btn btn-sm btn-danger w-100 delete-image" data-image-id="{{ image.id }}" data-delete-url="{{ path('admin_blog_image_delete', {id: post.id, imageId: image.id}) }}" data-csrf-token="{{ csrf_token('delete_image' ~ image.id) }}">
                                        <i class="fas fa-trash"></i> Verwijderen
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted text-center">Nog geen afbeeldingen geüpload</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Bestanden</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#fileUploadModal">
                    <i class="fas fa-upload me-1"></i>Uploaden
                </button>
            </div>
            <div class="card-body">
                <div id="fileList">
                    {% for file in post.files %}
                        <div class="d-flex justify-content-between align-items-center mb-2 file-item" data-file-id="{{ file.id }}">
                            <div>
                                <i class="fas fa-file me-2"></i>{{ file.name ?? file.filename }}
                                <small class="text-muted ms-2">{{ file.getHumanReadableSize() }}</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-danger delete-file" data-file-id="{{ file.id }}" data-delete-url="{{ path('admin_blog_file_delete', {id: post.id, fileId: file.id}) }}" data-csrf-token="{{ csrf_token('delete_file' ~ file.id) }}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    {% else %}
                        <p class="text-muted text-center">Nog geen bestanden geüpload</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">YouTube-video's</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#youtubeModal">
                    <i class="fas fa-plus me-1"></i>Video toevoegen
                </button>
            </div>
            <div class="card-body">
                <div id="youtubeList">
                    {% for youtube in post.youTubes %}
                        <div class="d-flex justify-content-between align-items-center mb-2 youtube-item" data-youtube-id="{{ youtube.id }}">
                            <div>
                                <img src="{{ youtube.getThumbnailUrl('mqdefault') }}" alt="" class="me-2 thumb-video">
                                <span>{{ youtube.title }}</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-danger delete-youtube" data-youtube-id="{{ youtube.id }}" data-delete-url="{{ path('admin_blog_youtube_delete', {id: post.id, youtubeId: youtube.id}) }}" data-csrf-token="{{ csrf_token('delete_youtube' ~ youtube.id) }}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    {% else %}
                        <p class="text-muted text-center">Nog geen video's toegevoegd</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Upload Modal -->
<div class="modal fade" id="imageUploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Afbeelding uploaden</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="imageUploadForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Kies afbeelding</label>
                        <input type="file" name="image" class="form-control" accept="image/*" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-primary">Uploaden</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- File Upload Modal -->
<div class="modal fade" id="fileUploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bestand uploaden</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="fileUploadForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Kies bestand</label>
                        <input type="file" name="file" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-primary">Uploaden</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- YouTube Modal -->
        <div class="modal fade" id="youtubeModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">YouTube-video toevoegen</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="youtubeForm">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Video ID <small class="text-muted">(bijv. dQw4w9WgXcQ)</small></label>
                                <input type="text" name="videoId" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Titel</label>
                                <input type="text" name="title" class="form-control">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                            <button type="submit" class="btn btn-primary">Toevoegen</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Delete Image Confirmation Modal -->
        <div class="modal fade" id="deleteImageModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Verwijderen bevestigen</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Weet je zeker dat je deze afbeelding wilt verwijderen? Dit kan niet ongedaan worden gemaakt.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                        <button type="button" class="btn btn-danger" id="confirmDeleteImage">
                            <i class="fas fa-trash me-1"></i>Verwijderen
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete File Confirmation Modal -->
        <div class="modal fade" id="deleteFileModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Verwijderen bevestigen</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Weet je zeker dat je dit bestand wilt verwijderen? Dit kan niet ongedaan worden gemaakt.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                        <button type="button" class="btn btn-danger" id="confirmDeleteFile">
                            <i class="fas fa-trash me-1"></i>Verwijderen
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete YouTube Confirmation Modal -->
        <div class="modal fade" id="deleteYoutubeModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Verwijderen bevestigen</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Weet je zeker dat je deze YouTube-video wilt verwijderen? Dit kan niet ongedaan worden gemaakt.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                        <button type="button" class="btn btn-danger" id="confirmDeleteYoutube">
                            <i class="fas fa-trash me-1"></i>Verwijderen
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/components/copy-button.js') }}"></script>
    <script src="{{ asset('js/modules/blog/post-form.js') }}"
            {%- if post.id %}
            data-image-upload-url="{{ path('admin_blog_image_upload', {id: post.id}) }}"
            data-file-upload-url="{{ path('admin_blog_file_upload', {id: post.id}) }}"
            data-youtube-add-url="{{ path('admin_blog_youtube_add', {id: post.id}) }}"{% endif %}></script>
    <script src="https://unpkg.com/trix@2.0.0/dist/trix.umd.min.js"></script>
{% endblock %}