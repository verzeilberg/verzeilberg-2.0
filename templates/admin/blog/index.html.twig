{% extends 'admin/base.html.twig' %}

{% block title %}Blogbeheer - Beheer{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-rss me-2"></i>Blogberichten</h1>
    <a href="{{ path('admin_blog_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Nieuw bericht
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="all" {% if currentStatus == 'all' %}selected{% endif %}>Alle statussen</option>
                    <option value="draft" {% if currentStatus == 'draft' %}selected{% endif %}>Concept</option>
                    <option value="online" {% if currentStatus == 'online' %}selected{% endif %}>Online</option>
                    <option value="offline" {% if currentStatus == 'offline' %}selected{% endif %}>Offline</option>
                    <option value="archived" {% if currentStatus == 'archived' %}selected{% endif %}>Gearchiveerd</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Categorie</label>
                <select name="category" class="form-select">
                    <option value="">Alle categorieën</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {% if currentCategory == category.id %}selected{% endif %}>
                            {{ category.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
                <a href="{{ path('admin_blog_index') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-1"></i>Wissen
                </a>
            </div>
        </form>
    </div>
</div>

{% if pagination.getTotalItemCount() == 0 %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>Geen blogberichten gevonden.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Titel</th>
                    <th>Categorieën</th>
                    <th>Status</th>
                    <th>Aangemaakt</th>
                    <th>Afbeeldingen</th>
                    <th>Acties</th>
                </tr>
            </thead>
            <tbody>
                {% for post in pagination %}
                <tr>
                    <td>
                        <strong>{{ post.title|u.truncate(50) }}</strong>
                        <br><small class="text-muted">Slug: {{ post.slug }}</small>
                    </td>
                    <td>
                        {% for category in post.categories %}
                            <span class="badge bg-info text-dark me-1">{{ category.name }}</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endfor %}
                    </td>
                    <td>
                        <span class="badge bg-{% if post.status == 1 %}success{% elseif post.status == 2 %}warning{% elseif post.status == 3 %}danger{% else %}secondary{% endif %} status-badge" data-post-id="{{ post.id }}" data-status="{{ post.status }}">
                            {% if post.status == 1 %}Online
                            {% elseif post.status == 2 %}Offline
                            {% elseif post.status == 3 %}Gearchiveerd
                            {% else %}Concept{% endif %}
                        </span>
                    </td>
                    <td>{{ post.dateCreated|nl_date('j M Y H:i') }}</td>
                    <td>
                        <span class="badge bg-secondary">{{ post.images|length }}</span>
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a href="{{ path('admin_blog_show', {id: post.id}) }}" class="btn btn-outline-primary" title="Bekijken">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('admin_blog_edit', {id: post.id}) }}" class="btn btn-outline-secondary" title="Bewerken">
                                <i class="fas fa-edit"></i>
                            </a>
                        </div>
                        <div class="btn-group btn-group-sm ms-1">
                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-container="body" title="Meer acties">
                                <i class="fas fa-cog"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-over-table">
                                    <li>
                                        <a class="dropdown-item change-status" href="#" data-post-id="{{ post.id }}" data-status-url="{{ path('admin_blog_status', {id: post.id}) }}" data-status="0">
                                            <i class="fas fa-pencil me-2"></i>Terug naar concept
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item change-status" href="#" data-post-id="{{ post.id }}" data-status-url="{{ path('admin_blog_status', {id: post.id}) }}" data-status="1">
                                            <i class="fas fa-globe me-2"></i>Publiceren
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item change-status" href="#" data-post-id="{{ post.id }}" data-status-url="{{ path('admin_blog_status', {id: post.id}) }}" data-status="2">
                                            <i class="fas fa-pause me-2"></i>Offline halen
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item change-status" href="#" data-post-id="{{ post.id }}" data-status-url="{{ path('admin_blog_status', {id: post.id}) }}" data-status="3">
                                            <i class="fas fa-archive me-2"></i>Archiveren
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button type="button" class="dropdown-item text-danger delete-post" data-post-id="{{ post.id }}" data-delete-url="{{ path('admin_blog_delete', {id: post.id}) }}" data-csrf-token="{{ csrf_token('delete' ~ post.id) }}">
                                            <i class="fas fa-trash me-2"></i>Verwijderen
                                        </button>
                                    </li>
                                </ul>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav aria-label="Paginering blogberichten">
        {{ knp_pagination_render(pagination, '_partials/pagination.html.twig', {}, {label: 'berichten'}) }}
    </nav>
{% endif %}

<!-- Delete Post Confirmation Modal -->
<div class="modal fade" id="deletePostModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Verwijderen bevestigen</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Weet je zeker dat je dit blogbericht wilt verwijderen? Dit kan niet ongedaan worden gemaakt.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" class="btn btn-danger" id="confirmDeletePost">
                    <i class="fas fa-trash me-1"></i>Verwijderen
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modules/blog/index.js') }}"></script>
{% endblock %}
