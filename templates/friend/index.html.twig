{% extends 'base.html.twig' %}

{% block title %}Vrienden - Verzeilberg.nl{% endblock %}

{% block page_title %}Vrienden{% endblock %}
{% block page_lead %}Vrienden kunnen elkaars pagina zien, ook als die privé is.{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_users') }}" class="btn btn-outline-primary"><i class="fas fa-users me-2"></i>Mensen zoeken</a>
{% endblock %}

{% block body %}
{% if incoming %}
    <section class="card mb-4">
        <div class="card-header"><h2>Vriendschapsverzoeken <span class="badge text-bg-danger align-middle">{{ incoming|length }}</span></h2></div>
        <ul class="list-group list-group-flush">
            {% for friendship in incoming %}
                {% set other = friendship.requester %}
                {% set actions %}
                    {{ include('friend/_button.html.twig', {route: 'app_friend_accept', label: 'Accepteren', icon: 'check', style: 'btn-primary'}) }}
                    {{ include('friend/_button.html.twig', {route: 'app_friend_remove', label: 'Weigeren', icon: 'times'}) }}
                {% endset %}
                {{ include('friend/_user_row.html.twig') }}
            {% endfor %}
        </ul>
    </section>
{% endif %}

<section class="card mb-4">
    <div class="card-header"><h2>Mijn vrienden</h2></div>
    {% if friends is empty %}
        <div class="card-body">
            <p class="text-muted mb-0">Je hebt hier nog geen vrienden. Open iemands pagina in het <a href="{{ path('app_users') }}">gebruikersoverzicht</a> en klik op <strong>Vriend toevoegen</strong>.</p>
        </div>
    {% else %}
        <ul class="list-group list-group-flush">
            {% for other in friends %}
                {% set friendship = {accepted: true} %}
                {% set actions %}
                    {{ include('friend/_button.html.twig', {route: 'app_friend_remove', label: 'Ontvrienden', icon: 'user-minus', confirm: other.fullName ~ ' verwijderen als vriend?'}) }}
                {% endset %}
                {{ include('friend/_user_row.html.twig') }}
            {% endfor %}
        </ul>
    {% endif %}
</section>

{% if outgoing %}
    <section class="card">
        <div class="card-header"><h2>Verstuurde verzoeken</h2></div>
        <ul class="list-group list-group-flush">
            {% for friendship in outgoing %}
                {% set other = friendship.addressee %}
                {% set actions %}
                    {{ include('friend/_button.html.twig', {route: 'app_friend_remove', label: 'Verzoek intrekken', icon: 'times'}) }}
                {% endset %}
                {{ include('friend/_user_row.html.twig') }}
            {% endfor %}
        </ul>
    </section>
{% endif %}
{% endblock %}
