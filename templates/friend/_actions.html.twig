{# The friend buttons on a user's page, by the state between the viewer and `other`: pass `friendship` (or null) #}
{% if friendship is null %}
    {{ include('friend/_button.html.twig', {route: 'app_friend_add', label: 'Vriend toevoegen', icon: 'user-plus', style: 'btn-primary'}) }}
{% elseif friendship.accepted %}
    <span class="badge text-bg-success align-middle me-1"><i class="fas fa-user-check me-1"></i>Vrienden</span>
    {{ include('friend/_button.html.twig', {route: 'app_friend_remove', label: 'Ontvrienden', icon: 'user-minus', confirm: other.fullName ~ ' verwijderen als vriend?'}) }}
{% elseif friendship.requester == app.user %}
    <span class="text-muted small me-1">Vriendschapsverzoek verstuurd</span>
    {{ include('friend/_button.html.twig', {route: 'app_friend_remove', label: 'Verzoek intrekken', icon: 'times'}) }}
{% else %}
    <span class="text-muted small me-1">Wil je vriend worden</span>
    {{ include('friend/_button.html.twig', {route: 'app_friend_accept', label: 'Accepteren', icon: 'check', style: 'btn-primary'}) }}
    {{ include('friend/_button.html.twig', {route: 'app_friend_remove', label: 'Weigeren', icon: 'times'}) }}
{% endif %}
