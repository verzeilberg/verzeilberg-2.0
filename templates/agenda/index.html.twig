{% extends 'base.html.twig' %}

{% block title %}Agenda - Verzeilberg.nl{% endblock %}

{% block page_title %}Agenda{% endblock %}
{% block page_lead %}Wat er gepland staat, per maand, week of dag.{% endblock %}

{% block body %}
{% if agendas is empty %}
    <div class="empty-state">
        <i class="fas fa-calendar-alt"></i>
        <p>Er staat nog niets in de agenda. Kijk later nog eens.</p>
    </div>
{% else %}
    <div class="card section">
        <div class="card-body">
            {% include 'agenda/_calendar.html.twig' with {routeName: 'app_agenda', editable: false} %}
        </div>
    </div>

    {# Subscribe in a calendar app #}
    <section class="section">
        <h2 class="section-title">Abonneren in je agenda-app</h2>
        <ul class="list-inline mb-0">
            {% for agenda in agendas %}
                <li class="list-inline-item">
                    <a href="{{ url('app_agenda_feed', {token: agenda.feedToken})|replace({'https://': 'webcal://', 'http://': 'webcal://'}) }}" class="btn btn-outline-primary mb-2">
                        <span class="color-dot color-dot-sm me-2" style="--dot-color: {{ agenda.color }};"></span>Abonneren op {{ agenda.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modules/agenda/calendar.js') }}"></script>
{% endblock %}
