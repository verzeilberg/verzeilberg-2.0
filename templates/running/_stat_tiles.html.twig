{# The year's running totals as four tiles; used on /running and on the home page. Needs: totals (RunningStats::year), year #}
<div class="row g-3">
    {% for label, value in {
        'Kilometers': totals.km|number_format(0, ',', '.'),
        'Loopjes': totals.runs,
        'Uren': (totals.seconds / 3600)|round|number_format(0, ',', '.'),
        'Wedstrijden': totals.races,
    } %}
        <div class="col-6 col-md-3">
            <div class="stat-tile">
                <div class="stat-tile-value">{{ value }}</div>
                <div class="stat-tile-label">{{ label }} in {{ year }}</div>
            </div>
        </div>
    {% endfor %}
</div>
