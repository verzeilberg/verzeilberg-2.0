<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nieuwe reactie</title>
</head>
<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 600px; margin: 0 auto; background-color: #ffffff;">
        <!-- Header -->
        <tr>
            <td style="padding: 30px 20px; background-color: #dc3545; text-align: center;">
                <h1 style="margin: 0; color: #ffffff; font-size: 28px;">Nieuwe reactie</h1>
            </td>
        </tr>

        <!-- Content -->
        <tr>
            <td style="padding: 30px 20px;">
                <p style="margin: 0 0 20px; font-size: 16px; color: #333333;">
                    {% if comment.approved %}
                        Er is een reactie geplaatst op <strong>{{ comment.blogPost.title }}</strong>.
                    {% else %}
                        Er is een reactie geplaatst op <strong>{{ comment.blogPost.title }}</strong>. Die is pas zichtbaar als je hem goedkeurt.
                    {% endif %}
                </p>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom: 20px;">
                    <tr>
                        <td style="padding: 10px 0; font-weight: bold; color: #333333; width: 100px;">Van:</td>
                        <td style="padding: 10px 0; color: #333333;">{{ comment.author ? comment.author.fullName : 'Onbekend' }}</td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 0; font-weight: bold; color: #333333;">Datum:</td>
                        <td style="padding: 10px 0; color: #333333;">{{ comment.dateCreated|date('d-m-Y H:i') }}</td>
                    </tr>
                </table>

                <p style="margin: 0 0 10px; font-weight: bold; color: #333333;">Reactie:</p>
                <div style="background-color: #f8f9fa; padding: 15px; border-radius: 4px; color: #333333; white-space: pre-wrap;">{{ comment.content }}</div>

                <p style="margin: 30px 0 0;">
                    <a href="{{ url('admin_blog_comments', comment.approved ? {} : {status: 'pending'}) }}" style="display: inline-block; background-color: #0d6efd; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: bold;">
                        {{ comment.approved ? 'Bekijk in admin paneel' : 'Goedkeuren in admin paneel' }}
                    </a>
                    <a href="{{ url('blog_detail', {slug: comment.blogPost.slug}) }}#comment-{{ comment.id }}" style="display: inline-block; margin-left: 10px; color: #0d6efd; padding: 12px 0;">Bekijk bericht</a>
                </p>
            </td>
        </tr>

        <!-- Footer -->
        <tr>
            <td style="padding: 20px; background-color: #f8f9fa; text-align: center; border-top: 1px solid #dee2e6;">
                <p style="margin: 0; font-size: 12px; color: #999999;">
                    Verzeilberg - Reactie notificatie
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
