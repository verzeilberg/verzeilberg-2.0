<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nieuw contactformulier</title>
</head>
<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 600px; margin: 0 auto; background-color: #ffffff;">
        <!-- Header -->
        <tr>
            <td style="padding: 30px 20px; background-color: #dc3545; text-align: center;">
                <h1 style="margin: 0; color: #ffffff; font-size: 28px;">Nieuw Contactformulier</h1>
            </td>
        </tr>
        
        <!-- Content -->
        <tr>
            <td style="padding: 30px 20px;">
                <p style="margin: 0 0 20px; font-size: 16px; color: #333333;">
                    Er is een nieuw contactformulier ingevuld op de website.
                </p>
                
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom: 20px;">
                    <tr>
                        <td style="padding: 10px 0; font-weight: bold; color: #333333; width: 100px;">Aanhef:</td>
                        <td style="padding: 10px 0; color: #333333;">{{ contact.salutationLabel }}</td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 0; font-weight: bold; color: #333333;">Naam:</td>
                        <td style="padding: 10px 0; color: #333333;">{{ contact.name }}</td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 0; font-weight: bold; color: #333333;">E-mail:</td>
                        <td style="padding: 10px 0; color: #333333;"><a href="mailto:{{ contact.email }}" style="color: #0d6efd;">{{ contact.email }}</a></td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 0; font-weight: bold; color: #333333;">Onderwerp:</td>
                        <td style="padding: 10px 0; color: #333333;">{{ contact.subject }}</td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 0; font-weight: bold; color: #333333; vertical-align: top;">Datum:</td>
                        <td style="padding: 10px 0; color: #333333;">{{ contact.dateCreated|date('d-m-Y H:i') }}</td>
                    </tr>
                </table>
                
                <p style="margin: 0 0 10px; font-weight: bold; color: #333333;">Bericht:</p>
                <div style="background-color: #f8f9fa; padding: 15px; border-radius: 4px; color: #333333; white-space: pre-wrap;">{{ contact.message }}</div>
                
                <p style="margin: 30px 0 0;">
                    <a href="{{ url('admin_contact_index') }}" style="display: inline-block; background-color: #0d6efd; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: bold;">
                        Bekijk in admin paneel
                    </a>
                </p>
            </td>
        </tr>
        
        <!-- Footer -->
        <tr>
            <td style="padding: 20px; background-color: #f8f9fa; text-align: center; border-top: 1px solid #dee2e6;">
                <p style="margin: 0; font-size: 12px; color: #999999;">
                    Verzeilberg - Contactformulier notificatie
                </p>
            </td>
        </tr>
    </table>
</body>
</html>