<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contactbevestiging</title>
</head>
<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 600px; margin: 0 auto; background-color: #ffffff;">
        <!-- Header -->
        <tr>
            <td style="padding: 30px 20px; background-color: #0d6efd; text-align: center;">
                <h1 style="margin: 0; color: #ffffff; font-size: 28px;">Verzeilberg</h1>
            </td>
        </tr>
        
        <!-- Content -->
        <tr>
            <td style="padding: 30px 20px;">
                <p style="margin: 0 0 20px; font-size: 16px; color: #333333;">
                    Beste {{ contact.salutationLabel }} <strong>{{ contact.name }}</strong>,
                </p>
                
                <p style="margin: 0 0 20px; font-size: 16px; color: #333333;">
                    Wij hebben uw contactformulier in goede orde ontvangen!
                </p>
                
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom: 20px;">
                    <tr>
                        <td style="padding: 10px 0; font-weight: bold; color: #333333; width: 100px;">Onderwerp:</td>
                        <td style="padding: 10px 0; color: #333333;">{{ contact.subject }}</td>
                    </tr>
                </table>
                
                <p style="margin: 0 0 10px; font-weight: bold; color: #333333;">Bericht:</p>
                <div style="background-color: #f8f9fa; padding: 15px; border-radius: 4px; color: #333333; white-space: pre-wrap;">{{ contact.message }}</div>
                
                <p style="margin: 30px 0 0; font-size: 14px; color: #666666;">
                    Mocht u toch nog vragen hebben, neem dan contact op met ons: 
                    <a href="mailto:sander@verzeilberg.nl" style="color: #0d6efd;">sander@verzeilberg.nl</a>
                </p>
                
                <p style="margin: 20px 0 0; font-size: 16px; color: #333333;">
                    Met vriendelijke groet,<br>
                    <strong>Verzeilberg</strong>
                </p>
            </td>
        </tr>
        
        <!-- Footer -->
        <tr>
            <td style="padding: 20px; background-color: #f8f9fa; text-align: center; border-top: 1px solid #dee2e6;">
                <p style="margin: 0; font-size: 12px; color: #999999;">
                    Dit is een geautomatiseerd bericht. Gelieve niet te antwoorden op deze e-mail.
                </p>
            </td>
        </tr>
    </table>
</body>
</html>