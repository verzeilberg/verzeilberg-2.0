{% extends 'base.html.twig' %}

{% block title %}Events - Verzeilberg.nl{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8 mx-auto">
        <h1 class="mb-4"><i class="fas fa-calendar-alt me-2"></i>Events</h1>

        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            De eventsmodule wordt overgezet vanuit de oude Laminas-applicatie.
            Kijk binnenkort nog eens voor de volledige eventkalender met categorieën, kaarten en Strava-koppeling.
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Geplande functies</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Eventcategorieën (wedstrijden, toertochten, sociaal, training)</li>
                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Interactieve kaart met eventlocaties</li>
                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Filteren op jaar en categorie</li>
                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Eventdetails met afbeeldingen</li>
                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Koppeling met Strava-activiteiten</li>
                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Beheeromgeving</li>
                    <li class="mb-2"><i class="fas fa-clock text-warning me-2"></i> Synchronisatie met Google Agenda (wordt onderzocht)</li>
                </ul>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Komende events (voorbeeld)</h5>
            </div>
            <div class="card-body">
                <div class="list-group">
                    <div class="list-group-item">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">Zuidwest Fryske Sail 2024</h5>
                            <small class="text-muted">15-16 juni 2024</small>
                        </div>
                        <p class="mb-1">Jaarlijks zeilevenement in Zuidwest-Friesland</p>
                        <small><span class="badge bg-primary">Wedstrijd</span> <span class="badge bg-info">Sneek</span></small>
                    </div>
                    <div class="list-group-item">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">Sailing Tech Meetup</h5>
                            <small class="text-muted">20 juli 2024</small>
                        </div>
                        <p class="mb-1">Gesprek over navigatie-apps, weerrouting en techniek aan boord</p>
                        <small><span class="badge bg-success">Sociaal</span> <span class="badge bg-info">Amsterdam</span></small>
                    </div>
                    <div class="list-group-item">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">Round Texel Race</h5>
                            <small class="text-muted">10 augustus 2024</small>
                        </div>
                        <p class="mb-1">De beroemde race rond Texel</p>
                        <small><span class="badge bg-danger">Wedstrijd</span> <span class="badge bg-info">Texel</span></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}