{% extends 'base.html.twig' %}

{# No page header on the home page #}
{% block page_header %}{% endblock %}

{% block body %}

{% if featuredPost %}
<section class="section">
    <h2 class="section-title">Nieuwste berichten <a href="{{ path('blog_index') }}">Alle berichten</a></h2>

    <article class="feature-card card-link-cover mb-4">
        <a href="{{ path('blog_detail', {slug: featuredPost.slug}) }}" tabindex="-1" aria-hidden="true">
            {% if featuredPost.images|length > 0 %}
                {{ include('blog/_list_image.html.twig', {image: featuredPost.images.first(), class: 'feature-card-image', alt: featuredPost.images.first().alt ?? featuredPost.title}) }}
            {% else %}
                <div class="feature-card-image card-img-placeholder"><i class="fas fa-anchor"></i></div>
            {% endif %}
        </a>
        <div class="feature-card-body">
            <div class="card-meta">
                <span><i class="fas fa-calendar-day"></i>{{ (featuredPost.dateOnline ?? featuredPost.dateCreated)|nl_date('j F Y') }}</span>
            </div>
            <h3 class="card-title"><a href="{{ path('blog_detail', {slug: featuredPost.slug}) }}">{{ featuredPost.title }}</a></h3>
            <p class="mb-0">{{ featuredPost.introText|names(featuredPost)|striptags|u.truncate(220, '…') }}</p>
            <div class="mt-auto pt-2">
                <a href="{{ path('blog_detail', {slug: featuredPost.slug}) }}" class="btn btn-primary">Lees het bericht</a>
            </div>
        </div>
    </article>

    {% if otherPosts %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for post in otherPosts %}
                {{ include('blog/_card.html.twig') }}
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endif %}

{% if upcomingEvent %}
<section class="section">
    <h2 class="section-title">Volgend event <a href="{{ path('app_events') }}">Alle events</a></h2>
    <div class="event-countdown">
        {% if upcomingEvent.eventImage %}
            <a href="{{ path('app_event_show', {slug: upcomingEvent.slug}) }}" tabindex="-1" aria-hidden="true">
                <img src="{{ upcomingEvent.eventImage.getPublicPath() }}" class="event-countdown-image" alt="">
            </a>
        {% endif %}
        <div class="event-countdown-body">
            {% set targetDate = upcomingEvent.eventStartDate|date('Y-m-d') %}
            {% if upcomingEvent.eventStartTime %}
                {% set targetDate = targetDate ~ 'T' ~ upcomingEvent.eventStartTime|date('H:i') %}
            {% else %}
                {% set targetDate = targetDate ~ 'T00:00' %}
            {% endif %}
            <div id="flipClock" class="flip-clock mb-3" data-target="{{ targetDate }}"></div>

            <h3 class="h2 mb-2">{{ upcomingEvent.title }}</h3>
            <div class="card-meta justify-content-center mb-4">
                <span>
                    <i class="fas fa-calendar-day"></i>{{ upcomingEvent.eventStartDate|nl_date('l j F Y') }}
                    {% if upcomingEvent.eventEndDate != upcomingEvent.eventStartDate %}
                        t/m {{ upcomingEvent.eventEndDate|nl_date('l j F Y') }}
                    {% endif %}
                </span>
                {% if upcomingEvent.eventStartTime or upcomingEvent.eventEndTime %}
                    <span><i class="fas fa-clock"></i>{{ upcomingEvent.eventStartTime ? upcomingEvent.eventStartTime|date('H:i') : '00:00' }}–{{ upcomingEvent.eventEndTime ? upcomingEvent.eventEndTime|date('H:i') : '23:59' }}</span>
                {% endif %}
            </div>
            <a href="{{ path('app_event_show', {slug: upcomingEvent.slug}) }}" class="btn btn-primary">Bekijk event</a>
        </div>
    </div>
</section>
{% endif %}

{% if runningTotals %}
<section class="section home-running">
    <h2 class="section-title">Hardlopen in {{ runningYear }} <a href="{{ path('app_running') }}">Alle statistieken</a></h2>
    {{ include('running/_stat_tiles.html.twig', {totals: runningTotals, year: runningYear, illustrated: true}) }}

    {% set months = ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'] %}
    <div class="row g-4 mt-0">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><h3>Kilometers per maand, {{ runningYear }}</h3></div>
                <div class="card-body">
                    <div class="chart-container"><canvas id="homeMonthChart" role="img" aria-label="Staafdiagram van de gelopen kilometers per maand in {{ runningYear }}"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><h3>Opgeteld{% if runningPrevious %}: {{ runningYear }} tegen {{ runningYear - 1 }}{% else %} in {{ runningYear }}{% endif %}</h3></div>
                <div class="card-body">
                    <div class="chart-container"><canvas id="homeCumulativeChart" role="img" aria-label="Lijndiagram van de opgetelde kilometers per maand in {{ runningYear }}{% if runningPrevious %}, vergeleken met {{ runningYear - 1 }}{% endif %}"></canvas></div>
                </div>
            </div>
        </div>
    </div>
    <details class="mt-2">
        <summary class="small text-muted">Toon de grafieken als tabel</summary>
        <div class="table-responsive">
            <table class="table table-sm mt-2 mb-0">
                <thead>
                    <tr>
                        <th>Maand</th>
                        <th class="text-end">km {{ runningYear }}</th>
                        <th class="text-end">Opgeteld {{ runningYear }}</th>
                        {% if runningPrevious %}<th class="text-end">Opgeteld {{ runningYear - 1 }}</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% set sum = 0 %}{% set previousSum = 0 %}
                    {% for km in runningTotals.kmPerMonth %}
                        {% set sum = sum + km %}
                        {% if runningPrevious %}{% set previousSum = previousSum + runningPrevious.kmPerMonth[loop.index0] %}{% endif %}
                        <tr>
                            <td>{{ months[loop.index0] }}</td>
                            <td class="text-end">{{ loop.index <= runningMonths ? km|number_format(1, ',', '.') : '–' }}</td>
                            <td class="text-end">{{ loop.index <= runningMonths ? sum|number_format(1, ',', '.') : '–' }}</td>
                            {% if runningPrevious %}<td class="text-end">{{ previousSum|number_format(1, ',', '.') }}</td>{% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </details>
</section>
{% endif %}

{% if recentGames %}
<section class="section">
    <h2 class="section-title">Recent gespeeld <a href="{{ path('app_games') }}">Gamebibliotheek</a></h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        {% for game in recentGames %}
            <div class="col">
                {{ include('games/_card.html.twig', {game: game, showRecent: true}) }}
            </div>
        {% endfor %}
    </div>
</section>
{% endif %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modules/home/flip-clock.js') }}"></script>
    {% if runningTotals %}
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
        <script src="{{ asset('js/modules/home/running-charts.js') }}"
                data-months="{{ ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec']|json_encode|e('html_attr') }}"
                data-year="{{ runningYear }}"
                data-month-km="{{ runningTotals.kmPerMonth|json_encode|e('html_attr') }}"
                data-shown-months="{{ runningMonths }}"
                {% if runningPrevious %}data-previous-month-km="{{ runningPrevious.kmPerMonth|json_encode|e('html_attr') }}"{% endif %}></script>
    {% endif %}
{% endblock %}
