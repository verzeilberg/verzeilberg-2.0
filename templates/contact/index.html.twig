{% extends 'base.html.twig' %}

{% block title %}Contact - Verzeilberg{% endblock %}

{% block page_title %}Contact{% endblock %}
{% block page_lead %}Vragen, opmerkingen of een afspraak maken? Vul het formulier in, dan neem ik zo snel mogelijk contact met je op.{% endblock %}

{% block body %}
<div class="form-page-wide">
    <div class="card">
        <div class="card-body article-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'contact_form'}}) }}
                <div class="mb-3">
                    {# One row of radio buttons: each option as its own Bootstrap form-check #}
                    <fieldset>
                        <legend class="form-label fs-6 mb-1">{{ form.salutation.vars.label }}</legend>
                        <div class="d-flex flex-wrap gap-3">
                            {% for choice in form.salutation %}
                                <div class="form-check form-check-inline mb-0">
                                    {{ form_widget(choice, {attr: {class: 'form-check-input' ~ (form.salutation.vars.valid ? '' : ' is-invalid')}}) }}
                                    {{ form_label(choice, null, {label_attr: {class: 'form-check-label'}}) }}
                                </div>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.salutation) }}
                    </fieldset>
                </div>

                <div class="mb-3">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.subject) }}
                    {{ form_widget(form.subject) }}
                    {{ form_errors(form.subject) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.message) }}
                    {{ form_widget(form.message) }}
                    {{ form_errors(form.message) }}
                </div>

                <div class="d-grid">
                    {{ form_widget(form.submit, {label: 'Bericht versturen', attr: {class: 'btn btn-primary'}}) }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <p class="text-center text-muted mt-3 mb-1">Of neem direct contact op via:</p>
    <p class="text-center mb-0">
        <a href="mailto:info@verzeilberg.nl"><i class="fas fa-envelope me-2"></i>info@verzeilberg.nl</a>
    </p>
</div>
{% endblock %}
