{% extends 'base.html.twig' %}

{% block title %}Events - Verzeilberg.nl{% endblock %}

{% block page_title %}Events{% endblock %}
{% block page_lead %}Wedstrijden, reizen en meetups: wat eraan komt en wat al geweest is.{% endblock %}

{% block page_actions %}
    {# webcal:// opens the "subscribe" dialog of the calendar app; the feed itself is plain https #}
    <a href="{{ url('app_events_feed')|replace({'https://': 'webcal://', 'http://': 'webcal://'}) }}" class="btn btn-outline-primary" title="Abonneer je in de agenda van Google, Apple of Outlook: nieuwe events verschijnen vanzelf"><i class="fas fa-calendar-alt me-2"></i>Abonneren</a>
{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-3">
        <aside class="filter-panel">
            <div class="filter-group">
                <h2 class="filter-heading">Wanneer</h2>
                <ul class="filter-list">
                    {% for status, label in {upcoming: 'Komend', ongoing: 'Nu bezig', past: 'Afgelopen'} %}
                        <li><a href="{{ path('app_events', {status: status, category: currentCategory}) }}" {{ currentStatus == status ? 'aria-current="page"' }}>{{ label }}</a></li>
                    {% endfor %}
                </ul>
            </div>

            {% if categories %}
                <div class="filter-group">
                    <h2 class="filter-heading">Categorie</h2>
                    <ul class="filter-list">
                        <li>
                            <a href="{{ path('app_events', {status: currentStatus}) }}" {{ not currentCategory ? 'aria-current="page"' }}>
                                <span>Alle categorieën</span>
                                <span class="filter-count">{{ totalCount }}</span>
                            </a>
                        </li>
                        {% for category in categories %}
                            <li>
                                <a href="{{ path('app_events', {status: currentStatus, category: category.id}) }}" {{ currentCategory == category.id ? 'aria-current="page"' }}>
                                    <span>{{ category.name }}</span>
                                    <span class="filter-count">{{ categoryCounts[category.id] ?? 0 }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </aside>
    </div>

    <div class="col-lg-9">
        {% if pagination.getTotalItemCount() == 0 %}
            <div class="empty-state">
                <i class="fas fa-calendar-alt"></i>
                <p>Hier staan geen events. Probeer een andere periode of categorie.</p>
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                {% for event in pagination %}
                    <div class="col">
                        <article class="card h-100 card-link-cover">
                            <a href="{{ path('app_event_show', {slug: event.slug}) }}" tabindex="-1" aria-hidden="true">
                                {% if event.eventImage %}
                                    <img src="{{ event.eventImage.getPublicPath() }}" class="card-img-top" alt="" loading="lazy">
                                {% else %}
                                    <div class="card-img-top card-img-placeholder"><i class="fas fa-calendar-alt"></i></div>
                                {% endif %}
                            </a>
                            <div class="card-body d-flex flex-column">
                                {% if event.category %}
                                    <div class="mb-2"><span class="tag">{{ event.category.name }}</span></div>
                                {% endif %}
                                <h3 class="card-title"><a href="{{ path('app_event_show', {slug: event.slug}) }}">{{ event.title }}</a></h3>
                                {% if event.labelText %}
                                    <p class="card-text text-muted">{{ event.labelText|striptags|u.truncate(100, '…') }}</p>
                                {% endif %}
                                <div class="card-meta mt-auto">
                                    <span><i class="fas fa-calendar-day"></i>{{ event.eventStartDate|nl_date('j M Y') }}{% if event.eventEndDate != event.eventStartDate %} – {{ event.eventEndDate|nl_date('j M Y') }}{% endif %}</span>
                                    {% if event.eventStartTime or event.eventEndTime %}
                                        <span><i class="fas fa-clock"></i>{{ event.eventStartTime ? event.eventStartTime|date('H:i') : '00:00' }}–{{ event.eventEndTime ? event.eventEndTime|date('H:i') : '23:59' }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>

            <nav aria-label="Eventpagina's">
                {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
            </nav>
        {% endif %}
    </div>
</div>
{% endblock %}
