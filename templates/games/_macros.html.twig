{# 754 → "12.6 hrs", 30 → "30 min" #}
{% macro playtime(minutes) %}
    {%- if minutes < 60 %}{{ minutes }} min
    {%- else %}{{ (minutes / 60)|number_format(minutes < 6000 ? 1 : 0, '.', ',') }} hrs
    {%- endif -%}
{% endmacro %}

{# "today", "3 days ago", or the date #}
{% macro last_played(date) %}
    {%- if date is null %}never
    {%- else %}
        {%- set days = ((('today'|date('U')) - (date|date('Y-m-d')|date('U'))) / 86400)|round -%}
        {%- if days <= 0 %}today{% elseif days == 1 %}yesterday{% elseif days < 30 %}{{ days }} days ago{% else %}{{ date|date('j M Y') }}{% endif -%}
    {%- endif -%}
{% endmacro %}

{# Unlocked/total achievements as a small progress bar #}
{% macro achievements(game) %}
    {%- if game.hasAchievements -%}
        <div class="d-flex align-items-center gap-2 small" title="{{ game.achievementsUnlocked }} of {{ game.achievementsTotal }} achievements">
            <i class="fas fa-trophy {{ game.achievementPercentage == 100 ? 'text-warning' : 'text-muted' }}"></i>
            <div class="progress flex-grow-1 steam-progress" role="progressbar" aria-label="Achievements" aria-valuenow="{{ game.achievementPercentage }}" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar {{ game.achievementPercentage == 100 ? 'bg-warning' : '' }}" style="width: {{ game.achievementPercentage }}%"></div>
            </div>
            <span class="text-muted text-nowrap">{{ game.achievementsUnlocked }}/{{ game.achievementsTotal }}</span>
        </div>
    {%- endif -%}
{% endmacro %}
