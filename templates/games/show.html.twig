{% extends 'base.html.twig' %}
{% import 'games/_macros.html.twig' as steam %}

{% block title %}{{ game.name }}{{ review ? ' - review' }} - Games - Verzeilberg.nl{% endblock %}

{% block page_title %}{{ game.name }}{% endblock %}
{% block page_lead %}{{ review ? 'Mijn review: ' ~ review.rating ~ '/5, ' ~ review.ratingLabel|lower ~ '.' : 'Uit mijn Steam-bibliotheek.' }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_games') }}" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Alle games</a>
    <a href="{{ game.storeUrl }}" target="_blank" rel="noopener" class="btn btn-outline-primary"><i class="fab fa-steam me-2"></i>Bekijk in de Steam-winkel</a>
{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-8">
        <article class="card" aria-labelledby="reviewTitle">
            <div class="card-body article-body">
                {% if review %}
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                        <h2 id="reviewTitle" class="h3 mb-0">Mijn review</h2>
                        {{ steam.stars(review, 'fs-4') }}
                        <span class="tag">{{ review.rating }}/5 · {{ review.ratingLabel }}</span>
                    </div>
                    <div class="steam-review-body prose">
                        {% for paragraph in review.body|split("\n\n")|filter(p => p|trim != '') %}
                            <p>{{ paragraph|trim|nl2br }}</p>
                        {% endfor %}
                    </div>
                    <p class="small text-muted mb-0">
                        Geschreven op {{ review.createdAt|nl_date('j F Y') }}{% if review.updatedAt %}, bijgewerkt op {{ review.updatedAt|nl_date('j F Y') }}{% endif %}
                        {% if game.playtimeForever > 0 %} · na {{ steam.playtime(game.playtimeForever) }} speeltijd{% endif %}
                    </p>
                {% else %}
                    <h2 id="reviewTitle" class="visually-hidden">Mijn review</h2>
                    <div class="empty-state">
                        <i class="fas fa-pen"></i>
                        <p>Ik heb nog geen review van deze game geschreven.</p>
                    </div>
                {% endif %}

                {% if game.shortDescription %}
                    <h2 class="h4 mt-4">Over de game</h2>
                    <p class="text-muted mb-0">{{ game.shortDescription }}</p>
                {% endif %}
            </div>
        </article>
    </div>

    <div class="col-lg-4">
        <aside class="card">
            <img src="{{ game.headerImage }}" alt="{{ game.name }}" class="card-img-top steam-game-header">
            <div class="card-body">
                <dl class="article-facts steam-facts mb-0">
                    <div><dt>Speeltijd</dt><dd>{{ game.playtimeForever ? steam.playtime(game.playtimeForever) : 'nog niet gespeeld' }}</dd></div>
                    {% if not hideActivity and game.lastPlayedAt %}<div><dt>Laatst gespeeld</dt><dd>{{ steam.last_played(game.lastPlayedAt) }}</dd></div>{% endif %}
                    {% if game.hasAchievements %}<div><dt>Prestaties</dt><dd>{{ game.achievementsUnlocked }} van {{ game.achievementsTotal }} ({{ game.achievementPercentage }}%)</dd></div>{% endif %}
                    {% if game.releaseDate %}<div><dt>Uitgebracht</dt><dd>{{ game.releaseDate }}</dd></div>{% endif %}
                    {% if game.developers %}<div><dt>Ontwikkelaar</dt><dd>{{ game.developers|join(', ') }}</dd></div>{% endif %}
                    {% if game.publishers %}<div><dt>Uitgever</dt><dd>{{ game.publishers|join(', ') }}</dd></div>{% endif %}
                    {% if game.metacriticScore %}<div><dt>Metacritic</dt><dd>{{ game.metacriticScore }}</dd></div>{% endif %}
                </dl>
                {% if game.hasAchievements %}<div class="mt-3">{{ steam.achievements(game) }}</div>{% endif %}
                {% if game.genres %}
                    <div class="d-flex flex-wrap gap-1 mt-3">{% for genre in game.genres %}<span class="tag">{{ genre }}</span>{% endfor %}</div>
                {% endif %}
            </div>
            {% if game.website %}
                <div class="card-footer">
                    <a href="{{ game.website }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary"><i class="fas fa-globe me-1"></i>Bezoek website</a>
                </div>
            {% endif %}
        </aside>
    </div>
</div>
{% endblock %}
