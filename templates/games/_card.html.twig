{# A game in the library; showRecent adds the playtime of the last two weeks, showActivity: false leaves out when it was played #}
{% set showActivity = showActivity ?? true %}
{% import 'games/_macros.html.twig' as steam %}
<div class="card h-100 text-start steam-game card-link-cover">
    <a href="{{ path('app_game', {appId: game.appId}) }}" class="steam-game-image" tabindex="-1" aria-hidden="true" title="{{ game.name }}{{ game.publishedReview ? ': lees mijn review' }}">
        <img src="{{ game.headerImage }}" alt="{{ game.name }}" loading="lazy" class="card-img-top">
    </a>
    <div class="card-body d-flex flex-column gap-2">
        <h3 class="card-title mb-0 text-truncate" title="{{ game.name }}"><a href="{{ path('app_game', {appId: game.appId}) }}">{{ game.name }}</a></h3>
        {% if game.publishedReview %}
            <div class="d-flex align-items-center gap-2 small">{{ steam.stars(game.publishedReview) }}<span class="text-muted">Mijn review</span></div>
        {% endif %}
        {% if game.genres %}
            <div class="d-flex flex-wrap gap-1">
                {% for genre in game.genres|slice(0, 3) %}<span class="tag">{{ genre }}</span>{% endfor %}
            </div>
        {% endif %}
        <div class="card-meta justify-content-between mt-auto">
            <span title="Totale speeltijd"><i class="fas fa-hourglass-half"></i>{{ steam.playtime(game.playtimeForever) }}</span>
            {% if showActivity %}<span title="Laatst gespeeld"><i class="fas fa-calendar-day"></i>{{ steam.last_played(game.lastPlayedAt) }}</span>{% endif %}
        </div>
        {% if showRecent and showActivity and game.playtimeTwoWeeks > 0 %}
            <div class="small text-success"><i class="fas fa-fire me-1"></i>{{ steam.playtime(game.playtimeTwoWeeks) }} in de afgelopen 2 weken</div>
        {% endif %}
        {{ steam.achievements(game) }}
    </div>
</div>
