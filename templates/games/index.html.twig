{% extends 'base.html.twig' %}
{% import 'games/_macros.html.twig' as steam %}

{% block title %}Games - Verzeilberg.nl{% endblock %}

{% block page_title %}Games{% endblock %}
{% block page_lead %}
    {%- if account and account.currentlyPlaying and not hideActivity -%}
        Speelt nu {{ account.currentlyPlaying }}.
    {%- else -%}
        Mijn Steam-bibliotheek: wat ik speel, hoe lang, en wat ik ervan vind.
    {%- endif -%}
{% endblock %}
{% block page_actions %}
    {% if account %}
        <a href="{{ account.profileUrl }}" target="_blank" rel="noopener" class="btn btn-outline-primary steam-profile">
            {% if account.avatarUrl %}<img src="{{ account.avatarUrl }}" alt="" class="rounded me-2" width="24" height="24">{% else %}<i class="fab fa-steam me-2"></i>{% endif %}Bekijk {{ account.personaName ?? 'Steam-profiel' }} op Steam
        </a>
    {% endif %}
{% endblock %}

{% block body %}
{% if stats.games == 0 %}
    <div class="empty-state">
        <i class="fab fa-steam"></i>
        <p>De gamebibliotheek is nog niet geladen. Kijk later nog eens.</p>
    </div>
{% else %}
    <div class="row g-3 section">
        {% for label, value in {
            'Games': stats.games,
            'Gespeeld': stats.played,
            'Uren gespeeld': (stats.minutes / 60)|round|number_format(0, ',', '.'),
            'Prestaties': stats.achievements|number_format(0, ',', '.'),
        } %}
            <div class="col-6 col-md-3">
                <div class="stat-tile">
                    <div class="stat-tile-value">{{ value }}</div>
                    <div class="stat-tile-label">{{ label }}</div>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if recent %}
        <section class="section">
            <h2 class="section-title">Recent gespeeld</h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                {% for game in recent %}
                    <div class="col">
                        {{ include('games/_card.html.twig', {game: game, showRecent: true}) }}
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="section" id="library">
        <h2 class="section-title">Bibliotheek</h2>
        <div class="filter-panel mb-4">
            <form method="get" action="{{ path('app_games') }}#library" class="row g-2 align-items-end" role="search">
                <div class="col-md-4">
                    <label for="gameSearch" class="form-label">Zoeken</label>
                    <input type="search" id="gameSearch" name="q" value="{{ filters.q }}" class="form-control" placeholder="Naam van de game">
                </div>
                <div class="col-6 col-md-3">
                    <label for="gameGenre" class="form-label">Genre</label>
                    <select id="gameGenre" name="genre" class="form-select" data-auto-submit>
                        <option value="">Alle genres</option>
                        {% for genre in genres %}<option value="{{ genre }}" {{ genre == filters.genre ? 'selected' }}>{{ genre }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label for="gameSort" class="form-label">Sorteren op</label>
                    <select id="gameSort" name="order" class="form-select" data-auto-submit>
                        {% for sort in sorts %}<option value="{{ sort }}" {{ sort == filters.sort ? 'selected' }}>{{ {recent: 'Laatst gespeeld', playtime: 'Speeltijd', name: 'Naam', achievements: 'Prestaties', rating: 'Mijn beoordeling'}[sort] }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label for="gameShow" class="form-label">Toon</label>
                    <select id="gameShow" name="show" class="form-select" data-auto-submit>
                        <option value="">Gespeelde games</option>
                        <option value="all" {{ not filters.played and not filters.reviewed ? 'selected' }}>Alle games</option>
                        <option value="reviewed" {{ filters.reviewed ? 'selected' }}>Games met review</option>
                    </select>
                </div>
                <div class="col-6 col-md-1">
                    <button type="submit" class="btn btn-primary w-100" title="Zoeken"><i class="fas fa-search"></i></button>
                </div>
            </form>
        </div>

        {% if games.getTotalItemCount == 0 %}
            <div class="empty-state">
                <i class="fas fa-gamepad"></i>
                <p>Geen games gevonden met deze filters. Probeer een andere naam of genre, of <a href="{{ path('app_games') }}#library">toon de hele bibliotheek</a>.</p>
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
                {% for game in games %}
                    <div class="col">
                        {{ include('games/_card.html.twig', {game: game, showRecent: false, showActivity: not hideActivity}) }}
                    </div>
                {% endfor %}
            </div>
            <nav aria-label="Bibliotheekpagina's">
                {{ knp_pagination_render(games, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
            </nav>
        {% endif %}

        {% if account and account.lastSyncedAt %}
            <p class="text-muted small text-center mt-4 mb-0">Bijgewerkt {{ account.lastSyncedAt|date('d-m-Y H:i') }}</p>
        {% endif %}
    </section>
{% endif %}
{% endblock %}
