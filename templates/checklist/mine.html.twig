{% extends 'base.html.twig' %}

{% block title %}Mijn inzendingen - {{ checkList.name }} - Verzeilberg.nl{% endblock %}

{% block page_title %}Mijn inzendingen{% endblock %}
{% block page_lead %}Je antwoorden voor {{ checkList.name }}.{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_checklists') }}" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Alle checklists</a>
    <a href="{{ path('app_checklist_fill', {id: checkList.id}) }}" class="btn btn-primary"><i class="fas fa-pen me-2"></i>Invullen</a>
{% endblock %}

{% block body %}
{% if items is empty %}
    <div class="empty-state">
        <i class="fas fa-list" aria-hidden="true"></i>
        <p>Je hebt deze checklist nog niet ingevuld. <a href="{{ path('app_checklist_fill', {id: checkList.id}) }}">Vul hem nu in</a>.</p>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Inzending</th>
                        <th>Ingestuurd</th>
                        <th>Gewijzigd</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr class="js-row-link" data-href="{{ path('app_checklist_item', {id: item.id}) }}">
                            <td><a href="{{ path('app_checklist_item', {id: item.id}) }}">Inzending #{{ item.id }}</a></td>
                            <td>{{ item.dateCreated|date('d-m-Y H:i') }}</td>
                            <td>{{ item.dateChanged ? item.dateChanged|date('d-m-Y H:i') : '-' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}
