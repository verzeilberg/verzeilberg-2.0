{% extends 'base.html.twig' %}

{% block title %}Inzending #{{ item.id }} - {{ checkList.name }} - Verzeilberg.nl{% endblock %}

{% block page_title %}Inzending #{{ item.id }}{% endblock %}
{% block page_lead %}
    {{ checkList.name }}: ingestuurd op {{ item.dateCreated|date('d-m-Y H:i') }}{% if item.dateChanged %}, gewijzigd op {{ item.dateChanged|date('d-m-Y H:i') }}{% endif %}
{% endblock %}
{% block page_actions %}
    <div class="d-flex flex-wrap gap-2 d-print-none">
        <a href="{{ path('app_checklist_mine', {id: checkList.id}) }}" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left me-2"></i>Mijn inzendingen
        </a>
        <button type="button" class="btn btn-outline-primary" data-print>
            <i class="fas fa-print me-2"></i>Afdrukken
        </button>
        <a href="{{ path('app_checklist_item_edit', {id: item.id}) }}" class="btn btn-primary">
            <i class="fas fa-edit me-2"></i>Antwoorden bewerken
        </a>
    </div>
{% endblock %}

{% block body %}
<div class="card">
    <div class="card-body article-body pb-0">
        <div class="row">
            {% for field in fields|filter(field => field.parent is null) %}
                {% include 'admin/checklist/_answer_field.html.twig' %}
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
