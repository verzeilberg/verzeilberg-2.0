{% extends 'base.html.twig' %}

{% block title %}Submission #{{ item.id }} - {{ checkList.name }} - Verzeilberg.nl{% endblock %}

{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">Submission #{{ item.id }} <small class="text-muted fs-5">{{ checkList.name }}</small></h1>
    <div class="d-flex gap-2 d-print-none">
        <a href="{{ path('app_checklist_item_edit', {id: item.id}) }}" class="btn btn-primary">
            <i class="fas fa-edit me-1"></i>Edit
        </a>
        <button type="button" class="btn btn-outline-primary" data-print>
            <i class="fas fa-print me-1"></i>Print
        </button>
        <a href="{{ path('app_checklist_mine', {id: checkList.id}) }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>My submissions
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <small class="text-muted">
            Submitted {{ item.dateCreated|date('d-m-Y H:i') }}
            {% if item.dateChanged %}&middot; changed {{ item.dateChanged|date('d-m-Y H:i') }}{% endif %}
        </small>
    </div>
    <div class="card-body pb-0">
        <div class="row">
            {% for field in fields|filter(field => field.parent is null) %}
                {% include 'admin/checklist/_answer_field.html.twig' %}
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
