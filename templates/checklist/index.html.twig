{% extends 'base.html.twig' %}

{% block title %}Checklists - Verzeilberg.nl{% endblock %}

{% block page_title %}Checklists{% endblock %}
{% block page_lead %}Kies een checklist om in te vullen.{% endblock %}

{% block body %}
{% if checkLists is empty %}
    <div class="empty-state">
        <i class="fas fa-clipboard-list" aria-hidden="true"></i>
        <p>
            Er zijn nu geen checklists om in te vullen.
            {% if not app.user %}<a href="{{ path('app_login') }}">Log in</a> om de checklists voor leden te zien.{% endif %}
        </p>
    </div>
{% else %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        {% for checkList in checkLists %}
            <div class="col">
                <article class="card h-100 card-link-cover">
                    <div class="card-body">
                        <h3 class="card-title"><a href="{{ path('app_checklist_fill', {id: checkList.id}) }}">{{ checkList.name }}</a></h3>
                        <div class="card-meta">
                            {% if checkList.owner %}
                                <span><i class="fas fa-user-edit"></i>door {{ checkList.owner.fullName }}</span>
                            {% endif %}
                            {% if checkList.access == 'user' %}
                                <span><i class="fas fa-user"></i>Voor leden</span>
                            {% elseif checkList.access == 'friends' %}
                                <span><i class="fas fa-user-friends"></i>{{ checkList.isOwnedBy(app.user) ? 'Voor je vrienden' : 'Gedeeld met vrienden' }}</span>
                            {% else %}
                                <span><i class="fas fa-globe"></i>Open voor iedereen</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <a href="{{ path('app_checklist_fill', {id: checkList.id}) }}" class="btn btn-sm btn-primary">
                            <i class="fas fa-pen me-1"></i>Invullen
                        </a>
                        {% if app.user %}
                            <a href="{{ path('app_checklist_mine', {id: checkList.id}) }}" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-list me-1"></i>Mijn inzendingen
                            </a>
                        {% endif %}
                    </div>
                </article>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
