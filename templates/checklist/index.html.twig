{% extends 'base.html.twig' %}

{% block title %}Checklists - Verzeilberg.nl{% endblock %}

{% block body %}
<h1 class="mb-4"><i class="fas fa-clipboard-list me-2"></i>Checklists</h1>

{% if checkLists is empty %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>There are no checklists to fill in right now.
        {% if not app.user %}<a href="{{ path('app_login') }}">Log in</a> to see the checklists for members.{% endif %}
    </div>
{% else %}
    <div class="list-group">
        {% for checkList in checkLists %}
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                <div>
                    <h5 class="mb-1">{{ checkList.name }}</h5>
                    {% if checkList.access == 'user' %}
                        <small class="text-muted"><i class="fas fa-user me-1"></i>For members</small>
                    {% endif %}
                </div>
                <div class="d-flex gap-2">
                    {% if app.user %}
                        <a href="{{ path('app_checklist_mine', {id: checkList.id}) }}" class="btn btn-outline-secondary">
                            <i class="fas fa-list me-1"></i>My submissions
                        </a>
                    {% endif %}
                    <a href="{{ path('app_checklist_fill', {id: checkList.id}) }}" class="btn btn-primary">
                        <i class="fas fa-pen me-1"></i>Fill in
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
