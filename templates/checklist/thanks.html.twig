{% extends 'base.html.twig' %}

{% block title %}Thank you - {{ checkList.name }} - Verzeilberg.nl{% endblock %}

{% block body %}
<div class="card text-center mx-auto checklist-thanks">
    <div class="card-body py-5">
        <i class="fas fa-check-circle fa-3x text-success mb-3" aria-hidden="true"></i>
        <h1 class="h3">Thank you!</h1>
        <p class="text-muted mb-4">Your answers for "{{ checkList.name }}" have been saved.</p>
        <div class="d-flex justify-content-center gap-2">
            <a href="{{ path('app_checklist_fill', {id: checkList.id}) }}" class="btn btn-outline-primary">
                <i class="fas fa-pen me-1"></i>Fill in again
            </a>
            <a href="{{ path('app_checklists') }}" class="btn btn-outline-secondary">Back to Checklists</a>
        </div>
    </div>
</div>
{% endblock %}
