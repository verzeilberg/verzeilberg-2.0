{% extends 'base.html.twig' %}

{% block title %}Bedankt - {{ checkList.name }} - Verzeilberg.nl{% endblock %}

{% block page_title %}Bedankt{% endblock %}

{% block body %}
<div class="form-page">
    <div class="card text-center">
        <div class="card-body article-body">
            <i class="fas fa-check-circle fa-3x text-primary mb-3" aria-hidden="true"></i>
            <h2 class="h3">Je antwoorden zijn opgeslagen</h2>
            <p class="text-muted mb-4">We hebben je antwoorden voor "{{ checkList.name }}" ontvangen. Je kunt de checklist nog een keer invullen of een andere kiezen.</p>
            <div class="d-grid">
                <a href="{{ path('app_checklists') }}" class="btn btn-primary">Alle checklists</a>
            </div>
        </div>
    </div>
    <p class="text-center mt-3">
        <a href="{{ path('app_checklist_fill', {id: checkList.id}) }}">Nog een keer invullen</a>
    </p>
</div>
{% endblock %}
