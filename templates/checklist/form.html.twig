{% extends 'base.html.twig' %}

{% block title %}{{ checkList.name }} - Verzeilberg.nl{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'admin/checklist/_item_form_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">
        <i class="fas fa-{{ action == 'new' ? 'pen' : 'edit' }} me-2"></i>{{ checkList.name }}
    </h1>
    {% if action == 'edit' %}
        <a href="{{ path('app_checklist_item', {id: item.id}) }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    {% else %}
        <a href="{{ path('app_checklists') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Checklists
        </a>
    {% endif %}
</div>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

        {% if rateLimited|default(false) %}
            <div class="alert alert-warning" role="alert">
                <i class="fas fa-hourglass-half me-1"></i>You have submitted this form too often. Please try again in a few minutes.
            </div>
        {% elseif form.vars.submitted and not form.vars.valid %}
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-triangle me-1"></i>Your answers have not been saved yet. Please check the marked fields.
                {% for error in form.vars.errors %}
                    <div>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}

        {# Same fields, conditions and info icons as the admin item form #}
        <div class="row">
            {% for field in fields|filter(field => field.parent is null) %}
                {% include 'admin/checklist/_item_field.html.twig' %}
            {% endfor %}
        </div>

        {# Spam trap: hidden for people (and screen readers), bots fill it in #}
        {% if form.website is defined %}
            <div class="visually-offscreen" aria-hidden="true">
                {{ form_row(form.website) }}
            </div>
        {% endif %}

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-paper-plane me-1"></i>{{ action == 'new' ? 'Submit' : 'Save' }}
            </button>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'admin/checklist/_item_form_scripts.html.twig' %}
{% endblock %}
