{% extends 'base.html.twig' %}

{% block title %}{{ checkList.name }} - Verzeilberg.nl{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'admin/checklist/_item_form_styles.html.twig' %}
{% endblock %}

{% block page_title %}{{ checkList.name }}{% endblock %}
{% block page_lead %}{{ action == 'new' ? 'Vul het formulier hieronder in en verstuur je antwoorden.' : 'Pas je antwoorden aan en sla ze op.' }}{% endblock %}
{% block page_actions %}
    {% if action == 'edit' %}
        <a href="{{ path('app_checklist_item', {id: item.id}) }}" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left me-2"></i>Terug naar inzending
        </a>
    {% else %}
        <a href="{{ path('app_checklists') }}" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left me-2"></i>Alle checklists
        </a>
    {% endif %}
{% endblock %}

{% block body %}
<div class="form-page-wide">
    <div class="card">
        <div class="card-body article-body">
            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    
            {% if rateLimited|default(false) %}
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-hourglass-half me-1"></i>Je hebt dit formulier te vaak verstuurd. Probeer het over een paar minuten opnieuw.
                </div>
            {% elseif form.vars.submitted and not form.vars.valid %}
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-triangle me-1"></i>Je antwoorden zijn nog niet opgeslagen. Controleer de gemarkeerde velden.
                    {% for error in form.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
    
            {# Same fields, conditions and info icons as the admin item form #}
            <div class="row">
                {% for field in fields|filter(field => field.parent is null) %}
                    {% include 'admin/checklist/_item_field.html.twig' %}
                {% endfor %}
            </div>
    
            {# Spam trap: hidden for people (and screen readers), bots fill it in #}
            {% if form.website is defined %}
                <div class="visually-offscreen" aria-hidden="true">
                    {{ form_row(form.website) }}
                </div>
            {% endif %}
    
            <div class="d-grid">
                <button type="submit" class="btn btn-primary">{{ action == 'new' ? 'Antwoorden versturen' : 'Wijzigingen opslaan' }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'admin/checklist/_item_form_scripts.html.twig' %}
{% endblock %}
