{#
 # KnpPaginator template: "Showing 1–20 of 58 posts" plus Bootstrap page links. Filters in the URL are kept.
 #   {{ knp_pagination_render(pagination, '_partials/pagination.html.twig', {}, {label: 'posts'}) }}
 #}
{% set label = label ?? 'resultaten' %}

{% if totalCount > 0 %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="text-muted small">
            <strong>{{ firstItemNumber }}–{{ lastItemNumber }}</strong> van <strong>{{ totalCount }}</strong> {{ label }}
        </span>

        {% if pageCount > 1 %}
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item{{ previous is defined ? '' : ' disabled' }}">
                    {% if previous is defined %}
                        <a class="page-link" href="{{ path(route, knp_pagination_query(query, previous, options)) }}" rel="prev" aria-label="Vorige pagina"><i class="fas fa-chevron-left"></i></a>
                    {% else %}
                        <span class="page-link" aria-hidden="true"><i class="fas fa-chevron-left"></i></span>
                    {% endif %}
                </li>

                {% if first not in pagesInRange %}
                    <li class="page-item"><a class="page-link" href="{{ path(route, knp_pagination_query(query, first, options)) }}">{{ first }}</a></li>
                    {% if pagesInRange|first > first + 1 %}
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    {% endif %}
                {% endif %}

                {% for page in pagesInRange %}
                    {% if page == current %}
                        <li class="page-item active" aria-current="page"><span class="page-link">{{ page }}</span></li>
                    {% else %}
                        <li class="page-item"><a class="page-link" href="{{ path(route, knp_pagination_query(query, page, options)) }}">{{ page }}</a></li>
                    {% endif %}
                {% endfor %}

                {% if last not in pagesInRange %}
                    {% if pagesInRange|last < last - 1 %}
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    {% endif %}
                    <li class="page-item"><a class="page-link" href="{{ path(route, knp_pagination_query(query, last, options)) }}">{{ last }}</a></li>
                {% endif %}

                <li class="page-item{{ next is defined ? '' : ' disabled' }}">
                    {% if next is defined %}
                        <a class="page-link" href="{{ path(route, knp_pagination_query(query, next, options)) }}" rel="next" aria-label="Volgende pagina"><i class="fas fa-chevron-right"></i></a>
                    {% else %}
                        <span class="page-link" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
                    {% endif %}
                </li>
            </ul>
        {% endif %}
    </div>
{% endif %}
