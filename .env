# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# THIS FILE IS IN GIT: it only lists the settings, without real values.
# Put the real values in .env.local (development) or the server's environment / .env.prod.local.
# Run bin/check-env.sh to see what is missing and how to get it.
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Random secret, e.g.: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# The site's public URL, for links built outside a web request (cronjobs, commands).
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# SMTP of your mail provider, e.g. smtp://USER:PASSWORD@smtp.example.com:587
# (development only: gmail://you@gmail.com:APP_PASSWORD@default). null://null sends nothing.
MAILER_DSN=null://null
###< symfony/mailer ###

###> Google Maps ###
# Maps and place search for agenda items and events. Key from https://console.cloud.google.com/apis/credentials
# with Maps JavaScript API, Places API (New) and Maps Embed API enabled. Empty = no maps.
GOOGLE_MAPS_API_KEY=
###< Google Maps ###

###> Strava API ###
# Application at https://www.strava.com/settings/api. Empty = Strava switched off.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# https://YOUR-DOMAIN/strava/callback
STRAVA_REDIRECT_URI=
# The number in your profile URL https://www.strava.com/athletes/12345678
STRAVA_ATHLETE_ID=
# Google Maps key for the Strava pages (can be the same as GOOGLE_MAPS_API_KEY)
STRAVA_GOOGLE_MAPS_KEY=
###< Strava API ###

###> Google Calendar (agenda) ###
# OAuth client of a Google Cloud project with the Google Calendar API enabled.
# Redirect URI: https://YOUR-DOMAIN/admin/agenda/google/callback. Empty = the Google connection is switched off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
###< Google Calendar (agenda) ###

###> Steam (game library) ###
# Web API key from https://steamcommunity.com/dev/apikey, and the profile whose games are shown:
# the 17-digit Steam ID, the name from the profile URL, or the profile URL itself. Empty = the Steam sync is switched off.
STEAM_API_KEY=
STEAM_ID=
###< Steam (game library) ###

###> Handbal ###
# Password of the public handbal standings page (/handbal). Empty = the page can't be opened.
HANDBAL_PUBLIC_PASSWORD=
###< Handbal ###
