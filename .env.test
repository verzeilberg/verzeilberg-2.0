# Test environment configuration (in git: dummy values only)
APP_ENV=test
APP_SECRET=test-secret-key-for-testing

# The test database login goes in .env.test.local (not in git), e.g.:
# DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/verzeilberg?serverVersion=8.0.32&charset=utf8mb4"

# Disable mailer in tests
MAILER_DSN=null://null

# Dummy key, so the Google Maps parts of the agenda are rendered in tests
GOOGLE_MAPS_API_KEY=test-maps-key

# Steam: tests use a simulated Steam API
STEAM_API_KEY=test-steam-key
STEAM_ID=76561197960287930

# Strava: dummy values (tests never call Strava)
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=test-strava-secret
STRAVA_REDIRECT_URI=http://localhost/strava/callback
STRAVA_ATHLETE_ID=12345678
STRAVA_GOOGLE_MAPS_KEY=test-maps-key

HANDBAL_PUBLIC_PASSWORD=test-handbal
